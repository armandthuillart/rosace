{
  "name": "dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production node ../../env.ts && vp build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deploy": "wrangler deploy --keep-vars",
    "dev": "NODE_ENV=development node ../../env.ts && vp dev",
    "preview": "vp preview"
  },
  "dependencies": {
    "@fontsource/inter": "catalog:",
    "@repo/better-auth": "workspace:*",
    "@repo/convex": "workspace:*",
    "@repo/crpc": "workspace:*",
    "better-auth": "catalog:",
    "convex": "catalog:",
    "dexie": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
