---
import BaseHead from "@components/base-head.astro";
import "@styles/global.css";
import Footer from "@components/footer.astro";
import Header from "@components/header.astro";
---

<html lang="en" class="antialiased scheme-light-dark">
	<head>
		<BaseHead />
	</head>
	<body class="bg-gray-50 text-gray-800 dark:bg-gray-1000 dark:text-gray-200">
		<Header />
		<main class="pt-28 pb-32 flex flex-col gap-24 overflow-clip isolate">
			<slot />
		</main>
		<Footer />
	</body>
</html>
