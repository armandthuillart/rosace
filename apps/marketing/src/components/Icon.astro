---
import type { HTMLAttributes } from "astro/types";

const spriteNames = [
  "rosace",
  "faqs",
  "arrow-left",
  "arrow-right",
  "x",
  "discord",
  "tiktok",
  "cursor",
  "gift-card",
  "plus-sign",
  "minus-sign",
  "play",
  "smile",
  "shocked",
  "zap",
  "rectangle",
  "checkerboard",
  "two-columns",
  "pause",
  "more-horizontal",
  "rabbit",
  "turtle",
] as const;

type IconName = (typeof spriteNames)[number];

interface Props extends HTMLAttributes<"svg"> {
  name: IconName;
}

const { name, ...props } = Astro.props;
---

<svg
  aria-hidden="true"
  fill="currentColor"
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  {...props}
>
  <use href={`/sprites.svg#${name}`}></use>
</svg>
