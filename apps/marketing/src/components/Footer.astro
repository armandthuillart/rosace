---
import Icon from "@components/Icon.astro";
import Anchor from "@components/Anchor.astro";
---

<footer class="relative flex flex-col items-center px-8 max-sm:pb-20">
  <div class="relative flex gap-3">
    <Anchor
      aria-label="X"
      class="group rounded-xl bg-gray-200 p-2 text-gray-500 transition duration-300 hover:text-gray-700 focus-visible:outline-2 dark:bg-gray-800 dark:text-gray-400 dark:hover:text-gray-200"
      href="https://x.com/armandthuillart"
    >
      <Icon
        aria-hidden="true"
        class="size-6 transition duration-300 ease-out group-hover:scale-105"
        fill="currentColor"
        name="x"
      />
    </Anchor>

    <Anchor
      aria-label="TikTok"
      class="group rounded-xl bg-gray-200 p-2 text-gray-500 transition duration-300 hover:text-gray-700 focus-visible:outline-2 dark:bg-gray-800 dark:text-gray-400 dark:hover:text-gray-200"
      href="https://tiktok.com"
    >
      <Icon
        aria-hidden="true"
        class="size-6 transition duration-300 ease-out group-hover:scale-105"
        fill="currentColor"
        name="tiktok"
      />
    </Anchor>

    <Anchor
      aria-label="Discord"
      class="group rounded-xl bg-gray-200 p-2 text-gray-500 transition duration-300 hover:text-gray-700 focus-visible:outline-2 dark:bg-gray-800 dark:text-gray-400 dark:hover:text-gray-200"
      href="https://discord.com/invite/rosace"
    >
      <Icon
        aria-hidden="true"
        class="size-6 transition duration-300 ease-out group-hover:scale-105"
        fill="currentColor"
        name="discord"
      />
    </Anchor>
  </div>

  <div
    class="relative -mt-6 w-full origin-bottom overflow-hidden text-center text-[14rem] leading-none font-black select-none before:absolute before:inset-0 before:block before:bg-linear-to-b before:from-gray-100 before:from-25% before:to-transparent before:bg-clip-text before:text-transparent before:content-[attr(data-wordmark)] max-sm:hidden sm:h-36 md:h-48 md:text-[18rem] lg:h-56 lg:text-[20rem] dark:before:from-gray-900"
    data-wordmark="Rosace"
  >
  </div>
</footer>
