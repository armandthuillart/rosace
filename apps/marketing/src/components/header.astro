---
import { DASHBOARD_URL } from "astro:env/client";
---

<header
  class="dark:bg-gray-1000 dark:sm:bg-gray-1000/80 fixed top-0 z-50 w-full bg-white px-8 py-5 shadow-gray-100 transition-shadow duration-300 sm:bg-white/80 sm:py-7 sm:backdrop-blur-xl"
>
  <nav class="mx-auto flex w-full max-w-432 justify-between">
    <div class="flex gap-2 delay-75">
      <a
        aria-label="Go to homepage"
        class="group flex items-start gap-2 self-center focus-visible:outline-2"
        href="/"
      >
        <div class="relative size-10 overflow-hidden">
          <div class="absolute top-1/2 left-1/2 size-9 -translate-1/2">
            <svg
              class="transition delay-50 duration-300 ease-out will-change-transform group-hover:-translate-x-full group-hover:scale-x-50 group-hover:scale-y-75 group-hover:opacity-25 group-hover:delay-0"
              fill="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <use href="/sprites.svg#logotype"></use>
            </svg>
          </div>

          <div class="absolute top-1/2 left-1/2 size-9 -translate-1/2">
            <svg
              class="ease origin-right translate-x-0.5 scale-50 opacity-0 blur-xs transition duration-300 will-change-transform group-hover:translate-x-0 group-hover:scale-100 group-hover:opacity-100 group-hover:blur-none group-hover:delay-50"
              fill="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <use href="/sprites.svg#arrow-left"></use>
            </svg>
          </div>
        </div>

        <span class="text-2xl/10 font-bold">Rosace</span>
      </a>

      <div
        class="mt-2.5 self-start rounded-lg border-[1.5px] border-gray-200 bg-gray-100 px-1 py-px text-xs font-bold tracking-tight text-gray-500 uppercase dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400"
      >
        Beta
      </div>
    </div>

    <div class="flex gap-5">
      <a
        aria-label="Frequently asked questions"
        class="group relative inline-flex items-center justify-center gap-2 rounded-2xl px-5 py-4 text-center text-lg font-bold transition duration-300 before:absolute hover:bg-gray-100 focus-visible:outline-2 max-sm:bg-gray-100 dark:hover:bg-gray-800 dark:max-sm:bg-gray-800"
        href="/faqs"
      >
        <svg
          fill="currentColor"
          class="size-6 origin-bottom transition duration-300 will-change-transform group-hover:-rotate-12"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M11.9063 23.1261C12.3583 23.1261 12.7802 22.9352 13.1819 22.2422L15.0402 19.1384H18.3951C21.3884 19.1384 22.9955 17.481 22.9955 14.5379V6.84373C22.9955 3.90065 21.3884 2.24329 18.3951 2.24329H5.45763C2.46432 2.24329 0.857178 3.8906 0.857178 6.84373V14.5379C0.857178 17.491 2.46432 19.1384 5.45763 19.1384H8.77238L10.6306 22.2422C11.0324 22.9352 11.4543 23.1261 11.9063 23.1261Z"
          ></path>

          <path
            class="dark:fill-gray-1000 origin-top-left fill-white transition duration-250 group-hover:-rotate-3 group-hover:delay-50"
            d="M13.7146 11.0001C14.2668 11.0003 14.7146 11.4479 14.7146 12.0001C14.7145 12.5522 14.2667 13 13.7146 13.0001H6.85718C6.30494 13.0001 5.85725 12.5523 5.85718 12.0001C5.85718 11.4478 6.30489 11.0001 6.85718 11.0001H13.7146ZM17.3572 7.57141C17.9095 7.57141 18.3572 8.01913 18.3572 8.57141C18.3572 9.1237 17.9095 9.57141 17.3572 9.57141H6.85718C6.30489 9.57141 5.85718 9.1237 5.85718 8.57141C5.85718 8.01913 6.30489 7.57141 6.85718 7.57141H17.3572Z"
          ></path>
        </svg>

        <span class="max-sm:hidden">FAQs</span>
      </a>

      <a
        aria-label="Sign up for free"
        class="group relative inline-flex min-h-15 items-center justify-center gap-2 rounded-2xl bg-gray-200 py-4 pr-5 pl-13 text-center text-lg font-bold transition duration-300 before:absolute focus-visible:outline-2 max-sm:hidden dark:bg-gray-800"
        href={DASHBOARD_URL}
      >
        <svg
          class="ease absolute left-5 size-6 translate-x-0 opacity-100 transition duration-300 will-change-transform group-hover:-translate-x-full group-hover:scale-x-50 group-hover:opacity-0 group-hover:blur-sm"
          fill="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <use href="/sprites.svg#arrow-right"></use>
        </svg>

        <span
          class="ease translate-x-0 transition duration-300 group-hover:-translate-x-8"
          >Go to app</span
        >

        <svg
          class="ease absolute right-5 size-6 translate-x-full scale-x-50 opacity-0 blur-sm transition duration-300 will-change-transform group-hover:translate-x-0 group-hover:scale-x-100 group-hover:opacity-100 group-hover:blur-none"
          fill="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <use href="/sprites.svg#arrow-right"></use>
        </svg>
      </a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector("header");

  const toggleShadow = () => {
    header!.classList.toggle("not-dark:shadow-2xl", window.scrollY > 0);
  };

  toggleShadow();
  window.addEventListener("scroll", toggleShadow, { passive: true });
</script>
