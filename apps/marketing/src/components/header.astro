---
import { DASHBOARD_URL } from "astro:env/client";
---

<header class="dark:bg-gray-1000 fixed top-0 z-50 w-full bg-gray-50 px-5">
  <nav class="mx-auto flex h-13 w-full max-w-7xl items-center justify-between">
    <a
      href="/"
      class="relative inline-flex h-7 items-center before:absolute before:-inset-1 hover:opacity-80 focus-visible:outline-2"
    >
      <span class="sr-only">Go to homepage</span>

      <svg
        aria-hidden="true"
        class="h-6 w-24"
        fill="currentColor"
        viewBox="0 0 96 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <use href="/sprite.svg#logotype"></use>
      </svg>
    </a>

    <div class="flex gap-2">
      <a
        class="relative inline-flex h-7 items-center justify-center rounded-full px-[calc(--spacing(2.5)-1px)] text-center text-sm font-medium before:absolute before:-inset-1 hover:opacity-80 focus-visible:outline-2"
        href={DASHBOARD_URL}>Sign in</a
      >

      <a
        class="relative inline-flex h-7 items-center justify-center rounded-full bg-gray-800 px-[calc(--spacing(2.5)-1px)] text-center text-sm font-medium text-gray-200 before:absolute before:-inset-1 hover:bg-gray-600 focus-visible:outline-2 dark:bg-gray-200 dark:text-gray-800 dark:hover:bg-gray-300"
        href={DASHBOARD_URL}
      >
        Sign up for free
      </a>
    </div>
  </nav>
</header>
