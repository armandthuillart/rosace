---
import Icon from "@components/Icon.astro";
import Link from "@components/Link.astro";
---

<footer class="relative flex flex-col items-center px-8 max-sm:pb-20">
  <div class="relative flex gap-3">
    <Link
      aria-label="X"
      class="group rounded-xl bg-gray-200 p-2 text-gray-500 transition duration-300 hover:text-gray-700 focus-visible:outline-2 dark:bg-gray-800 dark:text-gray-400 dark:hover:text-gray-200"
      href="https://x.com/armandthuillart"
    >
      <Icon
        aria-hidden="true"
        class="size-6 transition duration-300 ease-out group-hover:scale-105"
        fill="currentColor"
        name="x"
      />
    </Link>

    <Link
      aria-label="TikTok"
      class="group rounded-xl bg-gray-200 p-2 text-gray-500 transition duration-300 hover:text-gray-700 focus-visible:outline-2 dark:bg-gray-800 dark:text-gray-400 dark:hover:text-gray-200"
      href="https://tiktok.com"
    >
      <Icon
        aria-hidden="true"
        class="size-6 transition duration-300 ease-out group-hover:scale-105"
        fill="currentColor"
        name="tiktok"
      />
    </Link>

    <Link
      aria-label="Discord"
      class="group rounded-xl bg-gray-200 p-2 text-gray-500 transition duration-300 hover:text-gray-700 focus-visible:outline-2 dark:bg-gray-800 dark:text-gray-400 dark:hover:text-gray-200"
      href="https://discord.com/invite/rosace"
    >
      <Icon
        aria-hidden="true"
        class="size-6 transition duration-300 ease-out group-hover:scale-105"
        fill="currentColor"
        name="discord"
      />
    </Link>
  </div>

  <div
    class="-mt-6 origin-bottom overflow-hidden bg-linear-to-b from-gray-100 from-25% to-transparent bg-clip-text text-[14rem] leading-none font-black text-transparent select-none max-sm:hidden sm:h-36 md:h-48 md:text-[18rem] lg:h-56 lg:text-[20rem] dark:from-gray-900"
  >
    Rosace
  </div>
</footer>
