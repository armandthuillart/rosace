---
const currentYear = new Date().getFullYear();
---

<footer class="px-5 bg-gray-100 dark:bg-gray-950">
	<div class="max-w-7xl mx-auto pt-16 pb-8 flex flex-col gap-24">
		<nav class="grid grid-cols-2 gap-x-2.5 gap-y-10 sm:grid-cols-4">
			<div class="flex flex-col gap-1">
				<h3
					class="text-gray-500 dark:text-gray-400 tracking-[.005em] sm:text-sm/normal sm:tracking-[.01em]"
				>
					Resources
				</h3>

				<ul class="flex flex-col gap-1.5">
					<li class="flex">
						<a
							class="w-full relative tracking-[.005em] sm:text-sm/normal sm:tracking-[.01em] before:absolute before:-inset-1 focus-visible:outline-2 hover:text-gray-600 dark:hover:text-gray-300"
							href="/changelog"
							>Changelog</a
						>
					</li>
				</ul>
			</div>

			<div class="flex flex-col gap-1">
				<h3
					class="text-gray-500 dark:text-gray-400 tracking-[.005em] sm:text-sm/normal sm:tracking-[.01em]"
				>
					Company
				</h3>

				<ul class="flex flex-col gap-1.5">
					<li class="flex">
						<a
							class="w-full relative tracking-[.005em] sm:text-sm/normal sm:tracking-[.01em] before:absolute before:-inset-1 focus-visible:outline-2 hover:text-gray-600 dark:hover:text-gray-300"
							href="/blog"
							>Blog</a
						>
					</li>
				</ul>
			</div>

			<div class="flex flex-col gap-1">
				<h3
					class="text-gray-500 dark:text-gray-400 tracking-[.005em] sm:text-sm/normal sm:tracking-[.01em]"
				>
					Policies
				</h3>

				<ul class="flex flex-col gap-1.5">
					<li class="flex">
						<a
							class="w-full relative tracking-[.005em] sm:text-sm/normal sm:tracking-[.01em] before:absolute before:-inset-1 focus-visible:outline-2 hover:text-gray-600 dark:hover:text-gray-300"
							href="/terms-of-service"
							>Terms of Service</a
						>
					</li>
					<li class="flex">
						<a
							class="w-full relative tracking-[.005em] sm:text-sm/normal sm:tracking-[.01em] before:absolute before:-inset-1 focus-visible:outline-2 hover:text-gray-600 dark:hover:text-gray-300"
							href="/privacy-policy"
							>Privacy Policy</a
						>
					</li>
					<li class="flex">
						<a
							class="w-full relative tracking-[.005em] sm:text-sm/normal sm:tracking-[.01em] before:absolute before:-inset-1 focus-visible:outline-2 hover:text-gray-600 dark:hover:text-gray-300"
							href="/legal-notice"
							>Legal Notice</a
						>
					</li>
				</ul>
			</div>

			<div class="flex flex-col gap-1">
				<h3
					class="text-gray-500 dark:text-gray-400 tracking-[.005em] sm:text-sm/normal sm:tracking-[.01em]"
				>
					Connect
				</h3>

				<ul class="flex flex-col gap-1">
					<li class="flex">
						<a
							class="group flex items-center w-full relative tracking-[.005em] sm:text-sm/normal sm:tracking-[.01em] before:absolute before:-inset-1 focus-visible:outline-2 hover:text-gray-600 dark:hover:text-gray-300"
							href="https://x.com/rosaceapp"
							rel="noopener noreferrer"
							target="_blank"
						>
							X
							<span class="sr-only">Go to Rosace’s X account</span>
							<svg
								aria-hidden="true"
								class="size-4 text-gray-500 dark:text-gray-400 not-group-hover:hidden"
								fill="currentColor"
								viewBox="0 0 24 24"
								xmlns="http://www.w3.org/2000/svg"
							>
								<use href="/sprite.svg#arrow-up-right" />
							</svg>
						</a>
					</li>
					<li class="flex">
						<a
							class="group flex items-center w-full relative tracking-[.005em] sm:text-sm/normal sm:tracking-[.01em] before:absolute before:-inset-1 focus-visible:outline-2 hover:text-gray-600 dark:hover:text-gray-300"
							href="https://www.linkedin.com/company/rosaceapp"
							rel="noopener noreferrer"
							target="_blank"
							>LinkedIn
							<span class="sr-only">Go to Rosace’s LinkedIn account</span>
							<svg
								aria-hidden="true"
								class="size-4 text-gray-500 dark:text-gray-400 not-group-hover:hidden"
								fill="currentColor"
								viewBox="0 0 24 24"
								xmlns="http://www.w3.org/2000/svg"
							>
								<use href="/sprite.svg#arrow-up-right" />
							</svg>
						</a>
					</li>
				</ul>
			</div>
		</nav>

		<small
			class="text-gray-500 dark:text-gray-400 text-base tracking-[.005em] sm:text-sm/normal sm:tracking-[.01em]"
		>
			&copy; {currentYear} Rosace.
		</small>
	</div>
</footer>
