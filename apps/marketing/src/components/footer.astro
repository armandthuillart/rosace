---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-100 px-5 dark:bg-gray-950">
  <div class="mx-auto flex max-w-7xl flex-col gap-24 pt-16 pb-8">
    <nav class="grid grid-cols-2 gap-x-2.5 gap-y-10 sm:grid-cols-4">
      <div class="flex flex-col gap-1">
        <h3
          class="tracking-[.005em] text-gray-500 sm:text-sm/normal sm:tracking-[.01em] dark:text-gray-400"
        >
          Resources
        </h3>

        <ul class="flex flex-col gap-1.5">
          <li class="flex">
            <a
              class="relative w-full tracking-[.005em] before:absolute before:-inset-1 hover:text-gray-600 focus-visible:outline-2 sm:text-sm/normal sm:tracking-[.01em] dark:hover:text-gray-300"
              href="/changelog">Changelog</a
            >
          </li>
        </ul>
      </div>

      <div class="flex flex-col gap-1">
        <h3
          class="tracking-[.005em] text-gray-500 sm:text-sm/normal sm:tracking-[.01em] dark:text-gray-400"
        >
          Company
        </h3>

        <ul class="flex flex-col gap-1.5">
          <li class="flex">
            <a
              class="relative w-full tracking-[.005em] before:absolute before:-inset-1 hover:text-gray-600 focus-visible:outline-2 sm:text-sm/normal sm:tracking-[.01em] dark:hover:text-gray-300"
              href="/blog">Blog</a
            >
          </li>
        </ul>
      </div>

      <div class="flex flex-col gap-1">
        <h3
          class="tracking-[.005em] text-gray-500 sm:text-sm/normal sm:tracking-[.01em] dark:text-gray-400"
        >
          Policies
        </h3>

        <ul class="flex flex-col gap-1.5">
          <li class="flex">
            <a
              class="relative w-full tracking-[.005em] before:absolute before:-inset-1 hover:text-gray-600 focus-visible:outline-2 sm:text-sm/normal sm:tracking-[.01em] dark:hover:text-gray-300"
              href="/terms-of-service">Terms of Service</a
            >
          </li>
          <li class="flex">
            <a
              class="relative w-full tracking-[.005em] before:absolute before:-inset-1 hover:text-gray-600 focus-visible:outline-2 sm:text-sm/normal sm:tracking-[.01em] dark:hover:text-gray-300"
              href="/privacy-policy">Privacy Policy</a
            >
          </li>
          <li class="flex">
            <a
              class="relative w-full tracking-[.005em] before:absolute before:-inset-1 hover:text-gray-600 focus-visible:outline-2 sm:text-sm/normal sm:tracking-[.01em] dark:hover:text-gray-300"
              href="/legal-notice">Legal Notice</a
            >
          </li>
        </ul>
      </div>

      <div class="flex flex-col gap-1">
        <h3
          class="tracking-[.005em] text-gray-500 sm:text-sm/normal sm:tracking-[.01em] dark:text-gray-400"
        >
          Connect
        </h3>

        <ul class="flex flex-col gap-1">
          <li class="flex">
            <a
              class="group relative flex w-full items-center tracking-[.005em] before:absolute before:-inset-1 hover:text-gray-600 focus-visible:outline-2 sm:text-sm/normal sm:tracking-[.01em] dark:hover:text-gray-300"
              href="https://x.com/rosaceapp"
              rel="noopener noreferrer"
              target="_blank"
            >
              X
              <span class="sr-only">Go to Rosace’s X account</span>
              <svg
                aria-hidden="true"
                class="size-4 text-gray-500 not-group-hover:hidden dark:text-gray-400"
                fill="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <use href="/sprite.svg#arrow-up-right"></use>
              </svg>
            </a>
          </li>
          <li class="flex">
            <a
              class="group relative flex w-full items-center tracking-[.005em] before:absolute before:-inset-1 hover:text-gray-600 focus-visible:outline-2 sm:text-sm/normal sm:tracking-[.01em] dark:hover:text-gray-300"
              href="https://www.linkedin.com/company/rosaceapp"
              rel="noopener noreferrer"
              target="_blank"
              >LinkedIn
              <span class="sr-only">Go to Rosace’s LinkedIn account</span>
              <svg
                aria-hidden="true"
                class="size-4 text-gray-500 not-group-hover:hidden dark:text-gray-400"
                fill="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <use href="/sprite.svg#arrow-up-right"></use>
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <small
      class="text-base tracking-[.005em] text-gray-500 sm:text-sm/normal sm:tracking-[.01em] dark:text-gray-400"
    >
      &copy; {currentYear} Rosace.
    </small>
  </div>
</footer>
