---
import { Font } from "astro:assets";
import originalImage from "@assets/images/opengraph-image.png";
import { getImage } from "astro:assets";

let title = "Rosace";
let description = "A new type of animation tool.";

const optimizedImage = await getImage({
  format: "png",
  height: 630,
  src: originalImage,
  width: 1200,
});

const ogImageUrl = new URL(optimizedImage.src, Astro.url);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.json" />

<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:url" content={Astro.url} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="Rosace" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@rosaceapp" />
<meta name="twitter:creator" content="@rosaceapp" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<Font cssVariable="--font-inter" preload />
