---
import Scale from "@components/scale.astro";
---

<div class="h-146 relative @container" id="vertical">
  <div
    class="text-center right-0 absolute leading-none -tracking-[.03em] left-0 text-[clamp(5rem,5cqw,10rem)] origin-[bottom_center] bottom-1/2 mb-[clamp(5rem,5cqw,10rem)]"
    id="any"
  >
    Any
  </div>

  <div
    class="absolute top-1/2 left-1/2 aspect-square -translate-1/2 h-[clamp(20rem,75cqw,25rem)]"
  >
    <div
      class="size-full aspect-video border-2 border-blue-400 dark:border-blue-500 top-1/2 -translate-1/2 absolute left-1/2 bg-white dark:bg-gray-900 shadow-4xl"
      id="video"
    >
      <div
        class="absolute -top-1 -left-1.25 size-2 bg-gray-150 dark:bg-gray-800 outline-2 outline-blue-400 dark:outline-blue-500"
      >
      </div>
      <div
        class="absolute -top-1 -right-1.25 size-2 bg-gray-150 dark:bg-gray-800 outline-2 outline-blue-400 dark:outline-blue-500"
      >
      </div>
      <div
        class="absolute -bottom-1 -left-1.25 size-2 bg-gray-150 dark:bg-gray-800 outline-2 outline-blue-400 dark:outline-blue-500"
      >
      </div>
      <div
        class="absolute -bottom-1 -right-1.25 size-2 bg-gray-150 dark:bg-gray-800 outline-2 outline-blue-400 dark:outline-blue-500"
      >
      </div>

      <div
        class="overflow-hidden absolute inset-0 before:absolute before:top-0 before:w-full before:h-32 before:bg-linear-to-b before:from-white before:to-transparent dark:before:from-gray-900 after:absolute after:bottom-0 after:w-full after:h-32 after:bg-linear-to-t after:from-white after:to-transparent dark:after:from-gray-900"
        id="motion"
      >
        <Scale />
      </div>
    </div>
  </div>

  <div
    class="text-center right-0 leading-none absolute -tracking-[.03em] left-0 text-[clamp(5rem,5cqw,10rem)] origin-[top_center] top-1/2 mt-[clamp(5rem,5cqw,10rem)]"
    id="size"
  >
    Size
  </div>
</div>

<script>
  import gsap from "gsap";

  const any = document.getElementById("any")!;
  const size = document.getElementById("size")!;
  const video = document.getElementById("video")!;
  const motion = document.getElementById("motion")!;

  let box = () => {
    const r = video.getBoundingClientRect();
    return { h: r.height };
  };

  let tl = gsap.timeline({
    defaults: {
      duration: 0.7,
      ease: "back.out(1.1)",
    },
    repeat: -1,
    repeatDelay: 1,
    repeatRefresh: true,
  });

  tl.set(video, {
    height: "60%",
    width: "100%",
  });

  tl.addLabel("toSquare");

  tl.to(
    video,
    {
      height: "80%",
      width: "80%",
    },
    "toSquare",
  );

  tl.to(
    motion,
    {
      scale: 1,
    },
    "toSquare",
  );

  tl.to(
    any,
    {
      scale: 1,
      y: () => box().h * -0.4,
    },
    "toSquare",
  );

  tl.to(
    size,
    {
      scale: 1,
      y: () => box().h * 0.35,
    },
    "toSquare",
  );

  tl.addLabel("toVertical", "+=1");

  tl.to(
    video,
    {
      height: "100%",
      width: "60%",
    },
    "toVertical",
  );

  tl.to(
    motion,
    {
      scale: 0.8,
    },
    "toVertical",
  );

  tl.to(
    any,
    {
      scale: 0.8,
      y: () => box().h * -0.425,
    },
    "toVertical",
  );

  tl.to(
    size,
    {
      scale: 0.8,
      y: () => box().h * 0.425,
    },
    "toVertical",
  );

  tl.addLabel("toWide", "+=1");

  tl.to(
    video,
    {
      height: "60%",
      width: "100%",
    },
    "toWide",
  );

  tl.to(
    motion,
    {
      scale: 0.9,
    },
    "toWide",
  );

  tl.to(
    any,
    {
      scale: 1.2,
      y: () => box().h * -0.15,
    },
    "toWide",
  );

  tl.to(
    size,
    {
      scale: 1.2,
      y: () => box().h * 0.15,
    },
    "toWide",
  );

  window.addEventListener("resize", () => {
    let p = tl.progress();
    tl.progress(0).invalidate();
    tl.progress(p);
  });
</script>
