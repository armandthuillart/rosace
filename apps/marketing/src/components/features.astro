---
import Resize from "@components/resize.astro";
---

<section class="px-5">
  <div
    class="max-w-7xl gap-x-2.5 gap-y-4 bg-gray-100 dark:bg-gray-950 rounded-sm mx-auto p-5 flex flex-col lg:grid lg:grid-cols-24 inset-ring inset-ring-black/2.5 dark:inset-ring-white/2.5"
  >
    <div class="lg:col-start-1 lg:col-end-9 lg:self-center lg:pr-7.5">
      <h3
        class="text-pretty font-medium tracking-[.005em] sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em]"
      >
        Create faster
      </h3>

      <p
        class="text-pretty text-gray-500 dark:text-gray-400 font-medium tracking-[.005em] sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em]"
      >
        Translate ideas to animations at the speed of your imagination.
      </p>
    </div>

    <div
      class="overflow-hidden bg-gray-150 dark:bg-gray-800 rounded-sm relative inset-ring inset-ring-black/2.5 dark:inset-ring-white/2.5 lg:col-start-9 lg:col-end-25 py-7 pl-6 lg:py-8 lg:pl-7"
    >
      <div
        class="relative ring ring-black/5 dark:ring-white/5 rounded-[.625rem] shrink-0 bg-gray-100 dark:bg-gray-900 shadow-4xl w-230 h-150"
      >
      </div>
    </div>
  </div>
</section>

<section class="px-5">
  <div
    class="max-w-7xl gap-x-2.5 gap-y-4 bg-gray-100 dark:bg-gray-950 rounded-sm mx-auto p-5 flex flex-col lg:grid lg:grid-cols-24 inset-ring inset-ring-black/2.5 dark:inset-ring-white/2.5"
  >
    <div
      class="lg:row-start-1 lg:col-start-17 lg:col-end-25 lg:self-center lg:pl-8"
    >
      <h3
        class="text-pretty font-medium tracking-[.005em] sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em]"
      >
        Have fun
      </h3>

      <p
        class="text-pretty text-gray-500 dark:text-gray-400 font-medium tracking-[.005em] sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em]"
      >
        Do your best work while enjoying every bit of it.
      </p>
    </div>

    <div
      class="flex justify-end overflow-hidden bg-gray-150 dark:bg-gray-800 rounded-sm relative gap-6 inset-ring inset-ring-black/2.5 dark:inset-ring-white/2.5 lg:col-start-1 lg:col-end-17 lg:row-start-1 py-7 pr-6 lg:py-8 lg:pr-7"
    >
      <div
        class="relative ring ring-black/5 dark:ring-white/5 rounded-[.625rem] bg-gray-100 dark:bg-gray-900 shadow-4xl shrink-0 w-230 h-146"
      >
      </div>
    </div>
  </div>
</section>

<section class="px-5">
  <div
    class="max-w-7xl gap-x-2.5 gap-y-4 bg-gray-100 dark:bg-gray-950 rounded-sm mx-auto p-5 flex flex-col lg:grid lg:grid-cols-24 inset-ring inset-ring-black/2.5 dark:inset-ring-white/2.5"
  >
    <div class="lg:col-start-1 lg:col-end-9 lg:self-center lg:pr-7.5">
      <h3
        class="text-pretty font-medium tracking-[.005em] sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em]"
      >
        Scale content
      </h3>

      <p
        class="text-pretty text-gray-500 dark:text-gray-400 font-medium tracking-[.005em] sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em]"
      >
        Get it resized to any format you need, automatically.
      </p>
    </div>

    <div
      class="overflow-hidden bg-gray-150 dark:bg-gray-800 rounded-sm inset-ring inset-ring-black/2.5 dark:inset-ring-white/2.5 lg:col-start-9 lg:col-end-25 py-7 px-6 lg:py-8 lg:px-7"
    >
      <Resize />
    </div>
  </div>
</section>
