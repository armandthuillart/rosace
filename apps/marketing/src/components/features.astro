---
import Actions from "@components/actions.astro";
import Resize from "@components/resize.astro";
import Templates from "@components/templates.astro";
---

<section class="px-5" id="create-faster">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-x-2.5 gap-y-4 rounded-sm bg-gray-100 p-5 inset-ring inset-ring-black/2.5 lg:grid lg:grid-cols-24 dark:bg-gray-950 dark:inset-ring-white/2.5"
  >
    <div class="lg:col-start-1 lg:col-end-9 lg:self-center lg:pr-7.5">
      <h3
        class="font-medium tracking-[.005em] text-pretty sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em]"
      >
        Create faster
      </h3>

      <p
        class="font-medium tracking-[.005em] text-pretty text-gray-500 sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em] dark:text-gray-400"
      >
        Translate ideas to animations at the speed of your imagination.
      </p>
    </div>

    <div
      class="bg-gray-150 relative overflow-hidden rounded-sm px-6 py-7 inset-ring inset-ring-black/2.5 lg:col-start-9 lg:col-end-25 lg:px-7 lg:py-8 dark:bg-gray-900 dark:inset-ring-white/2.5"
    >
      <Templates />
    </div>
  </div>
</section>

<section class="px-5" id="have-fun">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-x-2.5 gap-y-4 rounded-sm bg-gray-100 p-5 inset-ring inset-ring-black/2.5 lg:grid lg:grid-cols-24 dark:bg-gray-950 dark:inset-ring-white/2.5"
  >
    <div
      class="lg:col-start-17 lg:col-end-25 lg:row-start-1 lg:self-center lg:pl-8"
    >
      <h3
        class="font-medium tracking-[.005em] text-pretty sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em]"
      >
        Have fun
      </h3>

      <p
        class="font-medium tracking-[.005em] text-pretty text-gray-500 sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em] dark:text-gray-400"
      >
        Do your best work while enjoying every bit of it.
      </p>
    </div>

    <div
      class="bg-gray-150 relative flex justify-end gap-6 overflow-hidden rounded-sm px-6 py-7 inset-ring inset-ring-black/2.5 lg:col-start-1 lg:col-end-17 lg:row-start-1 lg:px-7 lg:py-8 dark:bg-gray-900 dark:inset-ring-white/2.5"
    >
      <Actions />
    </div>
  </div>
</section>

<section class="px-5" id="scale-content">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-x-2.5 gap-y-4 rounded-sm bg-gray-100 p-5 inset-ring inset-ring-black/2.5 lg:grid lg:grid-cols-24 dark:bg-gray-950 dark:inset-ring-white/2.5"
  >
    <div class="lg:col-start-1 lg:col-end-9 lg:self-center lg:pr-7.5">
      <h3
        class="font-medium tracking-[.005em] text-pretty sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em]"
      >
        Scale content
      </h3>

      <p
        class="font-medium tracking-[.005em] text-pretty text-gray-500 sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em] dark:text-gray-400"
      >
        Get it resized to any format you need, automatically.
      </p>
    </div>

    <div
      class="bg-gray-150 overflow-hidden rounded-sm px-6 py-7 inset-ring inset-ring-black/2.5 lg:col-start-9 lg:col-end-25 lg:px-7 lg:py-8 dark:bg-gray-900 dark:inset-ring-white/2.5"
    >
      <Resize />
    </div>
  </div>
</section>
