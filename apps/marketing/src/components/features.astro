						/>
					</div>
				</div>

				<div
					id="size-dot"
					class="z-30 top-1/2 absolute left-1/2 w-[clamp(6.25rem,10cqw+3.5rem,12.5rem)] mt-[clamp(-6.25rem,-5cqw-1.75rem,-3.125rem)] ml-[clamp(-6.25rem,-5cqw-1.75rem,-3.125rem)] h-[clamp(6.25rem,10cqw+3.5rem,12.5rem)]"
				>
					<div class="size-full rounded-full bg-tertiary" />
				</div>

				<div
					class="text-center right-0 leading-none absolute -tracking-[.03em] left-0 text-[clamp(3.75rem,4.5cqw+2.75rem,6.25rem)] origin-[50%_0] top-1/2 mt-[clamp(6.5625rem,12.5cqw+4rem,12.5rem)]"
					id="size-text-right"
				>
					<span>Size</span>
