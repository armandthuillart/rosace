<script>
import gsap from "gsap";
import { CustomEase } from "gsap/all";
import { SplitText } from "gsap/SplitText";

gsap.registerPlugin(CustomEase, SplitText);

const presetDemo = document.querySelector("[data-preset-demo]");

if (presetDemo) {
	const selector = gsap.utils.selector(presetDemo);
	const presetElements = selector("[data-split-preset]").filter(
		(element): element is HTMLElement => element instanceof HTMLElement,
	);

	const wrapChars = (chars: Element[]) =>
		chars
			.filter((char): char is HTMLElement => char instanceof HTMLElement)
			.map((char) => {
				const wrapper = document.createElement("span");
				wrapper.className = "preset-char-mask";
				char.parentNode?.insertBefore(wrapper, char);
				wrapper.appendChild(char);

				return {
					char,
					wrapper,
				};
			});

	const splitInstances = presetElements.map((element) => {
		const split = new SplitText(element, {
			charsClass: "preset-char",
			type: "chars",
		});

		return {
			chars: wrapChars(split.chars),
			element,
			split,
		};
	});

	const getChars = (preset: string) =>
		splitInstances.find(({ element }) => element.dataset.splitPreset === preset)
			?.chars ?? [];

	const blurInChars = getChars("blur-in");
	const blurSlideChars = getChars("blur-slide");
	const maskInTopChars = getChars("mask-in-top");
	const maskInBottomChars = getChars("mask-in-bottom");
	const maskOutTopChars = getChars("mask-out-top");
	const maskOutBottomChars = getChars("mask-out-bottom");
	const allChars = splitInstances.flatMap(({ chars }) =>
		chars.map(({ char }) => char),
	);
	const allWrappers = splitInstances.flatMap(({ chars }) =>
		chars.map(({ wrapper }) => wrapper),
	);
	const blurInTargets = blurInChars.map(({ char }) => char);
	const blurSlideTargets = blurSlideChars.map(({ char }) => char);
	const maskInTopTargets = maskInTopChars.map(({ char }) => char);
	const maskInBottomTargets = maskInBottomChars.map(({ char }) => char);
	const maskOutTopTargets = maskOutTopChars.map(({ char }) => char);
	const maskOutBottomTargets = maskOutBottomChars.map(({ char }) => char);
	const maskInTopWrappers = maskInTopChars.map(({ wrapper }) => wrapper);
	const maskInBottomWrappers = maskInBottomChars.map(({ wrapper }) => wrapper);
	const maskOutTopWrappers = maskOutTopChars.map(({ wrapper }) => wrapper);
	const maskOutBottomWrappers = maskOutBottomChars.map(
		({ wrapper }) => wrapper,
	);

	const timings = {
		playDuration: 0.72,
		playWindow: 0.16,
		resetDuration: 0.68,
		resetStart: 1.78,
		resetWindow: 0.14,
	};

	const eases = {
		play: CustomEase.create("feature-preset-play", "M0,0 C0.18,1 0.32,1 1,1"),
		reset: CustomEase.create("feature-preset-reset", "M0,0 C0.32,0 0.12,1 1,1"),
	};

	gsap.set(allWrappers, {
		display: "inline-block",
		lineHeight: 1,
		overflow: "hidden",
		verticalAlign: "top",
		willChange: "clip-path",
	});

	gsap.set(allChars, {
		autoAlpha: 1,
		display: "inline-block",
		force3D: true,
		rotateZ: 0.01,
		scale: 1,
		transformOrigin: "50% 50%",
		willChange: "transform, opacity, filter",
		yPercent: 0,
	});

	const getStagger = (
		targets: HTMLElement[],
		window: number,
		from: "start" | "end" = "start",
	) => {
		if (targets.length <= 1) {
			return 0;
		}

		const each = window / (targets.length - 1);

		if (from === "end") {
			return {
				each,
				from: "end" as const,
			};
		}

		return each;
	};

	type Preset = {
		playChar: gsap.TweenVars;
		playWrapper?: gsap.TweenVars;
		resetChar: gsap.TweenVars;
		resetWrapper?: gsap.TweenVars;
		startChar: gsap.TweenVars;
		startWrapper?: gsap.TweenVars;
		targets: HTMLElement[];
		wrappers: HTMLElement[];
	};

	const presets: Preset[] = [
		{
			playChar: {
				autoAlpha: 1,
				filter: "blur(0px)",
				scale: 1,
				yPercent: 0,
			},
			resetChar: {
				autoAlpha: 0,
				filter: "blur(6px)",
				scale: 0.97,
				yPercent: 0,
			},
			startChar: {
				autoAlpha: 0,
				filter: "blur(6px)",
				scale: 0.97,
				yPercent: 0,
			},
			targets: blurInTargets,
			wrappers: [],
		},
		{
			playChar: {
				autoAlpha: 1,
				filter: "blur(0px)",
				scale: 1,
				yPercent: 0,
			},
			resetChar: {
				autoAlpha: 0,
				filter: "blur(6px)",
				scale: 0.985,
				yPercent: 24,
			},
			startChar: {
				autoAlpha: 0,
				filter: "blur(6px)",
				scale: 0.985,
				yPercent: 24,
			},
			targets: blurSlideTargets,
			wrappers: [],
		},
		{
			playChar: {
				yPercent: 0,
			},
			playWrapper: {
				clipPath: "inset(0% 0% 0% 0%)",
			},
			resetChar: {
				yPercent: -18,
			},
			resetWrapper: {
				clipPath: "inset(0% 0% 100% 0%)",
			},
			startChar: {
				yPercent: -18,
			},
			startWrapper: {
				clipPath: "inset(0% 0% 100% 0%)",
			},
			targets: maskInTopTargets,
			wrappers: maskInTopWrappers,
		},
		{
			playChar: {
				yPercent: 0,
			},
			playWrapper: {
				clipPath: "inset(0% 0% 0% 0%)",
			},
			resetChar: {
				yPercent: 18,
			},
			resetWrapper: {
				clipPath: "inset(100% 0% 0% 0%)",
			},
			startChar: {
				yPercent: 18,
			},
			startWrapper: {
				clipPath: "inset(100% 0% 0% 0%)",
			},
			targets: maskInBottomTargets,
			wrappers: maskInBottomWrappers,
		},
		{
			playChar: {
				yPercent: 0,
			},
			playWrapper: {
				clipPath: "inset(0% 0% 0% 0%)",
			},
			resetChar: {
				yPercent: -18,
			},
			resetWrapper: {
				clipPath: "inset(0% 0% 100% 0%)",
			},
			startChar: {
				yPercent: -18,
			},
			startWrapper: {
				clipPath: "inset(0% 0% 100% 0%)",
			},
			targets: maskOutTopTargets,
			wrappers: maskOutTopWrappers,
		},
		{
			playChar: {
				yPercent: 0,
			},
			playWrapper: {
				clipPath: "inset(0% 0% 0% 0%)",
			},
			resetChar: {
				yPercent: 18,
			},
			resetWrapper: {
				clipPath: "inset(100% 0% 0% 0%)",
			},
			startChar: {
				yPercent: 18,
			},
			startWrapper: {
				clipPath: "inset(100% 0% 0% 0%)",
			},
			targets: maskOutBottomTargets,
			wrappers: maskOutBottomWrappers,
		},
	];

	const setState = ({ startChar, startWrapper, targets, wrappers }: Preset) => {
		gsap.set(targets, startChar);

		if (wrappers.length > 0) {
			gsap.set(wrappers, startWrapper ?? { clipPath: "inset(0% 0% 0% 0%)" });
		}
	};

	presets.forEach(setState);

	const timeline = gsap.timeline({
		id: "feature-presets",
		repeat: -1,
		repeatDelay: 0.08,
	});

	for (const preset of presets) {
		timeline.to(
			preset.targets,
			{
				duration: timings.playDuration,
				ease: eases.play,
				...preset.playChar,
				stagger: getStagger(preset.targets, timings.playWindow),
			},
			0,
		);

		if (preset.wrappers.length > 0 && preset.playWrapper) {
			timeline.to(
				preset.wrappers,
				{
					duration: timings.playDuration,
					ease: eases.play,
					...preset.playWrapper,
					stagger: getStagger(preset.wrappers, timings.playWindow),
				},
				0,
			);
		}

		timeline.to(
			preset.targets,
			{
				duration: timings.resetDuration,
				ease: eases.reset,
				...preset.resetChar,
				stagger: getStagger(preset.targets, timings.resetWindow, "end"),
			},
			timings.resetStart,
		);

		if (preset.wrappers.length > 0 && preset.resetWrapper) {
			timeline.to(
				preset.wrappers,
				{
					duration: timings.resetDuration,
					ease: eases.reset,
					...preset.resetWrapper,
					stagger: getStagger(preset.wrappers, timings.resetWindow, "end"),
				},
				timings.resetStart,
			);
		}
	}
}
</script>

