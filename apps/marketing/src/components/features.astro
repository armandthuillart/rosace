<script>
import gsap from "gsap";
import { SplitText } from "gsap/SplitText";

gsap.registerPlugin(SplitText);

type PresetName =
	| "blur-in"
	| "blur-slide"
	| "mask-in-top"
	| "mask-in-bottom"
	| "mask-out-top"
	| "mask-out-bottom";

type PresetDemoElement = HTMLElement & {
	__presetCleanup?: () => void;
};

const presetDemo = document.querySelector(
	"[data-preset-demo]",
) as PresetDemoElement | null;
const reducedMotionQuery = window.matchMedia(
	"(prefers-reduced-motion: reduce)",
);

if (presetDemo) {
	presetDemo.__presetCleanup?.();

	const presetTargets = Array.from(
		presetDemo.querySelectorAll<HTMLElement>("[data-split-preset]"),
	);
	const splitTargets = [] as SplitText[];
	const animations = [] as gsap.core.Animation[];
	const step = {
		enter: 0.8,
		exit: 0.65,
		hold: 0.35,
		staggerIn: 0.045,
		staggerOut: 0.035,
	};

	const clearAnimations = () => {
		while (animations.length > 0) {
			animations.pop()?.kill();
		}

		while (splitTargets.length > 0) {
			splitTargets.pop()?.revert();
		}

		gsap.set(presetTargets, {
			clearProps: "all",
		});
	};

	const setStaticState = () => {
		clearAnimations();

		gsap.set(presetTargets, {
			autoAlpha: 1,
			clearProps: "all",
			filter: "blur(0px)",
		});
	};

	const splitPreset = (target: HTMLElement) => {
		gsap.set(target, {
			display: "inline-block",
			overflow: "hidden",
		});

		const split = new SplitText(target, {
			type: "chars",
		});
		const chars = split.chars as HTMLElement[];

		splitTargets.push(split);

		gsap.set(chars, {
			display: "inline-block",
			transformOrigin: "50% 50%",
			willChange: "transform, opacity, filter, clip-path",
		});

		return chars;
	};

	const createBlurIn = (chars: HTMLElement[], delay: number) => {
		const timeline = gsap.timeline({
			delay,
			repeat: -1,
			repeatDelay: 0,
		});

		timeline
			.set(chars, {
				autoAlpha: 0.2,
				filter: "blur(4px)",
				scale: 0.96,
				yPercent: 0,
			})
			.to(chars, {
				autoAlpha: 1,
				duration: step.enter * 0.7,
				ease: "power4.out",
				filter: "blur(0px)",
				scale: 1,
				stagger: step.staggerIn,
			})
			.to(
				chars,
				{
					autoAlpha: 1,
					duration: step.hold,
					ease: "none",
					filter: "blur(0px)",
					scale: 1,
				},
				">",
			)
			.to(chars, {
				autoAlpha: 0.2,
				duration: step.exit * 0.8,
				ease: "power2.in",
				filter: "blur(4px)",
				scale: 0.96,
				stagger: step.staggerOut,
			});

		return timeline;
	};

	const createBlurSlide = (chars: HTMLElement[], delay: number) => {
		const timeline = gsap.timeline({
			delay,
			repeat: -1,
			repeatDelay: 0,
		});

		timeline
			.set(chars, {
				autoAlpha: 0.25,
				filter: "blur(3px)",
				yPercent: 100,
			})
			.to(chars, {
				autoAlpha: 1,
				duration: step.enter * 0.75,
				ease: "power3.out",
				filter: "blur(0px)",
				stagger: step.staggerIn,
				yPercent: 0,
			})
			.to(chars, {
				autoAlpha: 0.25,
				duration: step.enter * 0.85,
				ease: "power2.in",
				filter: "blur(3px)",
				stagger: step.staggerOut,
				yPercent: -100,
			});

		return timeline;
	};

	const createMaskIn = (
		chars: HTMLElement[],
		delay: number,
		direction: "top" | "bottom",
	) => {
		const hiddenState =
			direction === "top"
				? {
						clipPath: "inset(0% 0% 100% 0%)",
						yPercent: -120,
					}
				: {
						clipPath: "inset(100% 0% 0% 0%)",
						yPercent: 120,
					};
		const timeline = gsap.timeline({
			delay,
			repeat: -1,
			repeatDelay: 0,
		});

		timeline
			.set(chars, {
				...hiddenState,
				autoAlpha: 1,
			})
			.to(chars, {
				clipPath: "inset(0% 0% 0% 0%)",
				duration: step.enter,
				ease: "power4.out",
				stagger: step.staggerIn,
				yPercent: 0,
			})
			.to(
				chars,
				{
					duration: step.hold,
					ease: "none",
				},
				">",
			)
			.to(chars, {
				...hiddenState,
				duration: step.exit,
				ease: "power2.in",
				stagger: step.staggerOut,
			});

		return timeline;
	};

	const createMaskOut = (
		chars: HTMLElement[],
		delay: number,
		direction: "top" | "bottom",
	) => {
		const exitState =
			direction === "top"
				? {
						clipPath: "inset(0% 0% 100% 0%)",
						yPercent: -120,
					}
				: {
						clipPath: "inset(100% 0% 0% 0%)",
						yPercent: 120,
					};
		const resetState =
			direction === "top"
				? {
						clipPath: "inset(100% 0% 0% 0%)",
						yPercent: 120,
					}
				: {
						clipPath: "inset(0% 0% 100% 0%)",
						yPercent: -120,
					};
		const timeline = gsap.timeline({
			delay,
			repeat: -1,
			repeatDelay: 0,
		});

		timeline
			.set(chars, {
				autoAlpha: 1,
				clipPath: "inset(0% 0% 0% 0%)",
				yPercent: 0,
			})
			.to(
				chars,
				{
					duration: step.hold,
					ease: "none",
				},
				0,
			)
			.to(chars, {
				...exitState,
				duration: step.exit,
				ease: "power2.in",
				stagger: step.staggerOut,
			})
			.set(chars, resetState)
			.to(chars, {
				clipPath: "inset(0% 0% 0% 0%)",
				duration: step.enter,
				ease: "power4.out",
				stagger: step.staggerIn,
				yPercent: 0,
			});

		return timeline;
	};

	const animationFactories: Record<
		PresetName,
		(chars: HTMLElement[], delay: number) => gsap.core.Animation
	> = {
		"blur-in": createBlurIn,
		"blur-slide": createBlurSlide,
		"mask-in-bottom": (chars, delay) => createMaskIn(chars, delay, "bottom"),
		"mask-in-top": (chars, delay) => createMaskIn(chars, delay, "top"),
		"mask-out-bottom": (chars, delay) => createMaskOut(chars, delay, "bottom"),
		"mask-out-top": (chars, delay) => createMaskOut(chars, delay, "top"),
	};

	const buildPresetAnimations = () => {
		clearAnimations();

		if (reducedMotionQuery.matches) {
			setStaticState();
			return;
		}

		presetTargets.forEach((target, index) => {
			const presetName = target.dataset.splitPreset as PresetName | undefined;

			if (!presetName) {
				return;
			}

			const createAnimation = animationFactories[presetName];

			if (!createAnimation) {
				return;
			}

			const chars = splitPreset(target);
			const animation = createAnimation(chars, index * 0.18);

			animations.push(animation);
		});
	};

	const handleMotionChange = () => {
		buildPresetAnimations();
	};

	const teardown = () => {
		clearAnimations();
		reducedMotionQuery.removeEventListener("change", handleMotionChange);
		window.removeEventListener("pagehide", teardown);
		presetDemo.__presetCleanup = undefined;
	};

	presetDemo.__presetCleanup = teardown;

	reducedMotionQuery.addEventListener("change", handleMotionChange);
	window.addEventListener("pagehide", teardown, { once: true });

	buildPresetAnimations();
}
</script>

