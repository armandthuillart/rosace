---
import AnySize from "@components/any-size.astro";
import BuiltInPresets from "@components/built-in-presets.astro";
---

<section class="px-5">
	<div
		class="max-w-7xl gap-x-10 gap-y-4 relative bg-accent rounded-sm mx-auto p-5 flex flex-col lg:flex-row before:absolute before:inset-0 before:rounded-sm before:pointer-events-none before:border before:border-border/25"
	>
		<div class="lg:self-center">
			<h3
				class="text-pretty font-medium tracking-[.005em] sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em]"
			>
				Create faster
			</h3>

			<p
				class="text-pretty text-muted-foreground font-medium tracking-[.005em] sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em]"
			>
				Translate ideas to animations at the speed of your imagination.
			</p>
		</div>

		<BuiltInPresets />
	</div>
</section>

<section class="px-5">
	<div
		class="max-w-7xl relative gap-x-10 gap-y-4 bg-accent rounded-sm mx-auto p-5 flex flex-col lg:flex-row-reverse before:absolute before:inset-0 before:rounded-sm before:pointer-events-none before:border before:border-border/25"
	>
		<div class="lg:self-center">
			<h3
				class="text-pretty font-medium tracking-[.005em] sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em]"
			>
				Have fun
			</h3>

			<p
				class="text-pretty text-muted-foreground font-medium tracking-[.005em] sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em]"
			>
				Do your best work while enjoying every second of it.
			</p>
		</div>

		<div
			class="overflow-hidden lg:w-2/3 h-170 p-12 bg-card rounded-sm relative after:absolute after:inset-0 after:rounded-sm after:pointer-events-none after:border after:border-border/50"
		/>
	</div>
</section>

<section class="px-5">
	<div
		class="max-w-7xl relative gap-x-10 gap-y-4 bg-accent rounded-sm mx-auto p-5 flex flex-col lg:flex-row before:absolute before:inset-0 before:rounded-sm before:pointer-events-none before:border before:border-border/25"
	>
		<div class="lg:self-center">
			<h3
				class="text-pretty font-medium tracking-[.005em] sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em]"
			>
				Scale content
			</h3>

			<p
				class="text-pretty text-muted-foreground font-medium tracking-[.005em] sm:text-[1.375rem]/[1.3] sm:-tracking-[.005em]"
			>
				Get it resized to any format you need, automatically.
			</p>
		</div>

		<AnySize />
	</div>
</section>
