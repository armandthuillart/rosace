---
interface Props {
  classes?: string;
}

const { classes } = Astro.props;
---

<div
  class:list={[
    "absolute top-0 left-0 p-2 inline-flex gap-2 rounded-xl bg-white dark:bg-gray-800 shadow-control",
    classes,
  ]}
>
  <div
    class="bg-blue-400 dark:bg-blue-500 text-white size-8 shrink-0 rounded-sm flex items-center justify-center"
  >
    <svg
      aria-hidden="true"
      class="size-5 translate-x-px"
      fill="currentColor"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <use href="/sprite.svg#cursor"></use>
    </svg>
  </div>

  <div class="size-8 shrink-0 rounded-md flex items-center justify-center">
    <svg
      aria-hidden="true"
      class="size-5"
      fill="currentColor"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <use href="/sprite.svg#hold"></use>
    </svg>
  </div>

  <div class="-my-2 w-px bg-gray-200 dark:bg-gray-600"></div>

  <div class="size-8 shrink-0 rounded-md flex items-center justify-center">
    <svg
      aria-hidden="true"
      class="size-5"
      fill="currentColor"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <use href="/sprite.svg#menu"></use>
    </svg>
  </div>
</div>
