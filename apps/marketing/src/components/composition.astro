---
import cursorImage from "@assets/images/cursor.svg?url";
import grabImage from "@assets/images/grab.svg?url";
import grabbingImage from "@assets/images/grabbing.svg?url";
---

<div class="h-150 w-full relative" data-animate="composition">
  <div
    class="z-10 absolute top-0 left-0 p-2 inline-flex gap-2 rounded-xl bg-white dark:bg-gray-800 shadow-control"
  >
    <div
      class="bg-blue-400 dark:bg-blue-500 text-white size-8 shrink-0 rounded-sm flex items-center justify-center"
    >
      <svg
        aria-hidden="true"
        class="size-5 translate-x-px"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <use href="/sprite.svg#cursor"></use>
      </svg>
    </div>

    <div class="size-8 shrink-0 rounded-md flex items-center justify-center">
      <svg
        aria-hidden="true"
        class="size-5"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <use href="/sprite.svg#hold"></use>
      </svg>
    </div>

    <div class="-my-2 w-px bg-gray-200 dark:bg-gray-600"></div>

    <div
      class="size-8 shrink-0 rounded-md flex items-center justify-center"
      data-part="trigger"
    >
      <svg
        aria-hidden="true"
        class="size-5"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <use href="/sprite.svg#menu"></use>
      </svg>
    </div>
  </div>

  <div
    class="z-10 absolute top-0 right-0 p-2 rounded-xl bg-white dark:bg-gray-800 shadow-control"
  >
    <div
      class="bg-blue-400 dark:bg-blue-500 text-white pr-3 pl-2.5 text-sm h-8 shrink-0 rounded-sm gap-1.5 inline-flex items-center justify-center"
    >
      <svg
        aria-hidden="true"
        class="size-4"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <use href="/sprite.svg#download"></use>
      </svg>
      Export
    </div>
  </div>

  <div
    class="aspect-square left-1/2 -translate-x-1/2 absolute shadow-control -translate-y-1/2 top-[calc(50%-1rem)] outline-0 outline-blue-400 dark:outline-blue-500 h-[calc(100%-12rem)] sm:h-[calc(100%-8rem)] sm:top-6 sm:translate-y-0 bg-white dark:bg-gray-800"
    data-part="motion"
  >
    <div
      class="overflow-hidden absolute inset-0 pointer-events-none grid grid-cols-5"
    >
      {
        Array.from({ length: 50 }, (_, i) => (
          <div
            class:list={[
              "w-full aspect-square",
              { "bg-gray-50 dark:bg-gray-700": i % 2 === 0 },
              { "bg-white dark:bg-gray-800": i % 2 !== 0 },
            ]}
          />
        ))
      }
    </div>

    <div
      class="opacity-0 absolute -top-1 -left-1.25 size-2 bg-white dark:bg-gray-900 outline-2 outline-blue-400 dark:outline-blue-500"
      data-part="corner"
    >
    </div>

    <div
      class="opacity-0 absolute -top-1 -right-1.25 size-2 bg-white dark:bg-gray-900 outline-2 outline-blue-400 dark:outline-blue-500"
      data-part="corner"
    >
    </div>

    <div
      class="opacity-0 absolute -bottom-1 -left-1.25 size-2 bg-white dark:bg-gray-900 outline-2 outline-blue-400 dark:outline-blue-500"
      data-part="corner"
    >
    </div>

    <div
      class="opacity-0 absolute -bottom-1 -right-1.25 size-2 bg-white dark:bg-gray-900 outline-2 outline-blue-400 dark:outline-blue-500"
      data-part="corner"
    >
    </div>
  </div>

  <div
    class="absolute overflow-hidden h-18 bottom-0 left-1/2 rounded-[.875rem] bg-white dark:bg-gray-800 shadow-timeline -translate-x-1/2 w-full max-w-xl inline-flex before:absolute before:left-0 before:h-full before:w-15 before:bg-linear-to-r before:z-1 before:from-white before:to-transparent dark:before:from-gray-800 before:from-10%"
    data-part="timeline"
  >
    <div
      class="z-20 absolute inset-y-1 rounded-full w-0.5 bg-red-400 dark:bg-red-500 left-0 -translate-x-0.5"
      data-part="playhead"
    >
    </div>

    <div
      class="inset-2 right-auto rounded-md bg-white dark:bg-gray-800 px-2 flex items-center justify-center absolute z-30 shadow-timeline text-gray-400"
      data-part="controls"
    >
      <svg
        aria-hidden="true"
        class="size-3.5"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <use href="/sprite.svg#play"></use>
      </svg>

      <svg
        aria-hidden="true"
        class="size-3.5"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <use href="/sprite.svg#pause"></use>
      </svg>
    </div>

    <div class="flex shrink-0" data-part="track">
      {
        Array.from({ length: 5 }, (_, index) => (
          <div class="flex flex-col h-full w-48 border-r border-gray-200 dark:border-gray-600">
            <div class="h-6 pl-1.5 pt-1.25 text-xs text-gray-400 dark:text-gray-500">
              {index}s
            </div>

            <div class="relative h-6 bg-gray-50 border-y border-gray-150 dark:border-gray-600 dark:bg-gray-700">
              {/* {markers?.length ? (
                <div
                  class="size-6.25 p-0.75 border border-gray-150 dark:border-gray-600 bg-white dark:bg-gray-800 rounded-full absolute top-1/2 -translate-y-1/2"
                  style={`left: ${toLeft(markers[index % markers.length])}`}
                >
                  <div class="size-full bg-blue-400 dark:bg-blue-500 rounded-full" />
                </div>
              ) : null} */}
            </div>
          </div>
        ))
      }

      <div
        class="relative flex flex-col h-full w-0 shrink-0 overflow-visible border-r border-gray-200 dark:border-gray-600"
      >
        <div
          class="absolute right-1.5 h-6 pt-1.25 text-xs text-gray-400 dark:text-gray-500 whitespace-nowrap"
        >
          5s
        </div>

        <div
          class="relative h-6 w-0 border-y border-gray-150 dark:border-gray-600"
        >
        </div>
      </div>
    </div>
  </div>

  <img
    src={cursorImage}
    alt="Cursor"
    class="origin-center absolute top-0 left-0 size-12 z-30 opacity-0"
    data-part="cursor"
    data-cursor-grab={grabImage}
    data-cursor-grabbing={grabbingImage}
  />

  <div
    class="overflow-hidden p-2 pb-0 flex flex-col opacity-0 absolute left-0 shadow-control rounded-[.875rem] gap-2 top-14 w-60 bottom-20 bg-white dark:bg-gray-800"
    data-part="elements"
  >
    <div
      class="items-center text-[.8125rem] text-gray-500/70 dark:text-gray-400/70 rounded-md h-8 w-full bg-gray-100 dark:bg-gray-700 inline-flex"
    >
      <div class="size-8 flex items-center justify-center">
        <svg
          aria-hidden="true"
          class="size-4"
          fill="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <use href="/sprite.svg#search"></use>
        </svg>
      </div>
      Search...
    </div>

    <div class="inline-flex gap-1">
      <div
        class="text-[.6875rem]/6 font-semibold px-2 rounded-sm bg-gray-100 dark:bg-gray-700"
      >
        All
      </div>

      <div
        class="text-[.6875rem]/6 font-medium text-gray-500 dark:text-gray-400 px-2 rounded-sm"
      >
        Assets
      </div>
    </div>

    <div
      class="overflow-y-scroll [scrollbar-width:none] flex-1 flex flex-col gap-2"
      data-part="starters"
    >
      <div
        class="flex gap-2 flex-col p-3 bg-gray-100 dark:bg-gray-700 rounded-md"
        data-part="edit"
      >
        <div class="flex flex-col">
          <div class="text-[.8125rem]/5">Edit</div>
          <div class="text-[.6875rem]/4 text-gray-500 dark:text-gray-400">
            Drop a track and watch your animation snap to the beat on its own.
          </div>
        </div>

        <div class="flex gap-3 h-34"></div>
      </div>

      <div
        class="flex gap-4 flex-col p-3 bg-gray-100 dark:bg-gray-700 rounded-md"
      >
        <div class="flex flex-col">
          <div class="text-[.8125rem]/5">Code</div>
          <div class="text-[.6875rem]/4 text-gray-500 dark:text-gray-400">
            Pick a theme and let your code type itself out. Diffs, highlights,
            and more.
          </div>
        </div>

        <div class="flex flex-col gap-2 items-center">
          <div
            class="relative pt-1.5 font-mono text-[.6875rem]/4 text-gray-500 dark:text-gray-400 grid grid-cols-[1.25rem_1fr] bg-white dark:bg-gray-800 grid-rows-[repeat(4,1rem)] w-38 h-20 border border-gray-200 dark:border-gray-600 rounded-md"
            data-part="editor"
          >
            <div
              class="absolute left-5 inset-y-0 w-px bg-gray-200 dark:bg-gray-600"
            >
            </div>

            <div
              class="flex items-center justify-end border-r border-transparent pr-0.75"
            >
              1
            </div>

            <div class="pl-1.5 inline-flex items-center">
              <span class="text-[#B3013F] dark:text-[#83D2CD]">function</span>
              <span>&nbsp;</span>
              <span class="text-[#DB704B] dark:text-[#EFB080]">map</span>
              <span class="text-[#05517F] dark:text-[#FFD700]">()</span>
              <span>&nbsp;</span>
              <span class="text-[#3D7CAB] dark:text-[#D970D6]">{"{"}</span>
            </div>

            <div
              class="flex items-center justify-end border-r border-transparent pr-0.75"
            >
              2
            </div>

            <div
              class="pl-1.5 flex items-center text-[#5E5E5E] dark:text-[#636363]"
            >
              &nbsp;&nbsp;
              <span class="text-[#216595] dark:text-[#D6D6DD]">console</span>
              <span class="text-[#262626] dark:text-[#D4D4D4]">.</span>
              <span class="text-[#DB704B] dark:text-[#EFB080]">log</span>
              <span class="text-[#05517F] dark:text-[#FFD700]">{"("}</span>
              <span class="text-[#5E5E5E] dark:text-[#636363]">...</span>
              <span class="text-[#05517F] dark:text-[#FFD700]">{")"}</span>
            </div>

            <div
              class="flex items-center justify-end border-r border-transparent pr-0.75"
            >
              3
            </div>

            <div
              class="pl-1.5 flex items-center text-[#B3013F] dark:text-[#83D2CD]"
            >
              &nbsp;&nbsp;{"return"}
            </div>

            <div
              class="flex items-center justify-end border-r border-transparent pr-0.75"
            >
              4
            </div>

            <div
              class="pl-1.5 flex items-center text-[#3D7CAB] dark:text-[#D970D6]"
            >
              {"}"}
            </div>
          </div>

          <div
            class="flex items-center text-[.6875rem]/4 text-gray-500 font-medium dark:text-gray-400"
          >
            Code editor
          </div>
        </div>
      </div>

      <div
        class="flex gap-2 flex-col p-3 bg-gray-100 dark:bg-gray-700 rounded-md"
      >
        <div class="flex flex-col">
          <div class="text-[.8125rem]/5">Mockup</div>
          <div class="text-[.6875rem]/4 text-gray-500 dark:text-gray-400">
            Animate inside a phone, browser, or tablet frame in seconds.
          </div>
        </div>

        <div class="flex gap-3 h-34"></div>
      </div>
    </div>
  </div>
</div>

<script>
  import gsap from "gsap";

  let root = document.querySelector<HTMLElement>(
    '[data-animate="composition"]',
  )!;
  let motion = document.querySelector<HTMLElement>('[data-part="motion"]')!;
  let cursor = document.querySelector<HTMLImageElement>(
    '[data-part="cursor"]',
  )!;

  let edit = document.querySelector<HTMLElement>('[data-part="edit"]')!;
  let editor = document.querySelector<HTMLElement>('[data-part="editor"]')!;
  let corners = gsap.utils.toArray<HTMLElement>('[data-part="corner"]')!;
  let trigger = document.querySelector<HTMLElement>('[data-part="trigger"]')!;
  let elements = document.querySelector<HTMLElement>('[data-part="elements"]')!;
  let starters = document.querySelector<HTMLElement>('[data-part="starters"]')!;

  let grab = cursor.dataset.cursorGrab!;
  let pointer = cursor.src;
  let grabbing = cursor.dataset.cursorGrabbing!;

  let box = (el: HTMLElement) => {
    let r = el.getBoundingClientRect();
    let b = root.getBoundingClientRect();
    return {
      x: r.left - b.left,
      y: r.top - b.top,
      w: r.width,
      h: r.height,
    };
  };

  let aabb = (
    a: { x: number; y: number; w: number; h: number },
    b: { x: number; y: number; w: number; h: number },
  ) =>
    a.x + a.w >= b.x &&
    a.x <= b.x + b.w &&
    a.y + a.h >= b.y &&
    a.y <= b.y + b.h;

  let ow = gsap.quickTo(motion, "outlineWidth", {
    duration: 0.1,
    ease: "power2.out",
  });

  let tl = gsap.timeline({
    defaults: {
      duration: 0.11,
      ease: "power2.out",
    },
    // repeat: -1,
    // repeatRefresh: true,
  });

  tl.set(motion, {
    width: () => box(motion).h,
    outlineWidth: 0,
  });

  tl.set(corners, {
    scale: 0,
    opacity: 0,
  });

  tl.set(cursor, {
    x: () => box(root).w * 0.8,
    y: () => box(root).h * 0.8,
    scale: 1,
    opacity: 0,
  });

  tl.to(cursor, {
    duration: 0.65,
    ease: "power2.inOut",
    x: () => {
      let r = box(motion);
      return r.x + r.w / 2 - cursor.offsetWidth / 2;
    },
    y: () => {
      let r = box(motion);
      return r.y + r.h / 2 - cursor.offsetHeight / 2;
    },
    opacity: 1,
    onUpdate: () => {
      let a = box(cursor);
      let b = box(motion);

      if (aabb(a, b)) {
        ow(2);
      }
    },
  });

  tl.to(cursor, {
    duration: 0.2,
    scale: 0.8,
    ease: "power2.inOut",
    yoyo: true,
    repeat: 1,
  });

  tl.to(
    corners,
    {
      scale: 1,
      opacity: 1,
    },
    "-=0.4",
  );

  tl.to(cursor, {
    duration: 0.45,
    ease: "power2.inOut",
    x: () => box(motion).x - cursor.offsetWidth / 2,
    y: () => {
      let r = box(motion);
      return r.y + r.h / 2 - cursor.offsetHeight / 2;
    },
  });

  tl.call(
    () => {
      cursor.src = grab;
    },
    [],
    "-=0.25",
  );

  tl.to(
    cursor,
    {
      duration: 0.16,
      scale: 0.9,
      ease: "power2.inOut",
    },
    "+=0.04",
  );

  tl.call(
    () => {
      cursor.src = grabbing;
    },
    [],
    "-=0.05",
  );

  tl.to(motion, {
    duration: 0.84,
    width: () => (box(motion).h * 9) / 16,
    ease: "power4.inOut",
    onUpdate: () => {
      let r = box(motion);
      gsap.set(cursor, {
        x: r.x - cursor.offsetWidth / 2,
        y: r.y + r.h / 2 - cursor.offsetHeight / 2,
      });
    },
  });

  tl.to(cursor, {
    duration: 0.48,
    ease: "power2.inOut",
    x: () => {
      let r = box(trigger);
      return r.x + r.w / 2 - cursor.offsetWidth / 2 + 12;
    },
    y: () => {
      let r = box(trigger);
      return r.y + r.h / 2 - cursor.offsetHeight / 2 + 12;
    },
    onUpdate: () => {
      let a = box(cursor);
      let m = box(motion);

      let e = {
        x: m.x,
        y: m.y,
        w: Math.min(16, m.w),
        h: m.h,
      };

      if (!aabb(a, e)) {
        cursor.src = pointer;
        gsap.set(cursor, { scale: 1 });
      }

      let b = box(trigger);

      if (aabb(a, b)) {
        trigger.classList.add("bg-gray-100", "dark:bg-gray-700");
      }
    },
  });

  tl.to(
    cursor,
    {
      duration: 0.16,
      scale: 0.8,
      ease: "power2.inOut",
      yoyo: true,
      repeat: 1,
    },
    "+=0.1",
  );

  tl.set(elements, {
    scale: 0.9,
    opacity: 0,
    transformOrigin: "top center",
  });

  tl.to(elements, {
    duration: 0.22,
    scale: 1,
    opacity: 1,
  });

  tl.to(cursor, {
    duration: 0.46,
    ease: "power2.inOut",
    x: () => {
      let r = box(edit);
      return r.x + r.w / 2 - cursor.offsetWidth / 2;
    },
    y: () => {
      let r = box(edit);
      return r.y + r.h / 2 - cursor.offsetHeight / 2;
    },
  });

  tl.to(starters, {
    duration: 0.68,
    ease: "power2.inOut",
    scrollTop: () => {
      let c = box(cursor);
      let e = box(editor);
      let editorY = e.y + e.h / 2;
      let cursorY = c.y + c.h / 2;
      return starters.scrollTop + (editorY - cursorY);
    },
  });

  tl.to(cursor, {
    duration: 0.3,
    ease: "power2.inOut",
    x: () => {
      let r = box(editor);
      return r.x + r.w / 2 - cursor.offsetWidth / 2;
    },
    y: () => {
      let r = box(editor);
      return r.y + r.h / 2 - cursor.offsetHeight / 2;
    },
  });

  window.addEventListener("resize", () => {
    let p = tl.progress();
    tl.progress(0).invalidate();
    tl.progress(p);
  });
</script>
