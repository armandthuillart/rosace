---
import cursorImage from "@assets/images/cursor.svg?url";
import pixelsImage from "@assets/images/pixels.svg?url";
import grabImage from "@assets/images/grab.svg?url";
import grabbingImage from "@assets/images/grabbing.svg?url";
---

<div class="h-150 w-full relative" data-animate="composition">
  <div
    class="z-10 absolute top-0 left-0 p-2 inline-flex gap-2 rounded-xl bg-white dark:bg-gray-800 shadow-panel"
  >
    <div
      class="bg-blue-400 dark:bg-blue-500 text-white size-8 shrink-0 rounded-sm flex items-center justify-center"
    >
      <svg
        aria-hidden="true"
        class="size-5 translate-x-px"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <use href="/sprite.svg#cursor"></use>
      </svg>
    </div>

    <div class="size-8 shrink-0 rounded-md flex items-center justify-center">
      <svg
        aria-hidden="true"
        class="size-5"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <use href="/sprite.svg#hold"></use>
      </svg>
    </div>

    <div class="-my-2 w-px bg-gray-200 dark:bg-gray-600"></div>

    <div
      class="size-8 shrink-0 rounded-md flex items-center justify-center"
      data-part="starters-trigger"
    >
      <svg
        aria-hidden="true"
        class="size-5"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <use href="/sprite.svg#menu"></use>
      </svg>
    </div>
  </div>

  <div
    class="z-10 inline-flex gap-2 absolute top-0 right-0 p-2 rounded-xl bg-white dark:bg-gray-800 shadow-panel"
  >
    <div
      class="size-8 shrink-0 rounded-md flex items-center justify-center"
      data-part="sliders-trigger"
    >
      <svg
        aria-hidden="true"
        class="size-5"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <use href="/sprite.svg#sliders"></use>
      </svg>
    </div>

    <div class="-my-2 w-px bg-gray-200 dark:bg-gray-600"></div>

    <div
      class="bg-blue-400 dark:bg-blue-500 text-white pr-3 pl-2.5 text-sm h-8 shrink-0 rounded-sm gap-1.5 inline-flex items-center justify-center"
    >
      <svg
        aria-hidden="true"
        class="size-4"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <use href="/sprite.svg#download"></use>
      </svg>
      Export
    </div>
  </div>

  <div
    class="z-10 overflow-hidden p-2 pb-0 flex flex-col opacity-0 absolute right-0 shadow-panel rounded-[.875rem] gap-2 top-14 w-3xs bottom-20 bg-white dark:bg-gray-800"
    data-part="sliders-popover"
  >
  
  </div>

  <div
    class="aspect-square left-1/2 -translate-x-1/2 absolute shadow-panel -translate-y-1/2 top-[calc(50%-1rem)] outline-0 outline-blue-400 dark:outline-blue-500 h-[calc(100%-12rem)] sm:h-[calc(100%-8rem)] sm:top-6 sm:translate-y-0 bg-white dark:bg-gray-800"
    data-part="video-preview"
  >
    <div
      class="overflow-hidden absolute inset-0 pointer-events-none grid grid-cols-5"
      data-part="checkerboard"
    >
      {
        Array.from({ length: 50 }, (_, i) => (
          <div
            class:list={[
              "w-full aspect-square",
              { "bg-gray-50 dark:bg-gray-700": i % 2 === 0 },
              { "bg-white dark:bg-gray-800": i % 2 !== 0 },
            ]}
          />
        ))
      }
    </div>

    <div
      class="absolute opacity-0 inset-0 flex items-center justify-center"
      data-part="code-block-trigger"
    >
      <div
        class="px-2 text-[.6875rem]/6 text-white bg-blue-400 dark:bg-blue-500 rounded-sm before:z-20"
      >
        Paste code
      </div>
    </div>

    <div
      class="opacity-0 overflow-hidden bg-[#f9f9f9] dark:bg-[#222] absolute flex items-center justify-center inset-0 p-8"
      data-part="code-block"
    >
      <img
        src={pixelsImage}
        class="z-0 not-dark:opacity-20 h-32 w-[calc(100%+4rem)] pointer-events-none -left-8 bottom-0 absolute mask-radial-farthest-side mask-radial-at-[50%_100%] mask-radial-from-black mask-radial-to-transparent"
      />

      <div
        class="z-10 font-mono [grid-template:auto/1fr] w-full min-h-0 grid bg-[#f8f8f8] dark:bg-[#111] rounded-lg p-0.75 relative shadow-block"
      >
        <div
          class="overflow-hidden p-4 pl-12 [counter-increment:step_0] [counter-reset:step] text-[.75rem]/[1.35] sm:text-[.9375rem]/normal tracking-[.000625em] size-full bg-white dark:bg-[#191919] rounded-[.3125rem] shadow-code [tab-size:2] [grid-area:1/1/2/2]"
        >
          <pre
            class="whitespace-normal">
            <code class="text-[1em] leading-6 text-[#131316]">
              <span class="block w-[calc(100%+1rem+3.5rem)] pl-14 pr-4 -mr-4 -ml-14 before:w-1 before:text-[#484848] dark:before:text-[#c9c9c9] before:left-1.5 before:relative before:inline-block before:-ml-10 before:mr-6 before:text-right before:content-[attr(data-line)]" data-line="1"><span class="text-[#6c47ff] dark:text-[#BAB1FF]">import</span><span class="text-[#131316] dark:text-white"> &#123; Fun &#125; </span><span class="text-[#6c47ff] dark:text-[#BAB1FF]">from</span><span class="text-[#06AEE3] dark:text-[#5DE3FF]"> &quot;rosace&quot;</span><span class="text-[#131316] dark:text-white">;</span></span>
              <span class="block w-[calc(100%+1rem+3.5rem)] pl-14 pr-4 -mr-4 -ml-14 before:w-1 before:text-[#484848] dark:before:text-[#c9c9c9] before:left-1.5 before:relative before:inline-block before:-ml-10 before:mr-6 before:text-right before:content-[attr(data-line)]" data-line="2" />
              <span class="block w-[calc(100%+1rem+3.5rem)] pl-14 pr-4 -mr-4 -ml-14 before:w-1 before:text-[#484848] dark:before:text-[#c9c9c9] before:left-1.5 before:relative before:inline-block before:-ml-10 before:mr-6 before:text-right before:content-[attr(data-line)]" data-line="3"><span class="text-[#6c47ff] dark:text-[#BAB1FF]">export</span><span class="text-[#6c47ff] dark:text-[#BAB1FF]"> function</span><span class="text-[#6c47ff] dark:text-[#BAB1FF]"> Video</span><span class="text-[#131316] dark:text-white">() &#123;</span></span>
              <span class="block w-[calc(100%+1rem+3.5rem)] pl-14 pr-4 -mr-4 -ml-14 before:w-1 before:text-[#484848] dark:before:text-[#c9c9c9] before:left-1.5 before:relative before:inline-block before:-ml-10 before:mr-6 before:text-right before:content-[attr(data-line)]" data-line="4"><span class="max-[499px]:inline min-[500px]:hidden text-[#6c47ff] dark:text-[#BAB1FF]">&nbsp;&nbsp;return</span><span class="max-[499px]:inline min-[500px]:hidden text-[#131316] dark:text-white"> (</span><span class="max-[499px]:hidden min-[500px]:inline text-[#6c47ff] dark:text-[#BAB1FF]">&nbsp;&nbsp;return</span><span class="max-[499px]:hidden min-[500px]:inline text-[#131316] dark:text-white"> &lt;</span><span class="max-[499px]:hidden min-[500px]:inline text-[#22C542] dark:text-[#85EF9B]">Fun</span><span class="max-[499px]:hidden min-[500px]:inline text-[#6c47ff] dark:text-[#BAB1FF]"> animate</span><span class="max-[499px]:hidden min-[500px]:inline text-[#6c47ff] dark:text-[#BAB1FF]">=</span><span class="max-[499px]:hidden min-[500px]:inline text-[#131316] dark:text-white">&#123;</span><span class="max-[499px]:hidden min-[500px]:inline text-[#22C542] dark:text-[#85EF9B]">true</span><span class="max-[499px]:hidden min-[500px]:inline text-[#131316] dark:text-white">&#125;</span><span class="max-[499px]:hidden min-[500px]:inline text-[#131316] dark:text-white"> /&gt;</span></span>
              <span class="block max-[499px]:block min-[500px]:hidden w-[calc(100%+1rem+3.5rem)] pl-14 pr-4 -mr-4 -ml-14 before:w-1 before:text-[#484848] dark:before:text-[#c9c9c9] before:left-1.5 before:relative before:inline-block before:-ml-10 before:mr-6 before:text-right before:content-[attr(data-line)]" data-line="5"><span class="text-[#131316] dark:text-white">&nbsp;&nbsp;&nbsp;&nbsp;&lt;</span><span class="text-[#22C542] dark:text-[#85EF9B]">Fun</span></span>
              <span class="block max-[499px]:block min-[500px]:hidden w-[calc(100%+1rem+3.5rem)] pl-14 pr-4 -mr-4 -ml-14 before:w-1 before:text-[#484848] dark:before:text-[#c9c9c9] before:left-1.5 before:relative before:inline-block before:-ml-10 before:mr-6 before:text-right before:content-[attr(data-line)]" data-line="6"><span class="text-[#6c47ff] dark:text-[#BAB1FF]">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;animate</span><span class="text-[#6c47ff] dark:text-[#BAB1FF]">=</span><span class="text-[#131316] dark:text-white">&#123;</span><span class="text-[#22C542] dark:text-[#85EF9B]">true</span><span class="text-[#131316] dark:text-white">&#125;</span></span>
              <span class="block max-[499px]:block min-[500px]:hidden w-[calc(100%+1rem+3.5rem)] pl-14 pr-4 -mr-4 -ml-14 before:w-1 before:text-[#484848] dark:before:text-[#c9c9c9] before:left-1.5 before:relative before:inline-block before:-ml-10 before:mr-6 before:text-right before:content-[attr(data-line)]" data-line="7"><span class="text-[#131316] dark:text-white">&nbsp;&nbsp;&nbsp;&nbsp;/&gt;</span></span>
              <span class="block max-[499px]:block min-[500px]:hidden w-[calc(100%+1rem+3.5rem)] pl-14 pr-4 -mr-4 -ml-14 before:w-1 before:text-[#484848] dark:before:text-[#c9c9c9] before:left-1.5 before:relative before:inline-block before:-ml-10 before:mr-6 before:text-right before:content-[attr(data-line)]" data-line="8"><span class="text-[#131316] dark:text-white">&nbsp;&nbsp;)</span></span>
              <span class="block w-[calc(100%+1rem+3.5rem)] pl-14 pr-4 -mr-4 -ml-14 before:w-1 before:text-[#484848] dark:before:text-[#c9c9c9] before:left-1.5 before:relative before:inline-block before:-ml-10 before:mr-6 before:text-right before:content-[attr(data-line)]" data-line="9"><span class="max-[499px]:hidden min-[500px]:inline text-[#131316] dark:text-white">;</span><span class="text-[#131316] dark:text-white">&#125;</span></span>
            </code>
          </pre>
        </div>
      </div>
    </div>

    <div
      class="opacity-0 absolute -top-1 -left-1.25 size-2 bg-white dark:bg-gray-900 outline-2 outline-blue-400 dark:outline-blue-500"
      data-part="handles"
    >
    </div>

    <div
      class="opacity-0 absolute -top-1 -right-1.25 size-2 bg-white dark:bg-gray-900 outline-2 outline-blue-400 dark:outline-blue-500"
      data-part="handles"
    >
    </div>

    <div
      class="opacity-0 absolute -bottom-1 -left-1.25 size-2 bg-white dark:bg-gray-900 outline-2 outline-blue-400 dark:outline-blue-500"
      data-part="handles"
    >
    </div>

    <div
      class="opacity-0 absolute -bottom-1 -right-1.25 size-2 bg-white dark:bg-gray-900 outline-2 outline-blue-400 dark:outline-blue-500"
      data-part="handles"
    >
    </div>
  </div>

  <div
    class="absolute overflow-hidden h-18 bottom-0 left-1/2 rounded-[.875rem] bg-white dark:bg-gray-800 shadow-timeline -translate-x-1/2 w-full max-w-xl inline-flex before:absolute before:left-0 before:h-full before:w-15 before:bg-linear-to-r before:z-1 before:from-white before:to-transparent dark:before:from-gray-800 before:from-10%"
    data-part="timeline"
  >
    <div
      class="z-20 absolute inset-y-1 rounded-full w-0.5 bg-red-400 dark:bg-red-500 left-0 -translate-x-0.5"
      data-part="playhead"
    >
    </div>

    <div
      class="inset-2 right-auto rounded-md bg-white dark:bg-gray-800 px-2 flex items-center justify-center absolute z-30 shadow-timeline text-gray-400"
      data-part="controls"
    >
      <svg
        aria-hidden="true"
        class="size-3.5"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <use href="/sprite.svg#play"></use>
      </svg>

      <svg
        aria-hidden="true"
        class="size-3.5"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <use href="/sprite.svg#pause"></use>
      </svg>
    </div>

    <div class="flex shrink-0" data-part="track">
      {
        Array.from({ length: 5 }, (_, index) => (
          <div class="flex flex-col h-full w-48 border-r border-gray-200 dark:border-gray-600">
            <div class="h-6 pl-1.5 pt-1.25 text-xs text-gray-400 dark:text-gray-500">
              {index}s
            </div>

            <div class="relative h-6 bg-gray-50 border-y border-gray-150 dark:border-gray-600 dark:bg-gray-700">
              {/* {markers?.length ? (
                <div
                  class="size-6.25 p-0.75 border border-gray-150 dark:border-gray-600 bg-white dark:bg-gray-800 rounded-full absolute top-1/2 -translate-y-1/2"
                  style={`left: ${toLeft(markers[index % markers.length])}`}
                >
                  <div class="size-full bg-blue-400 dark:bg-blue-500 rounded-full" />
                </div>
              ) : null} */}
            </div>
          </div>
        ))
      }

      <div
        class="relative flex flex-col h-full w-0 shrink-0 overflow-visible border-r border-gray-200 dark:border-gray-600"
      >
        <div
          class="absolute right-1.5 h-6 pt-1.25 text-xs text-gray-400 dark:text-gray-500 whitespace-nowrap"
        >
          5s
        </div>

        <div
          class="relative h-6 w-0 border-y border-gray-150 dark:border-gray-600"
        >
        </div>
      </div>
    </div>
  </div>

  <img
    src={cursorImage}
    alt="Cursor"
    class="origin-center absolute top-0 left-0 size-12 z-30 opacity-0"
    data-part="cursor"
    data-cursor-grab={grabImage}
    data-cursor-grabbing={grabbingImage}
  />

  <div
    class="overflow-hidden p-2 pb-0 flex flex-col absolute left-0 shadow-panel origin-[top_center] opacity-0 rounded-[.875rem] gap-2 top-14 w-3xs bottom-20 bg-white dark:bg-gray-800"
    data-part="starters-popover"
  >
    <div
      class="items-center text-[.8125rem] text-gray-500/70 dark:text-gray-400/70 rounded-md h-8 w-full bg-gray-100 dark:bg-gray-700 inline-flex"
    >
      <div class="size-8 flex items-center justify-center">
        <svg
          aria-hidden="true"
          class="size-4"
          fill="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <use href="/sprite.svg#search"></use>
        </svg>
      </div>
      Search...
    </div>

    <div class="inline-flex gap-1">
      <div
        class="text-[.6875rem]/6 font-semibold px-2 rounded-sm bg-gray-100 dark:bg-gray-700"
      >
        All
      </div>

      <div
        class="text-[.6875rem]/6 font-medium text-gray-500 dark:text-gray-400 px-2 rounded-sm"
      >
        Assets
      </div>
    </div>

    <div
      class="overflow-y-scroll [scrollbar-width:none] flex-1 flex flex-col gap-2"
      data-part="starters-scrollport"
    >
      <div
        class="flex gap-2 flex-col p-3 bg-gray-100 dark:bg-gray-700 rounded-md"
        data-part="beat-sync"
      >
        <div class="flex flex-col">
          <div class="text-[.8125rem]/5">Edit</div>
          <div class="text-[.6875rem]/4 text-gray-500 dark:text-gray-400">
            Drop a track and watch your animation snap to the beat on its own.
          </div>
        </div>

        <div class="flex gap-3 h-34"></div>
      </div>

      <div
        class="flex gap-4 flex-col p-3 bg-gray-100 dark:bg-gray-700 rounded-md"
      >
        <div class="flex flex-col">
          <div class="text-[.8125rem]/5">Code</div>
          <div class="text-[.6875rem]/4 text-gray-500 dark:text-gray-400">
            Pick a theme and let your code type itself out. Diffs, highlights,
            and more.
          </div>
        </div>

        <div class="flex flex-col gap-2 items-center">
          <div
            class="relative pt-1.5 font-mono text-[.6875rem]/4 text-gray-500 dark:text-gray-400 grid grid-cols-[1.25rem_1fr] bg-white dark:bg-gray-800 grid-rows-[repeat(4,1rem)] w-38 h-20 border border-gray-200 dark:border-gray-600 rounded-md"
          >
            <div
              class="opacity-0 z-30 before:rounded-md absolute inset-0 flex items-center justify-center before:absolute before:inset-0 before:bg-white/90 dark:before:bg-gray-800/90 before:-z-10"
              data-part="code-block-overlay"
            >
              <div
                class="px-2 text-[.6875rem]/6 text-white bg-blue-400 dark:bg-blue-500 rounded-sm before:z-20"
              >
                Add template
              </div>
            </div>

            <div
              class="absolute left-5 inset-y-0 w-px bg-gray-200 dark:bg-gray-600"
            >
            </div>

            <div
              class="flex items-center justify-end border-r border-transparent pr-0.75"
            >
              1
            </div>

            <div class="pl-1.5 inline-flex items-center">
              <span class="text-[#B3013F] dark:text-[#83D2CD]">function</span>
              <span>&nbsp;</span>
              <span class="text-[#DB704B] dark:text-[#EFB080]">map</span>
              <span class="text-[#05517F] dark:text-[#FFD700]">()</span>
              <span>&nbsp;</span>
              <span class="text-[#3D7CAB] dark:text-[#D970D6]">{"{"}</span>
            </div>

            <div
              class="flex items-center justify-end border-r border-transparent pr-0.75"
            >
              2
            </div>

            <div
              class="pl-1.5 flex items-center text-[#5E5E5E] dark:text-[#636363]"
            >
              &nbsp;&nbsp;
              <span class="text-[#216595] dark:text-[#D6D6DD]">console</span>
              <span class="text-[#262626] dark:text-[#D4D4D4]">.</span>
              <span class="text-[#DB704B] dark:text-[#EFB080]">log</span>
              <span class="text-[#05517F] dark:text-[#FFD700]">{"("}</span>
              <span class="text-[#5E5E5E] dark:text-[#636363]">...</span>
              <span class="text-[#05517F] dark:text-[#FFD700]">{")"}</span>
            </div>

            <div
              class="flex items-center justify-end border-r border-transparent pr-0.75"
            >
              3
            </div>

            <div
              class="pl-1.5 flex items-center text-[#B3013F] dark:text-[#83D2CD]"
            >
              &nbsp;&nbsp;{"return"}
            </div>

            <div
              class="flex items-center justify-end border-r border-transparent pr-0.75"
            >
              4
            </div>

            <div
              class="pl-1.5 flex items-center text-[#3D7CAB] dark:text-[#D970D6]"
            >
              {"}"}
            </div>
          </div>

          <div
            class="flex items-center text-[.6875rem]/4 text-gray-500 font-medium dark:text-gray-400"
          >
            Code editor
          </div>
        </div>
      </div>

      <div
        class="flex gap-2 flex-col p-3 bg-gray-100 dark:bg-gray-700 rounded-md"
      >
        <div class="flex flex-col">
          <div class="text-[.8125rem]/5">Mockup</div>
          <div class="text-[.6875rem]/4 text-gray-500 dark:text-gray-400">
            Animate inside a phone, browser, or tablet frame in seconds.
          </div>
        </div>

        <div class="flex gap-3 h-34"></div>
      </div>
    </div>
  </div>
</div>

<script>
  import gsap from "gsap";

  let root = document.querySelector<HTMLElement>(
    '[data-animate="composition"]',
  )!;
  let cursor = document.querySelector<HTMLImageElement>(
    '[data-part="cursor"]',
  )!;
  let handles = gsap.utils.toArray<HTMLElement>('[data-part="handles"]')!;
  let beatSync = document.querySelector<HTMLElement>(
    '[data-part="beat-sync"]',
  )!;
  let codeBlock = document.querySelector<HTMLElement>(
    '[data-part="code-block"]',
  )!;
  let videoPreview = document.querySelector<HTMLElement>(
    '[data-part="video-preview"]',
  )!;
  let slidersTrigger = document.querySelector<HTMLElement>(
    '[data-part="sliders-trigger"]',
  )!;
  let slidersPopover = document.querySelector<HTMLElement>(
    '[data-part="sliders-popover"]',
  )!;
  let startersPopover = document.querySelector<HTMLElement>(
    '[data-part="starters-popover"]',
  )!;
  let startersTrigger = document.querySelector<HTMLElement>(
    '[data-part="starters-trigger"]',
  )!;
  let codeBlockTrigger = document.querySelector<HTMLElement>(
    '[data-part="code-block-trigger"]',
  )!;
  let codeBlockOverlay = document.querySelector<HTMLElement>(
    '[data-part="code-block-overlay"]',
  )!;
  let startersScrollport = document.querySelector<HTMLElement>(
    '[data-part="starters-scrollport"]',
  )!;

  let open = false;
  let grab = cursor.dataset.cursorGrab!;
  let pointer = cursor.src;
  let grabbing = cursor.dataset.cursorGrabbing!;

  let box = (el: HTMLElement) => {
    let r = el.getBoundingClientRect();
    let b = root.getBoundingClientRect();
    return {
      x: r.left - b.left,
      y: r.top - b.top,
      w: r.width,
      h: r.height,
    };
  };

  let aabb = (
    a: { x: number; y: number; w: number; h: number },
    b: { x: number; y: number; w: number; h: number },
  ) =>
    a.x + a.w >= b.x &&
    a.x <= b.x + b.w &&
    a.y + a.h >= b.y &&
    a.y <= b.y + b.h;

  let centerOf = (el: HTMLElement, offsetX = 0, offsetY = 0) => {
    let r = box(el);
    return {
      x: r.x + r.w / 2 - cursor.offsetWidth / 2 + offsetX,
      y: r.y + r.h / 2 - cursor.offsetHeight / 2 + offsetY,
    };
  };

  let ow = gsap.quickTo(videoPreview, "outlineWidth", {
    duration: 0.1,
    ease: "power2.out",
  });

  let tl = gsap.timeline({
    defaults: { duration: 0.15, ease: "power2.inOut" },
  });

  tl.set(videoPreview, {
    width: () => Math.min((box(videoPreview).h * 9) / 16, box(root).w - 24),
    outlineWidth: 0,
  });

  tl.set(handles, {
    scale: 0,
    opacity: 0,
  });

  tl.set(cursor, {
    x: () => box(root).w * 0.7,
    y: () => box(root).h * 0.7,
    opacity: 0,
  });

  // 1. Move cursor to the center of the video preview.
  tl.to(cursor, {
    duration: 0.5,
    x: () => centerOf(videoPreview).x,
    y: () => centerOf(videoPreview).y,
    opacity: 1,
    onUpdate: () => {
      let a = box(cursor);
      let b = box(videoPreview);

      if (aabb(a, b)) {
        ow(2);
      }
    },
  });

  // 2. Make a click gesture.
  tl.to(cursor, { scale: 0.8, yoyo: true, repeat: 1 }, "+=0.1");

  // 3. Selects the video preview.
  tl.to(handles, { scale: 1, opacity: 1 }, "-=0.4");

  // 4. Move the cursor to the center of the left edge of the video preview.
  tl.to(cursor, {
    duration: 0.5,
    x: () => box(videoPreview).x - cursor.offsetWidth / 2,
    y: () => centerOf(videoPreview).y,
  });

  // 5. Change the cursor to the grab cursor.
  tl.call(
    () => {
      cursor.src = grab;
    },
    [],
    "-=0.1",
  );

  // 6. Makes a press gesture.
  tl.to(cursor, { scale: 0.9 }, "+=0.1");

  // 7. Change the cursor to the grabbing cursor.
  tl.call(
    () => {
      cursor.src = grabbing;
    },
    [],
    "-=0.1",
  );

  // 8. Resize the video preview from 9:16 to 1:1 aspect ratio.
  tl.to(videoPreview, {
    duration: 0.5,
    width: () => Math.min(box(videoPreview).h, box(root).w - 24),
    onUpdate: () => {
      let r = box(videoPreview);
      gsap.set(cursor, {
        x: r.x - cursor.offsetWidth / 2,
        y: r.y + r.h / 2 - cursor.offsetHeight / 2,
      });
    },
  });

  // 9. Move the cursor to the center of the starters trigger.
  tl.to(cursor, {
    duration: 0.5,
    x: () => centerOf(startersTrigger, 12, 12).x,
    y: () => centerOf(startersTrigger, 12, 12).y,
    onUpdate: () => {
      let c = box(cursor);
      let m = box(videoPreview);

      let e = {
        x: m.x,
        y: m.y,
        w: Math.min(16, m.w),
        h: m.h,
      };

      if (!aabb(c, e)) {
        cursor.src = pointer;
        gsap.set(cursor, { scale: 1 });
      }

      gsap.set(codeBlockOverlay, {
        opacity: aabb(c, box(codeBlockOverlay)) ? 1 : 0,
      });

      let b = box(startersTrigger);

      startersTrigger.classList.remove(
        "bg-gray-50",
        "bg-gray-100",
        "dark:bg-gray-700",
      );

      if (aabb(c, b)) {
        startersTrigger.classList.add("bg-gray-100", "dark:bg-gray-700");
      } else if (open) {
        startersTrigger.classList.add("bg-gray-50", "dark:bg-gray-700");
      }
    },
  });

  // 10. Makes a click gesture.
  tl.to(cursor, { scale: 0.8, yoyo: true, repeat: 1 }, "+=0.1");

  // 11. Opens the starters popover.
  tl.set(startersPopover, { scale: 0.9, opacity: 0 });

  tl.call(() => {
    open = true;
  });

  tl.to(startersPopover, { scale: 1, opacity: 1, duration: 0.2 });

  // 12. Move the cursor to the center of the beat sync.
  tl.to(cursor, {
    duration: 0.5,
    x: () => centerOf(beatSync).x,
    y: () => centerOf(beatSync).y,
    onUpdate: () => {
      gsap.set(codeBlockOverlay, {
        opacity: aabb(box(cursor), box(codeBlockOverlay)) ? 1 : 0,
      });

      startersTrigger.classList.remove(
        "bg-gray-50",
        "bg-gray-100",
        "dark:bg-gray-700",
      );

      if (aabb(box(cursor), box(startersTrigger))) {
        startersTrigger.classList.add("bg-gray-100", "dark:bg-gray-700");
      } else if (open) {
        startersTrigger.classList.add("bg-gray-50", "dark:bg-gray-700");
      }
    },
  });

  // 13. Scroll the starters scrollport to land on the center of the code block overlay.
  tl.to(startersScrollport, {
    duration: 0.7,
    scrollTop: () => {
      let c = box(cursor);
      let t = box(codeBlockOverlay);
      let cursorY = c.y + c.h / 2;
      let templateY = t.y + t.h / 2;
      return startersScrollport.scrollTop + (templateY - cursorY) + 6;
    },
    onUpdate: () => {
      gsap.set(codeBlockOverlay, {
        opacity: aabb(box(cursor), box(codeBlockOverlay)) ? 1 : 0,
      });
    },
  });

  // 14. Move the cursor in-sync with the scrollport.
  tl.to(cursor, {
    x: () => centerOf(codeBlockOverlay).x,
    y: () => centerOf(codeBlockOverlay, 0, 6).y,
    onUpdate: () => {
      gsap.set(codeBlockOverlay, {
        opacity: aabb(box(cursor), box(codeBlockOverlay)) ? 1 : 0,
      });
    },
  });

  // 15. Makes a click gesture.
  tl.to(cursor, { scale: 0.8, yoyo: true, repeat: 1 }, "-=0.1");

  // 16. Closes the starters popover.
  tl.to(startersPopover, { scale: 0.9, opacity: 0, duration: 0.2 });

  tl.call(() => {
    open = false;
    startersTrigger.classList.remove("bg-gray-50", "dark:bg-gray-700");
  });

  tl.set(codeBlockTrigger, { opacity: 0 });

  // 17. Shows the code block paste prompt.
  tl.to(codeBlockTrigger, { opacity: 1 }, "+=0.1");

  // 18. Move the cursor to the center of the prompt.
  tl.to(
    cursor,
    {
      duration: 0.5,
      x: () => centerOf(codeBlockTrigger, 12, 12).x,
      y: () => centerOf(codeBlockTrigger, 12, 12).y,
      onUpdate: () => {
        gsap.set(codeBlockOverlay, {
          opacity: aabb(box(cursor), box(codeBlockOverlay)) ? 1 : 0,
        });
      },
    },
    "-=0.25",
  );

  // 19. Makes a click gesture.
  tl.to(cursor, { scale: 0.8, yoyo: true, repeat: 1 });

  // 20. Hides the prompt.
  tl.to(codeBlockTrigger, { opacity: 0 }, "-=0.1");

  // 21. Shows the code block.
  tl.to(codeBlock, { opacity: 1, duration: 0.2 }, "-=0.1");

  // 22. Move the cursor to the center of the sliders trigger.
  tl.to(
    cursor,
    {
      duration: 0.7,
      x: () => centerOf(slidersTrigger, 12, 12).x,
      y: () => centerOf(slidersTrigger, 12, 12).y,
      onUpdate: () => {
        gsap.set(codeBlockOverlay, {
          opacity: aabb(box(cursor), box(codeBlockOverlay)) ? 1 : 0,
        });

        slidersTrigger.classList.remove("bg-gray-100", "dark:bg-gray-700");

        if (aabb(box(cursor), box(slidersTrigger))) {
          slidersTrigger.classList.add("bg-gray-100", "dark:bg-gray-700");
        }
      },
    },
    "<",
  );

  // 23. Makes a click gesture.
  tl.to(cursor, { scale: 0.8, yoyo: true, repeat: 1 }, "-=0.1");

  tl.set(slidersPopover, { scale: 0.9, opacity: 0 });

  // 24. Opens the sliders popover.
  tl.to(slidersPopover, { scale: 1, opacity: 1, duration: 0.2 });

  window.addEventListener("resize", () => {
    let p = tl.progress();
    tl.progress(0).invalidate();
    tl.progress(p);
  });
</script>
