---
import { DASHBOARD_URL } from "astro:env/client";
import Icon from "@components/Icon.astro";
---

<section
  class="mx-auto mb-14 flex w-full flex-col items-center justify-center sm:mb-20 xl:w-4/5 xl:max-w-5xl"
>
  <h1
    class="relative mb-14 text-center text-5xl leading-[1.05] font-bold tracking-tight delay-50 sm:mb-12 sm:text-8xl sm:leading-none"
  >
    Simplest way to<br />create animations.
  </h1>

  <p class="sr-only">
    Motion design for people who never learned it. Free, browser-based, no
    install required.
  </p>

  <a
    aria-label="Start animating"
    class="group relative inline-flex min-h-15 items-center justify-center gap-2 rounded-2xl bg-gray-900 py-4 pr-5 pl-13 text-center text-lg font-bold text-gray-200 shadow-gray-200 transition duration-300 not-dark:shadow-2xl before:absolute focus-visible:outline-2 dark:bg-gray-200 dark:text-gray-800"
    href={DASHBOARD_URL}
  >
    <Icon
      class="ease absolute left-5 size-6 translate-x-0 opacity-100 transition duration-300 will-change-transform group-hover:-translate-x-full group-hover:scale-x-50 group-hover:opacity-0 group-hover:blur-sm"
      name="arrow-right"
    />

    <span
      class="ease translate-x-0 transition duration-300 group-hover:-translate-x-8"
      >Start animating</span
    >

    <Icon
      class="ease absolute right-5 size-6 translate-x-full scale-x-50 opacity-0 blur-sm transition duration-300 will-change-transform group-hover:translate-x-0 group-hover:scale-x-100 group-hover:opacity-100 group-hover:blur-none"
      name="arrow-right"
    />
  </a>

  <div
    class="mt-6 flex flex-col items-center justify-center gap-0.5 text-center"
  >
    <p class="text-sm font-bold text-gray-500 dark:text-gray-400">
      No credit card required
    </p>

    <div class="flex items-center justify-center gap-1">
      <Icon class="size-5" name="gift-card" />
      <p class="text-lg/tight font-bold">For free, forever</p>
    </div>
  </div>
</section>
