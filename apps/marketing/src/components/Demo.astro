---
import Icon from "@components/Icon.astro";
---

<section class="flex flex-col items-center gap-4 lg:px-8">
  <h2 class="sr-only">Demo</h2>

  <div
    class="relative flex h-155 w-full max-w-294 justify-between gap-6 overflow-hidden rounded-4xl bg-gray-300 p-5 sm:rounded-[2.5rem] dark:bg-gray-900"
    id="demo-container"
  >
    <div
      class="shadow-float xl:shadow-panel absolute left-5 z-50 flex h-145 w-3xs shrink-0 origin-left flex-col rounded-[1.25rem] bg-white max-sm:hidden xl:static xl:h-full dark:bg-gray-800"
      id="demo-left-panel"
    >
    </div>

    <div class="flex w-full justify-center">
      <div class="flex flex-col gap-3 max-sm:w-full">
        <div class="flex h-7 justify-between">
          <div
            class="flex items-center rounded-lg bg-gray-100 px-2.5 text-gray-500 dark:bg-gray-800 dark:text-gray-400"
          >
            <Icon class="size-4" name="plus-sign" />
          </div>

          <div class="flex gap-2">
            <div
              class="flex items-center gap-1.5 rounded-lg bg-gray-100 px-2 text-gray-500 dark:bg-gray-800 dark:text-gray-400"
            >
              <Icon class="size-4" name="rectangle" />
              <Icon class="size-4" name="checkerboard" />
              <Icon
                class="size-4 text-blue-400 dark:text-blue-500"
                name="two-columns"
              />
            </div>

            <div
              class="relative flex h-7 min-w-10.5 rounded-lg bg-gray-100 px-2 text-center text-[.8125rem]/7 text-gray-500 before:absolute before:inset-0 before:block before:content-[attr(data-content)] dark:bg-gray-800 dark:text-gray-400"
              data-content="9:16"
            >
            </div>
          </div>
        </div>

        <div class="flex h-114 gap-4 sm:w-132.5">
          <div
            class="aspect-9/16 shrink-0 overflow-hidden rounded-[.875rem] bg-[conic-gradient(var(--a)_25%,var(--b)_0_50%,var(--a)_0_75%,var(--b)_0)] bg-size-[1rem_1rem] bg-center [--a:var(--color-gray-200)] [--b:var(--color-gray-100)] max-sm:hidden dark:[--a:var(--color-gray-700)] dark:[--b:var(--color-gray-800)]"
          >
            <div class="" id="layout-camera"></div>
          </div>

          <div
            class="shadow-panel relative shrink-0 rounded-[.875rem] bg-white max-sm:size-full sm:aspect-9/16 dark:bg-gray-800"
          >
            <div class="absolute inset-0 perspective-[1000px]">
              <div class="relative size-full transform-3d" id="scene-camera">
                <div class="flex size-full flex-col"></div>
              </div>
            </div>
          </div>
        </div>

        <div
          class="shadow-track relative flex h-18 flex-col rounded-[.875rem] bg-white dark:bg-gray-800"
        >
          <div
            class="shadow-track absolute inset-2 right-auto flex w-10 items-center justify-center -space-x-1 rounded-md bg-white dark:bg-gray-800"
          >
            <div class="animate-shimmer relative flex -space-x-1">
              <Icon
                class="size-3.5 text-transparent"
                name="play"
                style="mask-image: url('/sprites.svg#play'); mask-mode: alpha;"
              />
              <Icon
                class="size-3.5 text-transparent"
                name="pause"
                style="mask-image: url('/sprites.svg#pause'); mask-mode: alpha;"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="shadow-float xl:shadow-panel absolute right-5 z-50 flex h-145 w-3xs shrink-0 origin-right flex-col rounded-[1.25rem] bg-white max-sm:hidden xl:static xl:h-full dark:bg-gray-800"
      id="demo-right-panel"
    >
    </div>
  </div>

  <div
    class="group inline-flex cursor-default gap-2 p-4 text-sm font-bold text-gray-400 max-sm:hidden dark:text-gray-500"
  >
    <Icon
      class="size-4 transition duration-700 group-hover:-translate-1.5"
      name="cursor"
    />

    <span
      class="relative h-5 min-w-37.75 whitespace-nowrap before:absolute before:inset-0 before:content-[attr(data-content)]"
      data-content="Psst... it’s interactive!"></span>
  </div>
</section>

<script>
  import waapi from "@motion/waapi";

  let mm = waapi.matchMedia();

  let sm = 640;
  let xl = 1280;

  mm.add(
    {
      desktop: `(min-width: ${xl}px)`,
      tablet: `(min-width: ${sm}px) and (max-width: ${xl - 1}px)`,
      mobile: `(max-width: ${sm - 1}px)`,
    },
    (context) => {
      let { tablet, dark } = context.conditions;

      let container = document.getElementById("demo-container")!;

      let leftPanel = document.getElementById("demo-left-panel")!;
      let rightPanel = document.getElementById("demo-right-panel")!;

      if (tablet) {
        const handleMouseEnter = () => {
          waapi.to(
            [leftPanel, rightPanel],
            {
              scale: 1,
              x: "0%",
            },
            {
              duration: 0.5,
              ease: "cubic-bezier(.32, .72, 0, 1)",
            },
          );
        };

        const handleMouseLeave = () => {
          waapi.to(
            leftPanel,
            {
              scale: tablet ? 0.85 : 1,
              x: tablet ? "-75%" : "0%",
            },
            {
              duration: 0.5,
              ease: "cubic-bezier(.32, .72, 0, 1)",
            },
          );
          waapi.to(
            rightPanel,
            {
              scale: tablet ? 0.85 : 1,
              x: tablet ? "75%" : "0%",
            },
            {
              duration: 0.5,
              ease: "cubic-bezier(.32, .72, 0, 1)",
            },
          );
        };

        container.addEventListener("mouseenter", handleMouseEnter);
        container.addEventListener("mouseleave", handleMouseLeave);

        return () => {
          container.removeEventListener("mouseenter", handleMouseEnter);
          container.removeEventListener("mouseleave", handleMouseLeave);
        };
      }

      return () => {};
    },
  );
</script>
