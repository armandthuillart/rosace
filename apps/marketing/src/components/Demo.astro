---
import Icon from "@components/Icon.astro";
---

<section class="flex flex-col items-center gap-4 lg:px-8" id="demo">
  <h2 class="sr-only">Demo</h2>

  <div
    class="relative flex h-155 w-full justify-between rounded-[2.5rem] bg-gray-300 p-5 dark:bg-gray-900"
  >
    <div
      class="shadow-panel flex h-full w-3xs shrink-0 flex-col rounded-[1.25rem] bg-white max-2xl:hidden dark:bg-gray-800"
    >
    </div>

    <div class="flex w-full justify-center">
      <div class="flex flex-col gap-3 max-sm:w-full max-sm:max-w-3xs">
        <div class="flex h-7 justify-between">
          <div
            class="flex items-center rounded-lg bg-gray-100 px-2.5 text-gray-500 dark:bg-gray-800 dark:text-gray-400"
          >
            <Icon
              aria-hidden="true"
              class="size-4"
              fill="currentColor"
              name="plus-sign"
            />
          </div>

          <div class="flex gap-2">
            <div
              class="flex items-center gap-1.5 rounded-lg bg-gray-100 px-2 text-gray-500 dark:bg-gray-800 dark:text-gray-400"
            >
              <Icon
                aria-hidden="true"
                class="size-4"
                fill="currentColor"
                name="rectangle"
              />

              <Icon
                aria-hidden="true"
                class="size-4"
                fill="currentColor"
                name="checkerboard"
              />

              <Icon
                aria-hidden="true"
                class="size-4 text-blue-400 dark:text-blue-500"
                fill="currentColor"
                name="two-columns"
              />
            </div>

            <div
              class="relative flex h-7 min-w-10.5 rounded-lg bg-gray-100 px-2 text-center text-[.8125rem]/7 text-gray-500 before:absolute before:inset-0 before:block before:content-[attr(data-content)] dark:bg-gray-800 dark:text-gray-400"
              data-content="9:16"
            >
            </div>
          </div>
        </div>

        <div class="flex h-114 gap-4 sm:w-132.5">
          <div
            class="aspect-9/16 shrink-0 overflow-hidden rounded-[.875rem] bg-[conic-gradient(var(--a)_25%,var(--b)_0_50%,var(--a)_0_75%,var(--b)_0)] bg-size-[1rem_1rem] bg-center [--a:var(--color-gray-200)] [--b:var(--color-gray-100)] max-sm:hidden dark:[--a:var(--color-gray-700)] dark:[--b:var(--color-gray-800)]"
          >
          </div>

          <div
            class="shadow-panel shrink-0 rounded-[.875rem] bg-white max-sm:size-full sm:aspect-9/16 dark:bg-gray-800"
          >
          </div>
        </div>

        <div
          class="shadow-timeline relative flex h-18 flex-col rounded-[.875rem] bg-white dark:bg-gray-800"
        >
          <div
            class="shadow-timeline absolute inset-2 right-auto z-30 flex w-10 items-center justify-center -space-x-1 rounded-md bg-white text-gray-400 dark:bg-gray-800 dark:text-gray-500"
          >
            <Icon
              aria-hidden="true"
              class="size-3.5"
              fill="currentColor"
              name="play"
            />

            <Icon
              aria-hidden="true"
              class="size-3.5"
              fill="currentColor"
              name="pause"
            />
          </div>
        </div>
      </div>
    </div>

    <div
      class="shadow-panel flex h-full w-3xs shrink-0 flex-col rounded-[1.25rem] bg-white max-2xl:hidden dark:bg-gray-800"
    >
    </div>
  </div>

  <div
    class="group inline-flex cursor-default gap-2 p-4 text-sm font-bold text-gray-400 max-sm:hidden dark:text-gray-500"
  >
    <Icon
      class="size-4 transition duration-700 group-hover:-translate-1.5"
      fill="currentColor"
      name="cursor"
    />

    <span
      class="relative h-5 min-w-37.75 whitespace-nowrap before:absolute before:inset-0 before:content-[attr(data-content)]"
      data-content="Psst... it’s interactive!"></span>
  </div>
</section>
