---
import Icon from "@components/Icon.astro";

import songCoverImage from "@images/song-cover.webp";
import vinylSleeveImage from "@images/vinyl-sleeve.webp";
import vinylRecordImage from "@images/vinyl-record.webp";
import vinylTextureImage from "@images/vinyl-texture.webp";

const cols = 8;
const rows = 8;

const filled = new Set([
  "0,2",
  "0,3",
  "0,4",
  "0,5",
  "1,1",
  "1,2",
  "1,3",
  "1,4",
  "1,5",
  "1,6",
  "2,0",
  "2,1",
  "2,2",
  "2,3",
  "2,4",
  "2,5",
  "2,6",
  "2,7",
  "3,0",
  "3,1",
  "3,2",
  "3,3",
  "3,4",
  "3,5",
  "3,6",
  "3,7",
  "4,0",
  "4,1",
  "4,2",
  "4,3",
  "4,4",
  "4,5",
  "4,6",
  "4,7",
  "5,0",
  "5,1",
  "5,2",
  "5,3",
  "5,4",
  "5,5",
  "5,6",
  "5,7",
  "6,1",
  "6,2",
  "6,3",
  "6,4",
  "6,5",
  "6,6",
  "7,2",
  "7,3",
  "7,4",
  "7,5",
]);
---

<section class="flex flex-col items-center gap-4 lg:px-8">
  <h2 class="sr-only">Demo</h2>

  <audio id="demo-audio" src="/song.ogg"></audio>

  <div
    class="group/box relative flex h-155 w-full max-w-294 justify-between gap-6 overflow-hidden rounded-4xl bg-gray-300 p-5 sm:rounded-[2.5rem] dark:bg-gray-900"
    id="demo-box"
  >
    <div
      class="shadow-float xl:shadow-panel absolute left-5 z-50 flex h-145 w-3xs shrink-0 origin-left flex-col rounded-[1.25rem] bg-white max-sm:hidden xl:static xl:h-full dark:bg-gray-800"
      id="demo-left-panel"
    >
      <div class="flex items-center justify-between p-3 pl-4">
        <span class="text-[0.8125rem]/6 font-[550]">Elements</span>

        <div class="flex size-6 items-center justify-center">
          <Icon class="size-4" name="more-horizontal" />
        </div>
      </div>

      <hr class="border-gray-200 dark:border-gray-700" />

      <div class="flex flex-col gap-2 px-4 py-3">
        <div
          class="flex h-6 w-full rounded-sm bg-gray-100 text-gray-500/70 dark:bg-gray-700 dark:text-gray-400/60"
        >
          <div class="flex size-6 items-center justify-center">
            <Icon class="size-3" name="search" />
          </div>

          <span
            class="text-[0.6875rem]/6 font-[450] text-transparent before:text-gray-500 before:content-[attr(data-content)] dark:before:text-gray-400"
            data-content="Search..."></span>
        </div>

        <div class="flex gap-1">
          <div
            class="px-2 text-[0.6875rem]/6 font-[450] text-gray-500 dark:text-gray-400"
          >
            Presets
          </div>

          <div
            class="rounded-sm bg-gray-100 px-2 text-[0.6875rem]/6 font-[550] dark:bg-gray-700"
          >
            Shapes
          </div>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-2 overflow-hidden px-4 pt-0 pb-4">
        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="circle" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="diamond" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="octagon" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="square" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-12.5" name="parallelogram" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="rectangle" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="hexagon" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="pentagon" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="seal" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="triangle" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="star" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="teardrop" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="sign" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="chat-bubble" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="navigation-arrow" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="share-fat" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="right-triangle" />
        </div>

        <div
          class="flex aspect-square items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-700"
        >
          <Icon class="size-11" name="two-bars" />
        </div>
      </div>
    </div>

    <div class="flex w-full justify-center">
      <div class="flex flex-col gap-4 max-sm:w-full sm:gap-3">
        <div class="flex h-10 items-center justify-between sm:h-7">
          <div
            class="flex h-7 items-center rounded-lg bg-gray-100 px-2.5 text-gray-500 dark:bg-gray-800 dark:text-gray-400"
          >
            <Icon class="size-4" name="plus-sign" />
          </div>

          <div
            class="shadow-panel mx-auto flex h-full w-48 items-center justify-between rounded-xl bg-gray-900 p-2 sm:hidden dark:bg-gray-800"
          >
            <a
              aria-label="iloveitiloveit by Bella Kay"
              class="size-6 rounded-sm bg-cover transition-opacity duration-200 hover:opacity-80"
              href="https://www.youtube.com/watch?v=OqTpNnSnwxQ"
              rel="noopener noreferrer"
              style={{ backgroundImage: `url(${songCoverImage.src})` }}
              target="_blank"
            >
            </a>

            <button
              aria-label="Play or pause timeline"
              class="group relative flex size-5 cursor-pointer items-center justify-center gap-0.5 brightness-150 not-group-data-playing/box:pointer-events-none before:absolute before:-inset-4"
              data-play-button
            >
              {
                [0.95, 1.45, 0.85, 1.25].map((scale) => (
                  <span
                    class="h-0.5 w-0.5 rounded-xs bg-linear-to-b from-gray-500 to-gray-400 transition-[filter] duration-200 group-hover:blur-xs dark:from-gray-400 dark:to-gray-500"
                    style={{ animationDuration: `${scale}s` }}
                  />
                ))
              }

              <Icon
                class="absolute top-1/2 left-1/2 size-4 -translate-1/2 text-gray-200 transition-opacity duration-200 not-group-hover:opacity-0"
                name="pause"
              >
                <use href="/sprites.svg#pause"></use>
              </Icon>
            </button>
          </div>

          <div class="flex sm:gap-2">
            <div
              class="hidden items-center gap-1.5 rounded-lg bg-gray-100 px-2 text-gray-500 sm:flex dark:bg-gray-800 dark:text-gray-400"
            >
              <Icon class="size-4" name="horizontal" />
              <Icon class="size-4" name="checkerboard" />
              <Icon
                class="size-4 text-blue-400 dark:text-blue-500"
                name="two-columns"
              />
            </div>

            <div
              class="relative flex h-7 min-w-10.5 rounded-lg bg-gray-100 px-2 text-center text-[.8125rem]/7 text-gray-500 before:absolute before:inset-0 before:block before:content-[attr(data-content)] dark:bg-gray-800 dark:text-gray-400"
              data-content="9:16"
            >
            </div>
          </div>
        </div>

        <div class="flex h-108 gap-4 sm:h-114 sm:w-132.5">
          <div
            class="aspect-9/16 shrink-0 overflow-hidden rounded-[.875rem] bg-[conic-gradient(var(--a)_25%,var(--b)_0_50%,var(--a)_0_75%,var(--b)_0)] bg-size-[1rem_1rem] bg-center [--a:var(--color-gray-200)] [--b:var(--color-gray-100)] max-sm:hidden dark:[--a:var(--color-gray-700)] dark:[--b:var(--color-gray-800)]"
          >
            <div class="" id="layout-camera"></div>
          </div>

          <div
            class="shadow-panel relative shrink-0 rounded-[.875rem] bg-white max-sm:size-full sm:aspect-9/16 dark:bg-gray-800"
          >
            <div class="absolute inset-0 perspective-[1000px]">
              <div class="relative size-full transform-3d" id="scene-camera">
                <div class="flex size-full flex-col"></div>
              </div>
            </div>
          </div>
        </div>

        <div
          class="shadow-track relative flex h-18 shrink-0 flex-col rounded-[.875rem] bg-white dark:bg-gray-800"
        >
          <button
            aria-label="Play or pause track"
            class="shadow-track absolute inset-2 right-auto flex w-10 items-center justify-center rounded-md bg-white transition-colors duration-200 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700"
            data-play-button
          >
            <svg
              class="h-3.5 w-6 [--fill:var(--color-gray-500)] [--shimmer:var(--color-gray-200)] dark:[--fill:var(--color-gray-500)]"
              viewBox="0 0 24 14"
              xmlns="http://www.w3.org/2000/svg"
            >
              <defs>
                <linearGradient
                  gradientUnits="userSpaceOnUse"
                  id="shimmer"
                  x1="-24"
                  x2="0"
                  y1="0"
                  y2="0"
                  class="animate-shimmer rotate-15 not-group-data-playing/box:[animation-play-state:running] group-data-playing/box:[animation-play-state:paused]"
                >
                  <stop offset="0%" stop-color="var(--fill)" stop-opacity="1"
                  ></stop>

                  <stop
                    offset="40%"
                    stop-color="var(--shimmer)"
                    stop-opacity="0.8"></stop>

                  <stop
                    offset="60%"
                    stop-color="var(--shimmer)"
                    stop-opacity="0.8"></stop>

                  <stop offset="100%" stop-color="var(--fill)" stop-opacity="1"
                  ></stop>
                </linearGradient>
              </defs>

              <path
                clip-rule="evenodd"
                d="M3.0625 3.37742C3.0625 2.57881 3.9382 2.08947 4.61835 2.50802L10.5053 6.13077C11.1531 6.52942 11.1531 7.47098 10.5053 7.86957L4.61835 11.4923C3.9382 11.9109 3.0625 11.4215 3.0625 10.6229V3.37742Z"
                fill="url(#shimmer)"
                fill-rule="evenodd"></path>
              <path
                clip-rule="evenodd"
                d="M11.8958 2.91671C11.8958 2.35292 12.3528 1.89587 12.9166 1.89587H15.2499C15.8137 1.89587 16.2708 2.35292 16.2708 2.91671V11.0834C16.2708 11.6472 15.8137 12.1042 15.2499 12.1042H12.9166C12.3528 12.1042 11.8958 11.6472 11.8958 11.0834V2.91671Z"
                fill="url(#shimmer)"
                fill-rule="evenodd"></path>
              <path
                clip-rule="evenodd"
                d="M17.7292 2.91671C17.7292 2.35292 18.1863 1.89587 18.7501 1.89587H21.0834C21.6472 1.89587 22.1042 2.35292 22.1042 2.91671V11.0834C22.1042 11.6472 21.6472 12.1042 21.0834 12.1042H18.7501C18.1863 12.1042 17.7292 11.6472 17.7292 11.0834V2.91671Z"
                fill="url(#shimmer)"
                fill-rule="evenodd"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div
      class="shadow-float xl:shadow-panel absolute right-5 z-50 flex h-145 w-3xs shrink-0 origin-right flex-col overflow-hidden rounded-[1.25rem] bg-white max-sm:hidden xl:static xl:h-full dark:bg-gray-800"
      id="demo-right-panel"
    >
      <div class="flex items-center justify-between p-3 pl-4">
        <span class="text-[0.8125rem]/6 font-[550]">Music</span>

        <div class="flex size-6 items-center justify-center">
          <Icon class="size-4" name="more-horizontal" />
        </div>
      </div>

      <hr class="border-gray-200 dark:border-gray-700" />

      <div class="flex flex-col gap-3 p-4">
        <div class="relative h-25 rounded-sm bg-gray-100 dark:bg-gray-700">
          <a
            class="absolute inset-2.5 right-auto aspect-square transition-opacity duration-200 hover:opacity-80 focus-visible:outline-2"
            href="https://www.youtube.com/watch?v=OqTpNnSnwxQ"
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="sr-only"
              >iloveitiloveitiloveit by Bella Kay on YouTube</span
            >

            <div
              class="shadow-cover absolute inset-0 z-10 overflow-hidden rounded-xs bg-cover before:absolute before:z-20 before:size-full before:rounded-xs before:[background-image:var(--before)] before:bg-size-[100%_100%] before:opacity-50 before:mix-blend-screen after:absolute after:inset-0 after:z-30 after:rounded-xs after:[background-image:var(--after)] after:opacity-20 after:mix-blend-screen"
              ,
              style={{
                "--after": `url(${vinylSleeveImage.src})`,
                "--before": `url(${vinylTextureImage.src})`,
                backgroundImage: `url(${songCoverImage.src})`,
              }}
            >
            </div>

            <div
              class="shadow-vinyl absolute inset-1 right-auto aspect-square size-18 translate-x-1/2 rounded-full bg-size-[105%_105%] bg-center"
              style={{ backgroundImage: `url(${vinylRecordImage.src})` }}
              id="demo-vinyl"
            >
              <div
                class="shadow-label absolute top-1/3 left-1/3 size-1/3 rounded-full bg-cover"
              >
              </div>
            </div>
          </a>

          <div
            class="absolute top-1/2 right-7.25 grid size-11.25 -translate-y-1/2 grid-cols-8 gap-0.5"
          >
            {
              Array.from({ length: rows * cols }, (_, i) => {
                const row = Math.floor(i / cols);
                const col = i % cols;
                return (
                  <div
                    class:list={[
                      "size-0.75 shrink-0 rounded-full bg-linear-to-b from-gray-800 to-gray-400",
                      !filled.has(`${row},${col}`) && "invisible",
                    ]}
                  />
                );
              })
            }
          </div>
        </div>

        <div class="flex gap-2">
          <button
            aria-label="Toggle volume"
            class="group relative flex size-6 shrink-0 cursor-pointer items-center justify-center rounded-sm transition-colors duration-200 before:absolute before:-inset-1.5 hover:bg-gray-200 data-muted:bg-red-400/10 data-muted:text-red-400 dark:hover:bg-gray-700 dark:data-muted:bg-red-500/20 dark:data-muted:text-red-500"
            id="demo-volume-button"
          >
            <svg
              aria-hidden="true"
              class="size-4 group-data-muted:hidden"
              fill="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M11 4q1-1 2.4-.6 1.1.7 1.2 2.1.3 1.3.2 3.6V15q0 2.2-.2 3.6 0 1.4-1.2 2.1Q12 21 11 20l-2.7-2.5-1.2-1-1.6-.2H3.8q-.8 0-1.3-.5-1-.8-1.2-2v-3.7q0-1 1.2-2l1.3-.4h1.7l1.6-.2 1.2-1z"
              ></path>

              <path
                clip-rule="evenodd"
                d="M16.4 8.2a1 1 0 0 1 1.4.2 6 6 0 0 1 0 7.2 1 1 0 1 1-1.6-1.2A4 4 0 0 0 17 12a4 4 0 0 0-.8-2.4 1 1 0 0 1 .2-1.4"
                fill-rule="evenodd"></path>

              <path
                clip-rule="evenodd"
                d="M19.3 6.3a1 1 0 0 1 1.4 0A8 8 0 0 1 23 12q-.1 3.3-2.3 5.7a1 1 0 0 1-1.4-1.4A6 6 0 0 0 21 12q0-2.4-1.7-4.3a1 1 0 0 1 0-1.4"
                fill-rule="evenodd"></path>
            </svg>

            <svg
              class="size-4 not-group-data-muted:hidden"
              fill="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                d="M1.3 1.3a1 1 0 0 1 1.4 0l20 20a1 1 0 0 1-1.4 1.4l-20-20a1 1 0 0 1 0-1.4"
                clip-rule="evenodd"></path>

              <path
                d="M11 4q1-1 2.4-.6 1.1.7 1.2 2.1.3 1.3.2 3.6v.7q0 .9-.2 1t-.9-.6L9.7 6q-.4-.3-.4-.5l.3-.4L11 3.9m3.8 11q0 2.3-.2 3.6 0 1.4-1.2 2.1Q12 21 11 20l-2.7-2.5-1.2-1-1.6-.2H3.8q-.8 0-1.3-.5-1-.8-1.2-2v-3.7q0-1 1.2-2l1.3-.4h1.7l1.7-.3h.3v.1l7.2 7.2z"
              ></path>

              <path
                fill-rule="evenodd"
                d="M19.3 7.3a1 1 0 0 1 1.4 0 7 7 0 0 1 1.1 9 1 1 0 0 1-1.6-1 5 5 0 0 0 .8-2.8q0-2.1-1.7-3.8a1 1 0 0 1 0-1.4m-3 2a1 1 0 0 1 1.5 0 5 5 0 0 1 1.2 3.5 1 1 0 1 1-2 0q0-1.2-.8-2.2a1 1 0 0 1 .2-1.4"
                clip-rule="evenodd"></path>
            </svg>
          </button>

          <div class="relative h-6 w-full">
            <span
              class="pointer-events-none absolute top-1/2 left-1/10 z-10 size-0.75 -translate-y-1/2 rounded-full bg-gray-400 dark:bg-gray-500"
            ></span>

            <span
              class="pointer-events-none absolute top-1/2 left-2/10 z-10 size-0.75 -translate-x-px -translate-y-1/2 rounded-full bg-gray-400 dark:bg-gray-500"
            ></span>

            <span
              class="pointer-events-none absolute top-1/2 left-3/10 z-10 size-0.75 -translate-x-px -translate-y-1/2 rounded-full bg-gray-400 dark:bg-gray-500"
            ></span>

            <span
              class="pointer-events-none absolute top-1/2 left-4/10 z-10 size-0.75 -translate-x-0.5 -translate-y-1/2 rounded-full bg-gray-400 dark:bg-gray-500"
            ></span>

            <span
              class="pointer-events-none absolute top-1/2 left-5/10 z-10 size-0.75 -translate-x-0.5 -translate-y-1/2 rounded-full bg-gray-400 dark:bg-gray-500"
            ></span>

            <span
              class="pointer-events-none absolute top-1/2 left-6/10 z-10 size-0.75 -translate-x-0.5 -translate-y-1/2 rounded-full bg-gray-400 dark:bg-gray-500"
            ></span>

            <span
              class="pointer-events-none absolute top-1/2 left-7/10 z-10 size-0.75 -translate-x-0.5 -translate-y-1/2 rounded-full bg-gray-400 dark:bg-gray-500"
            ></span>

            <span
              class="pointer-events-none absolute top-1/2 left-8/10 z-10 size-0.75 -translate-x-0.5 -translate-y-1/2 rounded-full bg-gray-400 dark:bg-gray-500"
            ></span>

            <span
              class="pointer-events-none absolute top-1/2 left-9/10 z-10 size-0.75 -translate-x-0.5 -translate-y-1/2 rounded-full bg-gray-400 dark:bg-gray-500"
            ></span>

            <label for="demo-volume-slider" class="sr-only">Volume</label>

            <input
              aria-label="Volume"
              class="w-full cursor-grab appearance-none overflow-hidden rounded-sm [-webkit-appearance:none] active:cursor-grabbing [&::-moz-range-thumb]:h-3 [&::-moz-range-thumb]:w-0.5 [&::-moz-range-thumb]:translate-y-1.5 [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border-none [&::-moz-range-thumb]:bg-gray-200 [&::-moz-range-thumb]:shadow-[-400px_0_0_400px_var(--color-gray-200)] dark:[&::-moz-range-thumb]:bg-gray-200 dark:[&::-moz-range-thumb]:shadow-[-400px_0_0_400px_var(--color-gray-600)] [&::-moz-range-track]:h-6 [&::-moz-range-track]:rounded-sm [&::-moz-range-track]:bg-gray-100 dark:[&::-moz-range-track]:bg-gray-700 [&::-webkit-slider-runnable-track]:h-6 [&::-webkit-slider-runnable-track]:rounded-sm [&::-webkit-slider-runnable-track]:bg-gray-100 dark:[&::-webkit-slider-runnable-track]:bg-gray-700 [&::-webkit-slider-thumb]:h-3 [&::-webkit-slider-thumb]:w-0.5 [&::-webkit-slider-thumb]:translate-y-1.5 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:border-none [&::-webkit-slider-thumb]:bg-gray-200 [&::-webkit-slider-thumb]:shadow-[-400px_0_0_400px_var(--color-gray-200)] [&::-webkit-slider-thumb]:[-webkit-appearance:none] dark:[&::-webkit-slider-thumb]:bg-gray-600 dark:[&::-webkit-slider-thumb]:shadow-[-400px_0_0_400px_var(--color-gray-600)]"
              id="demo-volume-slider"
              min="0"
              max="100"
              name="demo-volume-slider"
              step="10"
              type="range"
              value="10"
            />
          </div>
        </div>
      </div>

      <hr class="border-gray-200 dark:border-gray-700" />

      <div class="flex items-center justify-between p-3 pl-4">
        <span class="text-[0.8125rem]/6 font-[550]">Motion</span>

        <div class="flex size-6 items-center justify-center">
          <Icon class="size-4" name="more-horizontal" />
        </div>
      </div>

      <hr class="border-gray-200 dark:border-gray-700" />

      <div class="flex flex-col gap-3 p-4">
