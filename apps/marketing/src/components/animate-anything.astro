<script>
  import gsap from "gsap";

  const roots = Array.from(
    document.querySelectorAll<HTMLElement>("[data-animate-anything]"),
  );

  for (const root of roots) {
    const heading1 = root.querySelector<HTMLElement>(
      "[data-aa='heading-animate']",
    );
    const heading2 = root.querySelector<HTMLElement>(
      "[data-aa='heading-anything']",
    );
    const button = root.querySelector<HTMLElement>("[data-aa='button']");
    const squiggle = root.querySelector<HTMLElement>("[data-aa='squiggle']");

    if (!(heading1 && heading2)) {
      continue;
    }

    const animate = <T extends Element = HTMLElement>(selector: string) =>
      Array.from(heading1.querySelectorAll<T>(selector));
    const anything = <T extends Element = HTMLElement>(selector: string) =>
      Array.from(heading2.querySelectorAll<T>(selector));

    const defaults = {
      duration: 0.6,
      ease: "power2.out",
    };

    const initSquiggleMouseMovement = () => {
      if (!squiggle) {
        return () => {};
      }

      let windowWidth = window.innerWidth;
      let windowHeight = window.innerHeight;

      const setWindowSize = () => {
        windowWidth = window.innerWidth;
        windowHeight = window.innerHeight;
      };

      const xTo = gsap.quickTo(squiggle, "xPercent", {
        duration: 1,
        ease: "power3",
      });
      const yTo = gsap.quickTo(squiggle, "yPercent", {
        duration: 1,
        ease: "power3",
      });
      const rotateTo = gsap.quickTo(squiggle, "rotation", {
        duration: 1,
        ease: "power3",
      });

      const onResize = () => setWindowSize();
      const onMouseMove = (event: MouseEvent) => {
        const xPercent = gsap.utils.mapRange(0, windowWidth, -20, 20, event.x);
        const yPercent = gsap.utils.mapRange(0, windowHeight, -20, 20, event.y);
        const rotateRange = gsap.utils.clamp(
          -1,
          1,
          gsap.utils.mapRange(
            windowWidth * 0.25,
            windowWidth * 0.75,
            1,
            -1,
            event.x,
          ),
        );

        rotateTo(yPercent * rotateRange);
        xTo(xPercent);
        yTo(yPercent);
      };

      window.addEventListener("resize", onResize);
      window.addEventListener("mousemove", onMouseMove);

      return () => {
        window.removeEventListener("resize", onResize);
        window.removeEventListener("mousemove", onMouseMove);
      };
    };

    const char1 = () => {
      const tl = gsap.timeline({ defaults });
      const wrap = animate("[data-aa='a1-wrap']");
      const char = animate("[data-aa='a1-letter']");

      tl.set(wrap, { transformOrigin: "50% 100%" });
      tl.from(char, { yPercent: 100 });
      tl.from(
        wrap,
        { duration: 1, ease: "back.out(1.7)", rotationX: -180 },
        "-=.4",
      );

      return tl;
    };

    const char2 = () => {
      const tl = gsap.timeline({ defaults });
      const circles = animate("[data-aa-flair='circles']");
      const circlesSvg = animate("[data-aa-svg='circles']");
      const windmill = animate("[data-aa-flair='windmill']");
      const wrap = animate("[data-aa='n-wrap']");
      const chars = animate("[data-aa='n-char']");

      if (chars[1]) {
        tl.set(chars[1], { autoAlpha: 1 });
      }
      tl.set(circles, { autoAlpha: 1, yPercent: 100 });
      tl.from(circlesSvg, { ease: "back.out(1.7)", scale: 0 });
      tl.to(circles, {
        autoAlpha: 0,
        duration: 1.5,
        ease: "power4.out",
        yPercent: -200,
      });
      tl.from(wrap, { duration: 0.4, yPercent: 100 }, "<");
      tl.from(
        windmill,
        {
          duration: 1,
          rotationZ: -360,
          x: () => window.innerWidth / -2,
        },
        "<",
      );

      if (chars[0]) {
        tl.from(chars[0], { duration: 0.3, rotationY: -180 }, "+=.4");
      }
      if (chars[1]) {
        tl.to(chars[1], { duration: 0.3, rotationY: 180 }, "<");
      }
      tl.to(
        windmill,
        {
          duration: 0.3,
          repeat: -1,
          repeatDelay: 1,
          rotationZ: 90,
        },
        "<",
      );

      return tl;
    };

    const char3 = () =>
      gsap.from(animate("[data-aa='i1-letter']"), {
        duration: 1,
        ease: "back.out(1.4)",
        yPercent: -100,
      });

    const char4 = () =>
      gsap.from(animate("[data-aa='m-letter']"), {
        xPercent: -100,
        ...defaults,
      });

    const char5 = () => {
      const tl = gsap.timeline({ defaults });
      const wrap = animate("[data-aa-char='a2']");
      const star = animate("[data-aa-flair='star']");
      const starSvg = animate("[data-aa-svg='star']");
      const char = animate("[data-aa='a2-letter']");

      tl.set(star, { autoAlpha: 1, xPercent: -150 });
      tl.from(starSvg, { duration: 0.4, scale: 0 });
      tl.add(char4(), "+=.6");
      tl.to(star, { xPercent: 0 }, "<");
      tl.set(wrap, { overflow: "hidden" });
      tl.to(star, { ease: "power2.in", yPercent: 130 }, "+=.5");
      tl.from(char, { yPercent: 100 }, "-=.3");
      tl.to(
        starSvg,
        { duration: 2, ease: "none", repeat: 2, rotationZ: 360 },
        0,
      );

      return tl;
    };

    const char7 = () =>
      gsap.from(animate("[data-aa='e-letter']"), {
        duration: 0.9,
        yPercent: 100,
      });

    const char6 = () => {
      const tl = gsap.timeline({ defaults });
      const [char] = animate("[data-aa='t-letter']");
      const numbersWrap = animate("[data-aa='t-numbers-wrap']");
      const numbers = animate("[data-aa='t-number']");

      tl.set(numbersWrap, { autoAlpha: 1 });
      if (numbers[0]) {
        tl.from(numbers[0], { duration: 0.4, yPercent: 100 }, "<");
      }
      tl.fromTo(
        [numbers[1], numbers[2]].filter(Boolean),
        { yPercent: 100 },
        { duration: 0.9, ease: "power2.inOut", stagger: 0.1, yPercent: -100 },
        "+=.2",
      );
      if (numbers[0]) {
        tl.to(numbers[0], { yPercent: -100 }, "-=.6");
      }
      if (char) {
        tl.from(char, { duration: 0.9, yPercent: 100 }, "<");
      }
      tl.add(char7(), "<");

      return tl;
    };

    const char8to9 = () => {
      const tl = gsap.timeline({ defaults });
      const topChars = anything("[data-aa='any-a-top'], [data-aa='any-n-top']");
      const bottomChars = anything(
        "[data-aa='any-a-bottom'], [data-aa='any-n-bottom']",
      );

      tl.fromTo(
        bottomChars,
        { yPercent: 100 },
        {
          duration: 3,
          keyframes: {
            ease: "power1.out",
            yPercent: [100, 0, 100, 0],
          },
          stagger: 0.4,
        },
      );

      tl.fromTo(
        topChars,
        { yPercent: -100 },
        {
          duration: 3,
          keyframes: {
            ease: "power1.out",
            yPercent: [-100, -100, 20, -100],
          },
          stagger: 0.4,
        },
        "<",
      );

      return tl;
    };

    const char10 = () =>
      gsap.from(anything("[data-aa='any-y-letter']"), {
        duration: 1,
        rotationY: -180,
        scale: 0,
      });

    const char11 = () => {
      const tl = gsap.timeline({ defaults });
      const bolt = anything("[data-aa-flair='bolt']");
      const [path] = anything<SVGPathElement>("[data-aa-path='bolt']");
      const rect = anything<SVGRectElement>("[data-aa-rect='bolt']");
      const char = anything("[data-aa='any-t-letter']");

      tl.set(bolt, { autoAlpha: 1 });
      if (path) {
        const length = path.getTotalLength();
        tl.set(path, {
          strokeDasharray: `${length} ${length}`,
          strokeDashoffset: length,
        });
        tl.to(path, { duration: 1, ease: "power3.inOut", strokeDashoffset: 0 });
      }
      tl.from(
        rect,
        {
          duration: 3.5,
          ease: "power4.out",
          transformOrigin: "50% 100%",
          yPercent: 100,
        },
        "<.5",
      );
      tl.from(
        bolt,
        {
          keyframes: {
            duration: 2,
            scale: [1, 1.1, 0.6, 0.7, 0.2, 0.3, 0],
          },
        },
        "-=2",
      );
      tl.from(char, { ease: "back.out(1.4)", scale: 0 }, "<.5");

      return tl;
    };

    const char12 = () => {
      const tl = gsap.timeline({ defaults });
      const char = anything("[data-aa='any-h-letter']");
      tl.from(char, { yPercent: -100 });
      return tl;
    };

    const char14 = () => {
      const tl = gsap.timeline({ defaults });
      tl.from(anything("[data-aa='any-n2-letter']"), { xPercent: -100 });
      return tl;
    };

    const char13 = () => {
      const tl = gsap.timeline({ defaults });
      const char = anything("[data-aa='any-i-letter']");

      tl.from(char, { autoAlpha: 0, duration: 0.1 }, "<");
      tl.from(char, { duration: 1.3, rotationX: -450 }, "<.14");
      tl.add(char14(), "<+=.5");
      tl.to(
        char,
        {
          duration: 1.5,
          repeat: -1,
          repeatDelay: 3,
          rotationX: 540,
          yoyo: true,
          yoyoEase: "power2.out",
        },
        "+=2",
      );

      return tl;
    };

    const char15 = () => {
      const tl = gsap.timeline({ defaults });
      tl.from(
        anything("[data-aa='any-g-letter']"),
        {
          autoAlpha: 0,
          duration: 2,
          ease: "elastic.out(1, 0.4)",
          rotationZ: -120,
        },
        "<.6",
      );
      return tl;
    };

    const buttonIn = () => {
      if (!button) {
        return null;
      }
      return gsap.from(button, {
        autoAlpha: 0,
        yPercent: 30,
        ...defaults,
      });
    };

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    let timeline: gsap.core.Timeline | undefined;
    const cleanupSquiggle = initSquiggleMouseMovement();

    let animationStarted = false;
    let inViewObserver: IntersectionObserver | null = null;

    const disconnectInViewObserver = () => {
      inViewObserver?.disconnect();
      inViewObserver = null;
    };

    const startAnimation = () => {
      if (animationStarted) {
        return;
      }
      animationStarted = true;
      disconnectInViewObserver();
      buildTimeline();
    };

    const attachInViewObserver = () => {
      disconnectInViewObserver();
      inViewObserver = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            startAnimation();
          }
        },
        { root: null, rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
      );
      inViewObserver.observe(root);
    };

    /** Full-motion: play when in view; reduced motion: settle immediately. */
    const beginWhenInView = () => {
      if (prefersReducedMotion.matches) {
        startAnimation();
        return;
      }
      const rect = root.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      const alreadyVisible =
        rect.width > 0 && rect.height > 0 && rect.bottom > 0 && rect.top < vh;
      if (alreadyVisible) {
        startAnimation();
      } else {
        attachInViewObserver();
      }
    };

    const buildTimeline = () => {
      timeline?.kill();

      if (prefersReducedMotion.matches) {
        gsap.set([heading1, heading2], { autoAlpha: 1 });
        gsap.set(
          [
            ...animate("[data-aa-flair]"),
            ...anything("[data-aa-flair]"),
            ...anything("[data-aa='any-i-letter']"),
          ],
          { clearProps: "all" },
        );
        gsap.set(anything("[data-aa='any-a-top'], [data-aa='any-n-top']"), {
          autoAlpha: 0,
        });
        gsap.set(
          anything("[data-aa='any-a-bottom'], [data-aa='any-n-bottom']"),
          {
            clearProps: "transform",
          },
        );
        return;
      }

      timeline = gsap.timeline({
        defaults,
        id: "home-hero",
      });

      timeline.set([heading1, heading2], { autoAlpha: 1 });
      timeline.add(char1());
      timeline.add(char2(), 0.4);
      timeline.add(char3(), 1);
      timeline.add(char5(), 0.8);
      timeline.add(char6(), 1.1);
      timeline.add(char8to9(), 1.5);
      timeline.add(char10(), 1.7);
      timeline.add(char11(), 2);
      timeline.add(char12(), 1.9);
      timeline.add(char13(), 2.4);
      timeline.add(char15(), 2.2);

      const buttonTween = buttonIn();
      if (buttonTween) {
        timeline.add(buttonTween, 1);
      }
    };

    const onMotionChange = () => {
      timeline?.kill();
      if (prefersReducedMotion.matches) {
        disconnectInViewObserver();
        animationStarted = true;
        buildTimeline();
        return;
      }
      animationStarted = false;
      beginWhenInView();
    };
    prefersReducedMotion.addEventListener("change", onMotionChange);
    beginWhenInView();

    window.addEventListener(
      "pagehide",
      () => {
        prefersReducedMotion.removeEventListener("change", onMotionChange);
        disconnectInViewObserver();
        timeline?.kill();
        cleanupSquiggle();
      },
      { once: true },
    );
  }
</script>
