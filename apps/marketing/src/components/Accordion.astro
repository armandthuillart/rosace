---
interface Props {
  title: string;
}

let { title } = Astro.props;
---

<details
  class="group border-gray-200 not-last-of-type:border-b-2 dark:border-gray-800"
>
  <summary
    class="flex cursor-pointer items-start gap-4 pt-6 pb-3 select-none not-group-open:pb-7"
  >
    <svg
      aria-hidden="true"
      class="my-auto size-6 text-gray-400 group-open:hidden dark:text-gray-500"
      fill="currentColor"
      viewBox="0 0 24 24"
    >
      <use href="/sprites.svg#plus-sign"></use>
    </svg>

    <svg
      aria-hidden="true"
      class="my-auto size-6 text-gray-400 not-group-open:hidden dark:text-gray-500"
      fill="currentColor"
      viewBox="0 0 24 24"
    >
      <use href="/sprites.svg#minus-sign"></use>
    </svg>

    <h2 class="m-0! text-2xl font-bold">{title}</h2>
  </summary>

  <div
    class="mr-4 ml-10 pr-6 pb-7 text-xl **:not-first:not-last:my-3! **:first:mt-0! **:last:mb-0!"
  >
    <slot />
  </div>
</details>
