---
import { DASHBOARD_URL } from "astro:env/client";
import Demo from "@components/demo.astro";
---

<section class="px-5">
  <div class="mx-auto flex max-w-7xl flex-col gap-14">
    <div class="flex max-w-160 flex-col items-start gap-6">
      <h1
        class="text-[1.625rem]/tight font-medium -tracking-[.0125em] text-balance"
      >
        Create motion designs so good people watch them on-repeat
      </h1>

      <a
        class="relative inline-flex h-10.5 items-center justify-center gap-2 rounded-full bg-gray-800 pr-[calc(--spacing(6)-1px)] pl-[calc(--spacing(5)-1px)] text-center font-medium text-gray-200 before:absolute before:-inset-6 hover:bg-gray-600 focus-visible:outline-2 dark:bg-gray-200 dark:text-gray-800 dark:hover:bg-gray-300"
        data-button
        href={DASHBOARD_URL}
      >
        <svg
          aria-hidden="true"
          class="size-4"
          data-icon
          fill="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <use href="/sprites.svg#lockup"></use>
        </svg>
        Sign up for free
      </a>
    </div>

    <Demo />
  </div>
</section>

<script>
  import gsap from "gsap";

  const button = document.querySelector("[data-button]");

  if (button) {
    const icon = button.querySelector("[data-icon]");

    button.addEventListener("mouseenter", () => {
      gsap
        .timeline({
          overwrite: true,
        })
        .to(icon, {
          duration: 1,
          ease: "power3.out",
          rotation: "+=360",
        })
        .to(icon, {
          duration: 1,
          ease: "power4.out",
          rotation: 0,
        });
    });
  }
</script>
