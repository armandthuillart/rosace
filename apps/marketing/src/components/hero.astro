---
import { DASHBOARD_URL } from "astro:env/client";
---

<section class="px-5">
	<div class="max-w-7xl mx-auto flex flex-col gap-14">
		<div class="flex flex-col gap-6 items-start max-w-160">
			<h1
				class="text-balance font-medium text-[1.625rem]/tight -tracking-[.0125em]"
			>
				Create motion designs so good people watch them on-repeat
			</h1>

			<a
				class="relative font-medium h-10.5 pl-[calc(--spacing(5)-1px)] pr-[calc(--spacing(6)-1px)] inline-flex gap-2 items-center justify-center rounded-full text-center bg-primary text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 before:absolute before:-inset-6"
				data-button
				href={DASHBOARD_URL}
			>
				<svg
					aria-hidden="true"
					class="size-4"
					data-icon
					fill="currentColor"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<use href="/sprite.svg#lockup" />
				</svg>
				Sign up for free
			</a>
		</div>

		<div
			class="h-170 select-none overflow-hidden w-full bg-accent relative rounded-sm after:absolute after:border after:inset-0 after:rounded-[inherit] after:pointer-events-none after:border-border/25"
		>
			<div
				class="overflow-hidden flex flex-col bg-canvas shadow-canvas h-150 shrink-0 w-5xl rounded-2xl absolute left-[clamp(550px,50%,100%)] -translate-1/2 top-1/2"
			>
				<div
					class="absolute left-3 p-1.5 top-3 w-50 bg-material rounded-lg shadow-material"
				>
					<div class="size-8 rounded-sm flex items-center justify-center">
						<!-- <svg
							aria-hidden="true"
							class="size-4"
							fill="currentColor"
							viewBox="0 0 24 24"
							xmlns="http://www.w3.org/2000/svg"
						>
							<use href="/sprite.svg#arrow-left" />
						</svg> -->
					</div>
				</div>

				<div
					class="absolute right-3 p-1.5 top-3 h-11 bg-material rounded-lg shadow-material"
				>
					<div
						class="bg-tertiary font-medium size-full rounded-sm inline-flex gap-1.5 pl-[calc(--spacing(3.5)-1px)] pr-[calc(--spacing(4)-1px)] text-xs text-tertiary-foreground items-center text-center justify-center"
					>
						<svg
							aria-hidden="true"
							class="size-3"
							fill="currentColor"
							viewBox="0 0 24 24"
							xmlns="http://www.w3.org/2000/svg"
						>
							<use href="/sprite.svg#download" />
						</svg>
						Export
					</div>
				</div>

				<div
					class="absolute overflow-hidden h-19.5 bottom-6 left-1/2 rounded-2xl bg-material shadow-timeline -translate-x-1/2 w-full max-w-xl inline-flex"
				>
					<div
						class="inset-2 right-auto rounded-lg bg-material w-11 flex items-center justify-center absolute z-1 shadow-timeline text-muted-foreground -space-x-px"
					>
						<svg
							aria-hidden="true"
							class="size-3.5"
							fill="currentColor"
							viewBox="0 0 24 24"
							xmlns="http://www.w3.org/2000/svg"
						>
							<use href="/sprite.svg#play" />
						</svg>

						<svg
							aria-hidden="true"
							class="size-3.5"
							fill="currentColor"
							viewBox="0 0 24 24"
							xmlns="http://www.w3.org/2000/svg"
						>
							<use href="/sprite.svg#pause" />
						</svg>
					</div>

					<div
						class="-ml-10 flex flex-col h-full w-48 border-r border-border/75"
					>
						<div class="h-6.5 pl-1.5 pt-1 text-xs text-muted-foreground/75">
							1
						</div>

						<div class="relative h-6.5 bg-muted border-y border-border/50">
							<div
								class="left-1/2 size-6.5 p-0.75 border border-border bg-material rounded-full absolute top-1/2 -translate-y-1/2"
							>
								<div class="size-full bg-tertiary rounded-full" />
							</div>
						</div>
					</div>

					<div class="flex flex-col h-full w-48 border-r border-border/75">
						<div class="h-6.5 pl-1.5 pt-1 text-xs text-muted-foreground/75">
							2
						</div>

						<div class="relative h-6.5 bg-muted border-y border-border/50">
							<div
								class="left-1/4 size-6.5 p-0.75 border border-border bg-material rounded-full absolute top-1/2 -translate-y-1/2"
							>
								<div class="size-full bg-tertiary rounded-full" />
							</div>
						</div>
					</div>

					<div class="flex flex-col h-full w-48 border-r border-border/75">
						<div class="h-6.5 pl-1.5 pt-1 text-xs text-muted-foreground/75">
							3
						</div>

						<div class="relative h-6.5 bg-muted border-y border-border/50">
							<div
								class="left-4/10 size-6.5 p-0.75 border border-border bg-material rounded-full absolute top-1/2 -translate-y-1/2"
							>
								<div class="size-full bg-tertiary rounded-full" />
							</div>
						</div>
					</div>

					<div class="flex flex-col h-full w-48 border-r border-border/75">
						<div class="h-6.5 pl-1.5 pt-1 text-xs text-muted-foreground/75">
							4
						</div>

						<div class="relative h-6.5 bg-muted border-y border-border/50">
							<div
								class="left-6/10 size-6.5 p-0.75 border border-border bg-material rounded-full absolute top-1/2 -translate-y-1/2"
							>
								<div class="size-full bg-tertiary rounded-full" />
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
import gsap from "gsap";

const button = document.querySelector("[data-button]");

if (button) {
	const icon = button.querySelector("[data-icon]");

	button.addEventListener("mouseenter", () => {
		gsap
			.timeline({ overwrite: true })
			.to(icon, { duration: 1, ease: "power3.out", rotation: "+=360" })
			.to(icon, { duration: 1, ease: "power4.out", rotation: 0 });
	});
}
</script>
