---
import { DASHBOARD_URL } from "astro:env/client";
---

<section class="mt-24 flex items-center justify-center" id="cta">
  <a
    aria-label="Go to app"
    class="group relative inline-flex min-h-15 items-center justify-center gap-2 rounded-2xl bg-gray-900 py-4 pr-5 pl-13 text-center text-lg font-bold text-gray-200 shadow-gray-200 transition duration-300 not-dark:shadow-2xl before:absolute focus-visible:outline-2 max-sm:hidden dark:bg-gray-200 dark:text-gray-800"
    href={DASHBOARD_URL}
  >
    <svg
      class="ease absolute left-5 size-6 translate-x-0 opacity-100 transition duration-300 will-change-transform group-hover:-translate-x-full group-hover:scale-x-50 group-hover:opacity-0 group-hover:blur-sm"
      fill="currentColor"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <use href="/sprites.svg#arrow-right"></use>
    </svg>

    <span
      class="ease translate-x-0 transition duration-300 group-hover:-translate-x-8"
      >Start animating</span
    >

    <svg
      class="ease absolute right-5 size-6 translate-x-full scale-x-50 opacity-0 blur-sm transition duration-300 will-change-transform group-hover:translate-x-0 group-hover:scale-x-100 group-hover:opacity-100 group-hover:blur-none"
      fill="currentColor"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <use href="/sprites.svg#arrow-right"></use>
    </svg>
  </a>
</section>
