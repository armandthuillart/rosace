<div
	class="select-none @container w-full mx-auto max-w-xs size-full relative overflow-hidden"
	data-breakpoint
>
	<div
		class="left-1/2 top-1/2 -translate-1/2 absolute text-center inline-flex bg-teal-400 dark:bg-teal-500 text-white text-[16cqw] @min-[18.75rem]:text-[20cqw] @min-[31.25rem]:text-[25cqw] leading-none rounded-full py-[4cqw] px-[8cqw] [text-box-trim:trim-both] will-change-transform"
		data-word="1"
	>
		Resize
	</div>

	<div
		class="left-1/2 top-1/2 -translate-1/2 absolute text-center inline-flex bg-gray-200 dark:bg-gray-700 text-[16cqw] @min-[18.75rem]:text-[20cqw] @min-[31.25rem]:text-[25cqw] leading-none rounded-full py-[4cqw] px-[8cqw] [text-box-trim:trim-both] will-change-transform"
		data-word="2"
	>
		to
	</div>

	<div
		class="left-1/2 top-1/2 -translate-1/2 absolute text-center inline-flex bg-teal-400 dark:bg-teal-500 text-white text-[16cqw] @min-[18.75rem]:text-[20cqw] @min-[31.25rem]:text-[25cqw] leading-none rounded-full py-[4cqw] px-[8cqw] [text-box-trim:trim-both] will-change-transform"
		data-word="3"
	>
		any
	</div>

	<div
		class="left-1/2 top-1/2 -translate-1/2 absolute text-center inline-flex bg-gray-200 dark:bg-gray-700 text-[16cqw] @min-[18.75rem]:text-[20cqw] @min-[31.25rem]:text-[25cqw] leading-none rounded-full py-[4cqw] px-[8cqw] [text-box-trim:trim-both] will-change-transform"
		data-word="4"
	>
		format
	</div>

	<div
		class="left-1/2 top-1/2 -translate-1/2 absolute text-center inline-flex bg-teal-400 dark:bg-teal-500 text-white text-[16cqw] @min-[18.75rem]:text-[20cqw] @min-[31.25rem]:text-[25cqw] leading-none rounded-full py-[4cqw] px-[8cqw] [text-box-trim:trim-both] will-change-transform"
		data-word="5"
	>
		in
	</div>

	<div
		class="left-1/2 top-1/2 -translate-1/2 absolute text-center inline-flex bg-gray-200 dark:bg-gray-700 text-[16cqw] @min-[18.75rem]:text-[20cqw] @min-[31.25rem]:text-6xl leading-none rounded-full py-[4cqw] px-[8cqw] [text-box-trim:trim-both] will-change-transform"
		data-word="6"
	>
		seconds
	</div>
</div>

<script>
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

gsap.registerPlugin(ScrollTrigger);

const updateEmphasis = (
	wordNodes: HTMLElement[],
	spacing: number,
	offsetY: number,
	wrapY: (value: number) => number,
) => {
	for (const [index, word] of wordNodes.entries()) {
		const y = wrapY(index * spacing + offsetY);
		const distance = Math.min(Math.abs(y) / spacing, 2.2);
		const centerWeight = Math.max(0, 1 - distance);
		const fadeThreshold = 1.25;
		const fadeZone = 0.95;
		const fadeProgress = Math.max(0, (distance - fadeThreshold) / fadeZone);
		const edgeFade = 1 - Math.min(1, fadeProgress);
		const edgeWeight = 1 - centerWeight;
		const shouldHide = distance > 1.82;
		const opacity = shouldHide ? 0 : (0.08 + centerWeight * 0.92) * edgeFade;
		const scale = 0.84 + centerWeight * 0.16;
		const blur = shouldHide ? 3.2 : edgeWeight * 2.2;
		const rotation = Math.sign(y || 1) * edgeWeight * 16;
		const zIndex = String(100 - Math.round(Math.abs(y)));

		gsap.set(word, {
			autoAlpha: opacity,
			filter: `blur(${blur}px)`,
			rotation,
			scale,
			zIndex,
		});
	}
};

const runSequence = (root: HTMLElement) => {
	const mm = gsap.matchMedia();

	mm.add(
		{
			motionOk: "(prefers-reduced-motion: no-preference)",
			reduceMotion: "(prefers-reduced-motion: reduce)",
		},
		(context) => {
			const { reduceMotion } = context.conditions ?? {};

			const querySelector = gsap.utils.selector(root);
			const { toArray } = gsap.utils;

			const words = toArray(querySelector("[data-word]")) as HTMLElement[];

			if (words.length === 0) {
				return;
			}

			let tl: gsap.core.Timeline | null = null;
			const state = { y: 0 };

			const applyPositions = (
				orderedNodes: HTMLElement[],
				spacing: number,
				wrapY: (value: number) => number,
			) => {
				for (const [index, word] of orderedNodes.entries()) {
					gsap.set(word, { y: wrapY(index * spacing + state.y) });
				}
			};

			const runLayout = () => {
				tl?.kill();
				tl = null;
				state.y = 0;

				const orderedNodes = [...words].sort((a, b) => {
					const aWord = Number(a.dataset.word ?? "0");
					const bWord = Number(b.dataset.word ?? "0");
					return aWord - bWord;
				});

				const count = orderedNodes.length;
				const slotHeight = orderedNodes[0].offsetHeight || 1;
				const spacing = slotHeight * 1.05;
				const half = Math.floor(count / 2);
				const minY = -half * spacing;
				const maxY = (count - half) * spacing;

				const wrapY = gsap.utils.wrap(minY, maxY);

				applyPositions(orderedNodes, spacing, wrapY);
				updateEmphasis(orderedNodes, spacing, state.y, wrapY);

				if (reduceMotion) {
					return;
				}

				tl = gsap.timeline({
					onUpdate: () => {
						applyPositions(orderedNodes, spacing, wrapY);
						updateEmphasis(orderedNodes, spacing, state.y, wrapY);
					},
					repeat: -1,
				});

				if (count === 6) {
					tl.to(state, {
						keyframes: [
							{
								duration: 0.3,
								ease: "power4.inOut",
								y: `-=${spacing}`,
							},
							{
								duration: 0.3,
								ease: "power4.inOut",
								y: `-=${spacing}`,
							},
							{
								duration: 0.3,
								ease: "power4.inOut",
								y: `-=${spacing}`,
							},
							{
								duration: 0.4,
								ease: "power4.inOut",
								y: `-=${spacing}`,
							},
							{
								duration: 0.5,
								ease: "expo.out",
								y: `-=${spacing}`,
							},
							{
								duration: 0.4,
								ease: "expo.out",
								y: `-=${spacing}`,
							},
						],
					});
				} else {
					tl.to(state, {
						keyframes: Array.from({ length: count }, () => ({
							duration: 0.48,
							ease: "power4.inOut",
							y: `-=${spacing}`,
						})),
					});
				}
			};

			runLayout();

			ScrollTrigger.create({
				onRefresh: runLayout,
				refreshPriority: -1,
				trigger: root,
			});
		},
		root,
	);
};

const nodes = document.querySelectorAll<HTMLElement>("[data-breakpoint]");

for (const node of nodes) {
	runSequence(node);
}
</script>
