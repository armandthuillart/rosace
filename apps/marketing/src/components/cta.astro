---
import { DASHBOARD_URL } from "astro:env/client";
---

<section class="px-5">
  <div class="mx-auto mt-5 flex max-w-4xl flex-col items-center gap-6">
    <h2
      class="-z-2 text-center text-[3.25rem]/[1.15] -tracking-[.025em] text-balance min-[26.25rem]:text-7xl/[1.1] min-[26.25rem]:-tracking-[.03em]"
    >
      Blow them away
    </h2>

    <a
      href={DASHBOARD_URL}
      class="relative inline-flex h-11 items-center justify-center gap-2 rounded-full bg-gray-800 pr-[calc(--spacing(4)-1px)] pl-[calc(--spacing(5)-1px)] text-center font-medium text-gray-50 before:absolute before:-inset-6 hover:bg-gray-600 focus-visible:outline-2 dark:bg-gray-200 dark:text-gray-800 dark:hover:bg-gray-300"
      data-button="arrow-down"
    >
      <span class="sr-only">Sign up for free</span>

      <div
        class="pointer-events-none absolute top-1/2 left-4/10 origin-top-left translate-y-2.5"
        data-icon="lockup"
      >
        <svg
          aria-hidden="true"
          class="size-6 -translate-1/2 fill-teal-400 dark:fill-teal-500"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <use href="/sprite.svg#lockup"></use>
        </svg>
      </div>

      <div
        class="pointer-events-none absolute top-1/2 left-4/10 origin-top-left translate-y-2.5"
        data-icon="lockup"
      >
        <svg
          aria-hidden="true"
          class="size-15 -translate-1/2 fill-blue-400 dark:fill-blue-500"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <use href="/sprite.svg#lockup"></use>
        </svg>
      </div>

      <div
        class="pointer-events-none absolute top-1/2 left-4/10 origin-top-left translate-y-2.5"
        data-icon="lockup"
      >
        <svg
          aria-hidden="true"
          class="size-4.75 -translate-1/2 fill-violet-400 dark:fill-violet-500"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <use href="/sprite.svg#lockup"></use>
        </svg>
      </div>

      <div
        class="pointer-events-none absolute top-1/2 left-4/10 origin-top-left translate-y-2.5"
        data-icon="lockup"
      >
        <svg
          aria-hidden="true"
          class="size-4.5 -translate-1/2 fill-red-400 dark:fill-red-500"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <use href="/sprite.svg#lockup"></use>
        </svg>
      </div>

      <div class="inline-flex" data-label>
        <span data-side="left">Sign up</span>
        <span class="inline-block w-[.33ch]" aria-hidden="true" data-spacer
        ></span>
        <span data-side="right">for free</span>
      </div>

      <div
        class="relative flex size-5 items-center justify-center overflow-hidden rounded-full bg-gray-50 text-gray-800 dark:bg-gray-950 dark:text-gray-200"
      >
        <svg
          aria-hidden="true"
          class="absolute inset-0 m-auto size-4"
          data-icon="arrow-down"
          fill="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <use href="/sprite.svg#arrow-down"></use>
        </svg>

        <svg
          aria-hidden="true"
          class="absolute inset-0 m-auto size-4"
          data-icon="arrow-down"
          fill="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <use href="/sprite.svg#arrow-down"></use>
        </svg>
      </div>
    </a>
  </div>
</section>
<script>
  import gsap from "gsap";
  import { CustomEase } from "gsap/all";

  gsap.registerPlugin(CustomEase);

  const button = document.querySelector("[data-button='arrow-down']");
  const eases = {
    burstArc: CustomEase.create(
      "cta-burst-arc",
      "M0,0 C0.05,0.356 0.377,0.435 0.5,0.5 0.61,0.558 0.948,0.652 1,1 ",
    ),
    spinDrift: CustomEase.create(
      "cta-spin-drift",
      "M0,0 C0.148,0.346 0.254,0.444 0.5,0.5 0.751,0.557 0.852,0.646 1,1 ",
    ),
  };

  if (button) {
    const selector = gsap.utils.selector(button);
    const [nextArrow, currentArrow] = selector("[data-icon='arrow-down']");
    const lockups = selector("[data-icon='lockup']");
    const [label] = selector("[data-label]");
    const [spacer] = selector("[data-spacer]");
    let isPlaying = false;
    const baseSpacerWidth = spacer?.getBoundingClientRect().width ?? 0;
    const expandedSpacerWidth = Math.max(baseSpacerWidth, 56);

    if (lockups.length > 0) {
      gsap.set(lockups, {
        rotateZ: 0,
        scale: 0,
        x: 0,
        y: 10,
        zIndex: 0,
      });
    }

    if (nextArrow && currentArrow) {
      gsap.set(nextArrow, { yPercent: -140 });
      gsap.set(currentArrow, { yPercent: 0 });
    }

    if (spacer) {
      gsap.set(spacer, { width: baseSpacerWidth });
    }

    const tl = gsap.timeline({
      defaults: {
        duration: 1,
      },
      onComplete: () => {
        isPlaying = false;
      },
      onStart: () => {
        isPlaying = true;
      },
      paused: true,
    });

    if (lockups.length > 0) {
      tl.set(
        lockups,
        {
          rotateZ: 0,
          scale: 0,
          x: 0,
          y: 10,
          zIndex: 0,
        },
        0,
      );
    }

    if (label && spacer) {
      tl.set(
        spacer,
        {
          width: baseSpacerWidth,
        },
        0,
      ).to(
        spacer,
        {
          keyframes: [
            {
              duration: 0.5,
              ease: "power4.out",
              width: expandedSpacerWidth,
            },
            {
              duration: 0.5,
              ease: "power4.inOut",
              width: baseSpacerWidth,
            },
          ],
        },
        0,
      );
    }

    if (nextArrow && currentArrow) {
      tl.set(nextArrow, { yPercent: -140 }, 0)
        .set(currentArrow, { yPercent: 0 }, 0)
        .to(
          nextArrow,
          {
            duration: 0.6,
            ease: "power3.in",
            yPercent: 0,
          },
          0.3,
        )
        .to(
          currentArrow,
          {
            duration: 0.6,
            ease: "power3.out",
            yPercent: 140,
          },
          "<",
        );
    }

    if (lockups.length > 0) {
      tl.to(
        lockups,
        {
          ease: eases.burstArc,
          keyframes: [
            {
              duration: 0,
              scale: 0,
              zIndex: 2,
            },
            {
              scale: 1,
              y: () => gsap.utils.random(-80, -120),
            },
            {
              duration: 0.05,
              zIndex: -1,
            },
            {
              scale: 0.3,
              y: 0,
            },
          ],
          stagger: 0.15,
        },
        0.3,
      ).to(
        lockups,
        {
          ease: eases.spinDrift,
          rotateZ: () => -360,
          stagger: 0.15,
          x: () => gsap.utils.random(-50, 100),
        },
        0.3,
      );
    }

    button.addEventListener("mouseenter", () => {
      if (isPlaying) {
        return;
      }

      tl.invalidate().play(0);
    });
  }
</script>
