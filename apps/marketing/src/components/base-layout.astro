---
import BaseHead from "@components/base-head.astro";
import "@styles/global.css";
import Footer from "@components/footer.astro";
import Header from "@components/header.astro";
---

<html lang="en" class="antialiased scheme-light-dark">
  <head>
    <BaseHead title="Rosace" />

    <script>
      let style = document.createElement("style");
      style.textContent = "* { transition: none !important; }";

      let mm = matchMedia("(prefers-color-scheme: dark)");

      mm.addEventListener("change", () => {
        if (!style.isConnected) document.head.append(style);
        requestAnimationFrame(() => {
          requestAnimationFrame(() => style.remove());
        });
      });
    </script>
  </head>

  <body class="dark:bg-gray-1000 bg-white text-gray-800 dark:text-gray-200">
    <Header />

    <main
      class="isolate min-h-screen overflow-clip px-8 pt-32 pb-16 sm:pt-48 sm:pb-28 xl:px-36"
    >
      <div class="mx-auto flex max-w-7xl flex-col">
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>
