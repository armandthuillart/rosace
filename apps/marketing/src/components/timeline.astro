---
interface Props {
  classes?: string;
  duration: number;
  markers: Array<number>;
}

const { classes, duration, markers } = Astro.props;

function toLeft(value: number) {
  return `${value * 100}%`;
}
---

<div
  class:list={[
    "absolute overflow-hidden h-18 bottom-0 left-1/2 rounded-[.875rem] bg-white dark:bg-gray-800 shadow-timeline -translate-x-1/2 w-full max-w-xl inline-flex before:absolute before:left-0 before:h-full before:w-15 before:bg-linear-to-r before:z-1 before:from-white before:to-transparent dark:before:from-gray-800 before:from-10%",
    classes,
  ]}
  data-animate="timeline"
>
  <div
    class="z-20 absolute left-0 top-1 bottom-0 flex flex-col pointer-events-none"
    data-part="playhead"
  >
    <div
      class="z-10 text-[.625rem] tabular-nums bg-red-400 dark:bg-red-500 text-white rounded-full p-1 text-center min w-11 h-4 inline-flex items-center justify-center"
      data-part="time"
    >
      00:00
    </div>

    <div
      class="z-0 h-full w-[.09375rem] bg-red-400 dark:bg-red-500 left-1/2 absolute -translate-x-1/2"
    >
    </div>
  </div>

  <div
    class="inset-2 right-auto rounded-md bg-white dark:bg-gray-800 px-2 flex items-center justify-center absolute z-30 shadow-timeline text-gray-500 dark:text-gray-400"
    data-part="controls"
  >
    <svg
      aria-hidden="true"
      class="size-3.5"
      fill="currentColor"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <use href="/sprite.svg#play"></use>
    </svg>

    <svg
      aria-hidden="true"
      class="size-3.5"
      fill="currentColor"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <use href="/sprite.svg#pause"></use>
    </svg>
  </div>

  <div class="flex shrink-0" data-part="track">
    {
      Array.from({ length: duration }, (_, index) => (
        <div class="flex flex-col h-full w-48 border-r border-gray-200 dark:border-gray-600">
          <div class="h-6 pl-1.5 pt-1.25 text-xs text-gray-400 dark:text-gray-500">
            {index}s
          </div>

          <div class="relative h-6 bg-gray-50 border-y border-gray-150 dark:border-gray-600 dark:bg-gray-700">
            <div
              class="size-6.25 p-0.75 border border-gray-150 dark:border-gray-600 bg-white dark:bg-gray-800 rounded-full absolute top-1/2 -translate-y-1/2"
              style={`left: ${toLeft(markers[index % markers.length])}`}
            >
              <div class="size-full bg-(--accent) rounded-full" />
            </div>
          </div>
        </div>
      ))
    }

    <div
      class="relative flex flex-col h-full w-0 shrink-0 overflow-visible border-r border-gray-200 dark:border-gray-600"
    >
      <div
        class="absolute right-1.5 h-6 pt-1.25 text-xs text-gray-400 dark:text-gray-500 whitespace-nowrap"
      >
        {duration}s
      </div>

      <div
        class="relative h-6 w-0 border-y border-gray-150 dark:border-gray-600"
      >
      </div>
    </div>
  </div>
</div>

<script>
  import gsap from "gsap";

  for (const viewport of document.querySelectorAll<HTMLElement>(
    '[data-animate="timeline"]',
  )) {
    const timeEl = viewport.querySelector<HTMLElement>('[data-part="time"]');
    const trackEl = viewport.querySelector<HTMLElement>('[data-part="track"]');
    const playheadEl = viewport.querySelector<HTMLElement>(
      '[data-part="playhead"]',
    );

    if (!timeEl || !trackEl || !playheadEl) {
      continue;
    }
    const time = timeEl;
    const track = trackEl;
    const playhead = playheadEl;

    const duration = track.children.length - 1;

    const state = {
      time: 0,
    };

    const LEFT = 0.25;

    let center = 0;
    let tween: gsap.core.Tween;
    let stops: number[] = [];

    const activeCycle = Array.from(track.children);
    const lastCycle = document.createDocumentFragment();
    const nextCycle = document.createDocumentFragment();

    for (const cycle of activeCycle) {
      lastCycle.append(cycle.cloneNode(true));
      nextCycle.append(cycle.cloneNode(true));
    }

    track.prepend(lastCycle);
    track.append(nextCycle);

    const middleCycle = Array.from(track.children).slice(
      duration + 1,
      -1,
    ) as HTMLElement[];

    function resize() {
      center = viewport.getBoundingClientRect().width * LEFT;
      const x = center - (playhead?.offsetWidth ?? 0) / 2;
      stops = middleCycle.map((item) => item.offsetLeft);

      gsap.set(playhead, { x });
      gsap.set(track, { x: center - stops[0] });
    }

    resize();

    function format(value: number) {
      const cs = Math.round(value * 100);
      const secs = String(Math.floor(cs / 100));
      const remainder = String(cs % 100);
      return `${secs.padStart(2, "0")}:${remainder.padStart(2, "0")}`;
    }

    function onUpdate() {
      const clamped = gsap.utils.clamp(0, duration, state.time);
      const seconds = Math.floor(clamped);
      const progress = clamped - seconds;

      const start = stops[seconds];
      const end = stops[Math.min(seconds + 1, duration)];
      const x = center - gsap.utils.interpolate(start, end, progress);

      time.textContent = format(clamped);
      gsap.set(track, { x });
    }

    tween = gsap.to(state, {
      duration,
      ease: "none",
      repeat: -1,
      time: duration,
      onUpdate,
    });

    const controller = new AbortController();

    window.addEventListener(
      "resize",
      () => {
        tween.kill();
        resize();
        state.time = 0;

        tween = gsap.to(state, {
          duration,
          ease: "none",
          repeat: -1,
          time: duration,
          onUpdate,
        });
      },
      { signal: controller.signal },
    );

    window.addEventListener("pagehide", () => {
      controller.abort();
      tween.kill();
    });
  }
</script>
