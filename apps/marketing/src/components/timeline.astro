---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div
	class:list={[
		"absolute overflow-hidden h-18 bottom-0 left-1/2 rounded-[.875rem] bg-white dark:bg-gray-800 shadow-timeline -translate-x-1/2 w-full max-w-xl inline-flex before:absolute before:left-0 before:h-full before:w-15 before:bg-linear-to-r before:z-1 before:from-white before:to-transparent dark:before:from-gray-800 before:from-10%",
		className,
	]}
	data-timeline-viewport
>
	<div
		class="z-20 absolute left-0 top-1 bottom-0 flex flex-col pointer-events-none"
		data-timeline-time
	>
		<div
			class="z-10 text-[.625rem] tabular-nums bg-red-400 dark:bg-red-500 text-white rounded-full p-1 text-center min w-11 h-4 inline-flex items-center justify-center"
			data-timeline-time-label
		>
			00:00
		</div>

		<div
			class="z-0 h-full w-[.09375rem] bg-red-400 dark:bg-red-500 left-1/2 absolute -translate-x-1/2"
		/>
	</div>

	<div
		class="inset-2 right-auto rounded-md bg-white dark:bg-gray-800 px-2 flex items-center justify-center absolute z-30 shadow-timeline text-gray-500 dark:text-gray-400"
		data-timeline-controls
	>
		<svg
			aria-hidden="true"
			class="size-3.5"
			fill="currentColor"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<use href="/sprite.svg#play" />
		</svg>

		<svg
			aria-hidden="true"
			class="size-3.5"
			fill="currentColor"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<use href="/sprite.svg#pause" />
		</svg>
	</div>

	<div data-timeline class="flex shrink-0">
		<div
			class="flex flex-col h-full w-48 border-r border-gray-200 dark:border-gray-600"
		>
			<div class="h-6 pl-1.5 pt-1.25 text-xs text-gray-400 dark:text-gray-500">
				0s
			</div>

			<div
				class="relative h-6 bg-gray-50 border-y border-gray-150 dark:border-gray-600 dark:bg-gray-700"
			>
				<div
					class="-left-3.5 size-6.25 p-0.75 border border-gray-150 dark:border-gray-600 bg-white dark:bg-gray-800 rounded-full absolute top-1/2 -translate-y-1/2"
				>
					<div class="size-full bg-(--accent) rounded-full" />
				</div>
			</div>
		</div>

		<div
			class="flex flex-col h-full w-48 border-r border-gray-200 dark:border-gray-600"
		>
			<div class="h-6 pl-1.5 pt-1.25 text-xs text-gray-400 dark:text-gray-500">
				1s
			</div>

			<div
				class="relative h-6 bg-gray-50 border-y border-gray-150 dark:border-gray-600 dark:bg-gray-700"
			>
				<div
					class="left-[43.5%] size-6.25 p-0.75 border border-gray-150 dark:border-gray-600 bg-white dark:bg-gray-800 rounded-full absolute top-1/2 -translate-y-1/2"
				>
					<div class="size-full bg-(--accent) rounded-full" />
				</div>
			</div>
		</div>

		<div
			class="flex flex-col h-full w-48 border-r border-gray-200 dark:border-gray-600"
		>
			<div class="h-6 pl-1.5 pt-1.25 text-xs text-gray-400 dark:text-gray-500">
				2s
			</div>

			<div
				class="relative h-6 bg-gray-50 border-y border-gray-150 dark:border-gray-600 dark:bg-gray-700"
			>
				<div
					class="-left-3.5 size-6.25 p-0.75 border border-gray-150 dark:border-gray-600 bg-white dark:bg-gray-800 rounded-full absolute top-1/2 -translate-y-1/2"
				>
					<div class="size-full bg-(--accent) rounded-full" />
				</div>
			</div>
		</div>

		<div
			class="flex flex-col h-full w-48 border-r border-gray-200 dark:border-gray-600"
		>
			<div class="h-6 pl-1.5 pt-1.25 text-xs text-gray-400 dark:text-gray-500">
				3s
			</div>

			<div
				class="relative h-6 bg-gray-50 border-y border-gray-150 dark:border-gray-600 dark:bg-gray-700"
			>
				<div
					class="left-4/10 size-6.25 p-0.75 border border-gray-150 dark:border-gray-600 bg-white dark:bg-gray-800 rounded-full absolute top-1/2 -translate-y-1/2"
				>
					<div class="size-full bg-(--accent) rounded-full" />
				</div>
			</div>
		</div>

		<div
			class="flex flex-col h-full w-48 border-r border-gray-200 dark:border-gray-600"
		>
			<div class="h-6 pl-1.5 pt-1.25 text-xs text-gray-400 dark:text-gray-500">
				4s
			</div>

			<div
				class="relative h-6 bg-gray-50 border-y border-gray-150 dark:border-gray-600 dark:bg-gray-700"
			>
				<div
					class="left-6/10 size-6.25 p-0.75 border border-gray-150 dark:border-gray-600 bg-white dark:bg-gray-800 rounded-full absolute top-1/2 -translate-y-1/2"
				>
					<div class="size-full bg-(--accent) rounded-full" />
				</div>
			</div>
		</div>

		<div
			class="relative flex flex-col h-full w-0 shrink-0 overflow-visible border-r border-gray-200 dark:border-gray-600"
		>
			<div
				class="absolute right-1.5 h-6 pt-1.25 text-xs text-gray-400 dark:text-gray-500 whitespace-nowrap"
			>
				5s
			</div>

			<div
				class="relative h-6 w-0 border-y border-gray-150 dark:border-gray-600"
			/>
		</div>
	</div>
</div>

<script>
import gsap from "gsap";

// AI-gen code:
const timelineViewport = document.querySelector<HTMLElement>(
	"[data-timeline-viewport]",
);
const timelineTrack = document.querySelector<HTMLElement>("[data-timeline]");
const timelineTime = document.querySelector<HTMLElement>(
	"[data-timeline-time]",
);
const timelineTimeLabel = document.querySelector<HTMLElement>(
	"[data-timeline-time-label]",
);

if (timelineViewport && timelineTrack && timelineTime && timelineTimeLabel) {
	const DURATION_SECONDS = 5;
	const PLAYHEAD_RATIO = 0.4;
	const prefersReducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;
	const playbackState = { time: 0 };
	let playbackTween: gsap.core.Tween | undefined;

	if (timelineTrack.children.length === DURATION_SECONDS + 1) {
		const timelineCycle = Array.from(timelineTrack.children);
		const previousCycle = document.createDocumentFragment();
		const nextCycle = document.createDocumentFragment();

		for (const item of timelineCycle) {
			previousCycle.append(item.cloneNode(true));
			nextCycle.append(item.cloneNode(true));
		}

		timelineTrack.prepend(previousCycle);
		timelineTrack.append(nextCycle);
	}

	const formatPlaybackTime = (time: number) => {
		const centiseconds = Math.round(
			gsap.utils.clamp(0, DURATION_SECONDS, time) * 100,
		);
		const seconds = Math.floor(centiseconds / 100);
		const remainder = centiseconds % 100;

		return `${String(seconds).padStart(2, "0")}:${String(remainder).padStart(2, "0")}`;
	};

	const timelineStops = Array.from(timelineTrack.children).slice(
		DURATION_SECONDS + 1,
		(DURATION_SECONDS + 1) * 2,
	) as HTMLElement[];

	const getTimelineLayout = () => {
		const viewportRect = timelineViewport.getBoundingClientRect();
		const playheadWidth = timelineTime.offsetWidth;
		const playheadCenter = viewportRect.width * PLAYHEAD_RATIO;
		const playheadX = playheadCenter - playheadWidth / 2;
		const secondStops = timelineStops.map((stop) => stop.offsetLeft);

		return {
			playheadCenter,
			playheadX,
			secondStops,
		};
	};

	const getTrackXForTime = (
		time: number,
		layout: ReturnType<typeof getTimelineLayout>,
	) => {
		const clampedTime = gsap.utils.clamp(0, DURATION_SECONDS, time);
		const currentSecond = Math.floor(clampedTime);
		const progressToNextSecond = clampedTime - currentSecond;
		const startStop =
			layout.secondStops[currentSecond] ?? layout.secondStops.at(-1) ?? 0;
		const endStop =
			layout.secondStops[Math.min(currentSecond + 1, DURATION_SECONDS)] ??
			startStop;
		const currentStop = gsap.utils.interpolate(
			startStop,
			endStop,
			progressToNextSecond,
		);

		return layout.playheadCenter - currentStop;
	};

	const renderTimeline = (layout: ReturnType<typeof getTimelineLayout>) => {
		timelineTimeLabel.textContent = formatPlaybackTime(playbackState.time);
		gsap.set(timelineTime, { x: layout.playheadX });
		gsap.set(timelineTrack, {
			x: getTrackXForTime(playbackState.time, layout),
		});
	};

	const cleanup = () => {
		playbackTween?.kill();
		timelineTime.style.willChange = "auto";
		timelineTrack.style.willChange = "auto";
	};

	const syncTimeline = () => {
		cleanup();

		const layout = getTimelineLayout();
		playbackState.time = 0;
		renderTimeline(layout);

		if (prefersReducedMotion) {
			return;
		}

		timelineTime.style.willChange = "transform";
		timelineTrack.style.willChange = "transform";

		playbackTween = gsap.to(playbackState, {
			duration: DURATION_SECONDS,
			ease: "none",
			onUpdate: () => {
				renderTimeline(layout);
			},
			repeat: -1,
			time: DURATION_SECONDS,
		});
	};

	syncTimeline();
	window.addEventListener("resize", syncTimeline);
	window.addEventListener(
		"pagehide",
		() => {
			window.removeEventListener("resize", syncTimeline);
			cleanup();
		},
		{ once: true },
	);
}
</script>
