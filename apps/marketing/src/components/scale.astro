<div
  class="select-none @container w-full mx-auto max-w-xs size-full relative overflow-hidden"
  data-pills
>
  <div
    class="left-1/2 top-1/2 absolute text-center inline-flex bg-blue-400 dark:bg-blue-500 text-white text-[16cqw] @min-[18.75rem]:text-[20cqw] @min-[31.25rem]:text-[25cqw] leading-none rounded-full py-[4cqw] px-[8cqw] [text-box-trim:trim-both] will-change-transform"
    data-pill
  >
    Resize
  </div>

  <div
    class="left-1/2 top-1/2 absolute text-center inline-flex bg-gray-200 dark:bg-gray-700 text-[16cqw] @min-[18.75rem]:text-[20cqw] @min-[31.25rem]:text-[25cqw] leading-none rounded-full py-[4cqw] px-[8cqw] [text-box-trim:trim-both] will-change-transform"
    data-pill
  >
    to
  </div>

  <div
    class="left-1/2 top-1/2 absolute text-center inline-flex bg-blue-400 dark:bg-blue-500 text-white text-[16cqw] @min-[18.75rem]:text-[20cqw] @min-[31.25rem]:text-[25cqw] leading-none rounded-full py-[4cqw] px-[8cqw] [text-box-trim:trim-both] will-change-transform"
    data-pill
  >
    any
  </div>

  <div
    class="left-1/2 top-1/2 absolute text-center inline-flex bg-gray-200 dark:bg-gray-700 text-[16cqw] @min-[18.75rem]:text-[20cqw] @min-[31.25rem]:text-[25cqw] leading-none rounded-full py-[4cqw] px-[8cqw] [text-box-trim:trim-both] will-change-transform"
    data-pill
  >
    format
  </div>

  <div
    class="left-1/2 top-1/2 absolute text-center inline-flex bg-blue-400 dark:bg-blue-500 text-white text-[16cqw] @min-[18.75rem]:text-[20cqw] @min-[31.25rem]:text-[25cqw] leading-none rounded-full py-[4cqw] px-[8cqw] [text-box-trim:trim-both] will-change-transform"
    data-pill
  >
    in
  </div>

  <div
    class="left-1/2 top-1/2 absolute text-center inline-flex bg-gray-200 dark:bg-gray-700 text-[16cqw] @min-[18.75rem]:text-[20cqw] @min-[31.25rem]:text-6xl leading-none rounded-full py-[4cqw] px-[8cqw] [text-box-trim:trim-both] will-change-transform"
    data-pill
  >
    seconds
  </div>
</div>

<script>
  import gsap from "gsap";

  let root = document.querySelector<HTMLElement>("[data-pills]");
  let pills = gsap.utils.toArray<HTMLElement>("[data-pill]", root);
  let scroll = { offset: 0 };

  function tick() {
    let height = pills[0]!.offsetHeight;
    let half = pills.length / 2;
    let wrap = gsap.utils.wrap(-half * height, (pills.length - half) * height);

    for (let i = 0; i < pills.length; i++) {
      let y = wrap(i * height + scroll.offset * height);
      let distance = Math.abs(y);
      let steps = distance / height;
      let focus = steps < 1 ? 1 - steps : 0;
      let visible = steps < 2;

      gsap.set(pills[i], {
        xPercent: -50,
        yPercent: -50,
        y,
        filter: visible ? (focus > 0.5 ? "none" : "blur(2px)") : "blur(4px)",
        rotation: (y < 0 ? -1 : 1) * (1 - focus) * 8,
        autoAlpha: visible ? 0.1 + focus * 0.9 : 0,
        scale: 0.8 + focus * 0.2,
        zIndex: 100 - Math.round(distance),
      });
    }
  }

  let tl = gsap.timeline({
    defaults: {
      duration: 0.5,
      ease: "power4.out",
    },
    repeat: -1,
    repeatRefresh: true,
    onUpdate: tick,
  });

  for (let i = 0; i < pills.length; i++) {
    tl.to(scroll, { offset: "-=1" });
  }

  tick();
</script>
