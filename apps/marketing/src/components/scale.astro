<div
  class="-translate-1/2 left-1/2 top-1/2 absolute inline-flex bg-gray-200 dark:bg-gray-700 leading-none text-[2.5rem] rounded-full px-8 py-4"
  data-pill
>
  seconds
</div>

<script>
  import gsap from "gsap";

  const motion = document.getElementById("motion")!;
  const els = gsap.utils.toArray<HTMLElement>("[data-pill]", motion);

  const scroll = {
    offset: 0,
  };

  gsap.set(els, {
    scale: 1,
    rotation: 0,
  });

  const rotateTo = els.map((el) =>
    gsap.quickTo(el, "rotation", {
      duration: 0.25,
      ease: "back.out(1.35)",
    }),
  );

  function tick() {
    const h = els[0].offsetHeight;
    const half = els.length / 2;
    const wrap = gsap.utils.wrap(-half * h, (els.length - half) * h);

    const fadeSpan = 1.35;
    const minOpacity = 0.14;
    const opacityGamma = 1.45;
    const maxTilt = 6;
    const tiltCurve = 1.12;

    for (let i = 0; i < els.length; i++) {
      const y = wrap(i * h + scroll.offset * h);
      const d = Math.abs(y);
      const steps = d / h;

      const u = gsap.utils.clamp(0, 1, steps / fadeSpan);
      const presence = 1 - u * u * (3 - 2 * u);
      const opacity = minOpacity + (1 - minOpacity) * presence ** opacityGamma;

      const offAxis = (1 - presence) ** tiltCurve;
      const slideIn = 4 * presence * (1 - presence);
      const targetRotation =
        (y < 0 ? -1 : 1) * maxTilt * offAxis * (1 + 0.28 * slideIn);

      rotateTo[i](targetRotation);

      gsap.set(els[i], {
        y,
        autoAlpha: opacity,
        zIndex: 100 - Math.round(d),
      });
    }
  }

  const steps = [0.3, 0.34, 0.28, 0.32, 0.31, 0.35];

  const tl = gsap.timeline({
    defaults: {
      ease: "power2.inOut",
    },
    repeat: -1,
    repeatDelay: 0.5,
    repeatRefresh: true,
    onUpdate: tick,
  });

  for (let i = 0; i < els.length; i++) {
    tl.to(scroll, {
      offset: "-=1",
      duration: steps[i],
    });
  }

  tick();
</script>
