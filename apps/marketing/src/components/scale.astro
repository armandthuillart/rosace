  data-pill
>
  format
</div>

<div
  class="-translate-1/2 left-1/2 top-1/2 absolute inline-flex bg-gray-200 dark:bg-gray-600 leading-none text-[2.5rem] rounded-full px-8 py-4"
  data-pill
>
  in
</div>

<div
  class="-translate-1/2 left-1/2 top-1/2 absolute inline-flex bg-gray-200 dark:bg-gray-600 leading-none text-[2.5rem] rounded-full px-8 py-4"
  data-pill
>
  seconds
</div>

<script>
  import gsap from "gsap";

  const motion = document.getElementById("motion");
  const pills = gsap.utils.toArray<HTMLElement>("[data-pill]", motion);

  const scroll = { offset: 0 };

  gsap.set(pills, {
    scale: 1,
    rotation: 0,
  });

  const rotate = pills.map((pill) =>
    gsap.quickTo(pill, "rotation", {
      duration: 0.3,
      ease: "back.out(1.1)",
    }),
  );

  const n = pills.length;

  function tick() {
    const h = pills[0].offsetHeight;
    const span = (n / 2) * h;

    const yPositions = pills.map((_, index) =>
      gsap.utils.wrap(-span, span)((index + scroll.offset) * h),
    );

    let activeIndex = 0;

    for (let i = 1; i < n; i++) {
      const y = yPositions[i];
      const yBest = yPositions[activeIndex];
      if (y * y < yBest * yBest) activeIndex = i;
    }

    for (let i = 0; i < n; i++) {
      const y = yPositions[i];
      const distance = y < 0 ? -y : y;
      const offCenter = distance < 1.5 * h ? distance / (1.5 * h) : 1;
      const angle = (y < 0 ? -1 : 1) * 6 * offCenter;
      const opacity = 0.15 + 0.85 * (1 - offCenter);

      rotate[i](angle);

      const pill = pills[i];

      if (i === activeIndex) {
        pill.classList.remove("bg-gray-200", "dark:bg-gray-600");
        pill.classList.add("bg-blue-400", "dark:bg-blue-500", "text-white");
      } else {
        pill.classList.remove("bg-blue-400", "dark:bg-blue-500", "text-white");
        pill.classList.add("bg-gray-200", "dark:bg-gray-600");
      }

      gsap.set(pill, {
        opacity,
        y,
        zIndex: 100 - distance,
      });
    }
  }

  const tl = gsap.timeline({
    defaults: {
      duration: 0.3,
      ease: "back.out(1.1)",
    },
    repeat: -1,
    repeatDelay: 1,
    repeatRefresh: true,
    onUpdate: tick,
  });

  for (let i = 0; i < n; i++) {
    tl.to(scroll, { offset: "-=1" });
  }

  tick();
</script>
