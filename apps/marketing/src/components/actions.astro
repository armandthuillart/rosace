---
import cursor from "@assets/images/cursor.svg?url";
---

<div
  aria-hidden="true"
  class="@container relative flex h-146 w-full items-center justify-center"
  id="root"
>
  <img
    alt="Cursor"
    class="absolute top-0 left-0 z-50 size-12 opacity-0"
    id="cursor"
    src={cursor}
  />

  <div class="absolute bottom-0 flex w-full flex-col gap-2">
    <div
      class="shadow-timeline invisible z-40 mx-auto flex h-52 w-full max-w-md origin-bottom flex-col rounded-[.875rem] bg-white text-[.8125rem]/8 dark:bg-gray-800"
      id="popover-popup"
    >
      <div
        class="m-2 grid grid-cols-[2rem_1fr] rounded-md bg-gray-100 text-gray-500 dark:bg-gray-700 dark:text-gray-400"
      >
        <svg
          aria-hidden="true"
          class="m-2 size-4"
          fill="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <use href="/sprites.svg#search"></use>
        </svg>
        Search...
      </div>

      <div class="flex flex-1 flex-col gap-3 px-2 pt-1">
        <div class="flex flex-col gap-1">
          <div class="ml-1 text-[.6875rem]/4 text-gray-500 dark:text-gray-400">
            Suggestions
          </div>

          <div
            class="inline-flex gap-1 rounded-md p-1 text-[.8125rem]/6"
            id="action"
          >
            <svg
              aria-hidden="true"
              class="m-1 size-4"
              fill="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <use href="/sprites.svg#repeat"></use>
            </svg>
            Repeat forever
          </div>

          <div class="inline-flex gap-1 rounded-md p-1 text-[.8125rem]/6">
            <svg
              aria-hidden="true"
              class="m-1 size-4"
              fill="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <use href="/sprites.svg#paint-bucket"></use>
            </svg>
            Change color
          </div>
        </div>

        <div class="flex flex-col gap-1">
          <div class="ml-1 text-[.6875rem]/4 text-gray-500 dark:text-gray-400">
            Suggestions
          </div>

          <div class="inline-flex gap-1 rounded-md p-1 text-[.8125rem]/6">
            <svg
              aria-hidden="true"
              class="m-1 size-4"
              fill="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <use href="/sprites.svg#background"></use>
            </svg>
            Add filters
          </div>
        </div>
      </div>
    </div>

    <div
      class="shadow-timeline z-10 mx-auto inline-flex gap-2 rounded-xl bg-white p-2 dark:bg-gray-800"
    >
      <div
        class="flex size-8 shrink-0 items-center justify-center rounded-sm bg-blue-400 text-white dark:bg-blue-500"
      >
        <svg
          aria-hidden="true"
          class="size-5 translate-x-px"
          fill="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <use href="/sprites.svg#cursor"></use>
        </svg>
      </div>

      <div class="flex size-8 shrink-0 items-center justify-center rounded-md">
        <svg
          aria-hidden="true"
          class="size-5"
          fill="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <use href="/sprites.svg#hold"></use>
        </svg>
      </div>

      <div class="-my-2 w-px bg-gray-200 dark:bg-gray-600"></div>

      <div
        class="flex size-8 shrink-0 items-center justify-center rounded-md transition-colors"
        id="popover-trigger"
      >
        <svg
          aria-hidden="true"
          class="size-5"
          fill="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <use href="/sprites.svg#toolcase"></use>
        </svg>
      </div>

      <div class="-my-2 w-px bg-gray-200 dark:bg-gray-600"></div>

      <div
        class="inline-flex h-8 gap-0.5 overflow-hidden rounded-md bg-gray-100 p-0.5 dark:bg-gray-600"
      >
        <div
          class="flex size-7 items-center justify-center rounded-sm text-gray-500 dark:text-gray-400"
        >
          <svg
            aria-hidden="true"
            class="size-4"
            fill="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <use href="/sprites.svg#geometric-shapes"></use>
          </svg>
        </div>

        <div
          class="shadow-panel flex size-7 items-center justify-center rounded-sm bg-white text-blue-400 dark:bg-gray-800 dark:text-blue-500"
        >
          <svg
            aria-hidden="true"
            class="size-4"
            fill="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <use href="/sprites.svg#keyframe"></use>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <div
    class="mb-12 flex flex-col items-center justify-center text-[clamp(4rem,15cqw+1.5rem,12.5rem)]/none font-medium -tracking-[.03em]"
  >
    <div class="inline-flex">
      <div class="perspective-[46.875rem]">
        <div class="origin-bottom overflow-hidden" id="a1-wrap">
          <div class="pr-1" id="a1-char">A</div>
        </div>
      </div>

      <div class="relative">
        <div
          class="absolute top-[clamp(-5.75rem,-4.78964cqw-.00242718rem,-1.125rem)] left-[clamp(.3125rem,.711974cqw+.145631rem,1rem)] h-[clamp(1.9375rem,6.86084cqw+.32949rem,8.5625rem)] w-[clamp(1.9375rem,6.86084cqw+.32949rem,8.5625rem)] outline-0 outline-blue-400 dark:outline-blue-500"
          id="target"
        >
          <div
            class="bg-gray-150 invisible absolute -top-1 -left-1.25 z-10 size-2 outline-2 outline-blue-400 dark:bg-gray-900 dark:outline-blue-500"
            data-handle
          >
          </div>

          <div
            class="bg-gray-150 invisible absolute -top-1 -right-1.25 z-10 size-2 outline-2 outline-blue-400 dark:bg-gray-900 dark:outline-blue-500"
            data-handle
          >
          </div>

          <div
            class="bg-gray-150 invisible absolute -bottom-1 -left-1.25 z-10 size-2 outline-2 outline-blue-400 dark:bg-gray-900 dark:outline-blue-500"
            data-handle
          >
          </div>

          <div
            class="invisible absolute -right-1.25 -bottom-1 z-10 size-2 bg-white outline-2 outline-blue-400 dark:bg-gray-900 dark:outline-blue-500"
            data-handle
          >
          </div>

          <div class="invisible absolute size-full" id="n1-windmill">
            <svg
              aria-hidden="true"
              class="size-full text-red-400 dark:text-red-500"
              fill="currentColor"
              viewBox="0 0 137 135"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M84.1148 67.3453H136.194C136.637 67.3453 137 67.7028 137 68.1397V134.043C137 134.484 136.633 134.845 136.186 134.841C99.0222 134.416 68.9737 104.827 68.502 68.2191V134.206C68.502 134.643 68.1392 135 67.6958 135H0.814284C0.366822 135 -2.06673e-05 134.639 0.00401052 134.198C0.439379 97.2879 30.9354 67.5042 68.498 67.5002H0.806238C0.362807 67.5002 0 67.1427 0 66.7057V0.802561C0 0.361644 0.366822 0.000171863 0.814284 0.00414409C37.9778 0.429172 68.0263 30.0183 68.498 66.6263V0.794617C68.498 0.357672 68.8608 0.000171819 69.3042 0.000171819H136.186C136.633 0.000171819 137 0.361644 136.996 0.802561C136.621 32.4969 114.079 58.94 83.9334 65.7802C83.0022 65.9907 83.1594 67.3453 84.1189 67.3453H84.1148Z"
              ></path>
            </svg>
          </div>
        </div>

        <div
          class="invisible absolute top-[clamp(-5.75rem,-4.78964cqw-.00242718rem,-1.125rem)] left-[clamp(.3125rem,.323625cqw+.23665rem,.625rem)] h-[clamp(1.9375rem,6.86084cqw+.32949rem,8.5625rem)] w-[clamp(1.9375rem,6.86084cqw+.32949rem,8.5625rem)]"
          id="n1-circles-wrap"
        >
          <svg
            aria-hidden="true"
            class="size-full text-teal-400 dark:text-teal-500"
            fill="currentColor"
            id="n1-circles-svg"
            viewBox="0 0 156 156"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              clip-rule="evenodd"
              d="M45.9341 76.316C43.4159 76.8454 40.8068 77.1236 38.1333 77.1236C17.0729 77.1236 0 59.8589 0 38.5618C0 17.2647 17.0729 0 38.1333 0C59.1938 0 76.2666 17.2647 76.2666 38.5618C76.2666 40.3457 76.1469 42.1013 75.915 43.8209H80.0849C79.853 42.1013 79.7332 40.3457 79.7332 38.5618C79.7332 17.2647 96.8061 0 117.867 0C138.927 0 156 17.2647 156 38.5618C156 59.8589 138.927 77.1236 117.867 77.1236C115.499 77.1236 113.182 76.9054 110.934 76.4879V79.5128C113.182 79.0953 115.499 78.8771 117.867 78.8771C138.927 78.8771 156 96.1418 156 117.439C156 138.736 138.927 156.001 117.867 156.001C96.8064 156.001 79.7335 138.736 79.7335 117.439C79.7335 114.736 80.0086 112.097 80.5319 109.551H75.6376C76.0508 111.825 76.2667 114.169 76.2667 116.564C76.2667 137.861 59.1938 155.126 38.1334 155.126C17.0729 155.126 6.30037e-05 137.861 6.30037e-05 116.564C6.30037e-05 95.2671 17.0729 78.0024 38.1334 78.0024C40.8068 78.0024 43.416 78.2806 45.9341 78.8099V76.316Z"
              fill-rule="evenodd"></path>
          </svg>
        </div>

        <div class="overflow-hidden">
          <div class="relative" id="n1-wrap">
            <div class="backface-hidden" id="n1-char-n">n</div>

            <div
              class="invisible absolute bottom-0 left-0 flex backface-hidden"
              id="n1-char-a"
            >
              a
            </div>
          </div>
        </div>
      </div>

      <div class="overflow-hidden">
        <div id="i1-char">i</div>
      </div>

      <div class="overflow-hidden">
        <div id="m-char">m</div>
      </div>

      <div class="relative overflow-hidden" id="a2-wrap">
        <div
          class="invisible absolute bottom-[clamp(.5625rem,.970874cqw+.334951rem,1.5rem)] left-[clamp(.25rem,.582524cqw+.113471rem,.8125rem)] h-[clamp(2.5rem,7.11974cqw+.831311rem,9.375rem)] w-[clamp(2.5rem,7.11974cqw+.831311rem,9.375rem)]"
          id="a2-star-wrap"
        >
          <svg
            aria-hidden="true"
            class="size-full text-purple-400 dark:text-purple-500"
            fill="currentColor"
            id="a2-star-svg"
            viewBox="0 0 157 156"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              clip-rule="evenodd"
              d="M82.2214 104.04L105.483 143.586C108.242 148.276 114.274 149.852 118.974 147.112V147.112C123.675 144.371 125.275 138.345 122.552 133.634L99.5971 93.9091L144.009 105.424C149.276 106.79 154.656 103.639 156.042 98.3773V98.3773C157.428 93.1154 154.298 87.7233 149.042 86.317L104.72 74.4593L144.266 51.1978C148.957 48.439 150.533 42.407 147.792 37.7062V37.7062C145.052 33.0054 139.026 31.4057 134.314 34.1282L94.5898 57.0835L106.105 12.6719C107.471 7.40463 104.32 2.02469 99.058 0.638673V0.638673C93.7961 -0.747342 88.4041 2.38242 86.9977 7.63895L75.14 51.9603L51.8786 12.4142C49.1197 7.72403 43.0878 6.14763 38.387 8.8883V8.8883C33.6862 11.629 32.0865 17.6548 34.809 22.3662L57.7643 62.0908L13.3526 50.5758C8.08539 49.2101 2.70545 52.3607 1.31944 57.6226V57.6226C-0.0665745 62.8845 3.06319 68.2766 8.31971 69.6829L52.6411 81.5406L13.095 104.802C8.4048 107.561 6.8284 113.593 9.56907 118.294V118.294C12.3097 122.994 18.3356 124.594 23.0469 121.872L62.7716 98.9164L51.2566 143.328C49.8909 148.595 53.0414 153.975 58.3034 155.361V155.361C63.5653 156.747 68.9573 153.617 70.3637 148.361L82.2214 104.04Z"
              fill-rule="evenodd"></path>
          </svg>
        </div>

        <div class="overflow-hidden">
          <div id="a2-char">a</div>
        </div>
      </div>

      <div>
        <div class="relative w-5/1 overflow-hidden">
          <div class="backface-hidden" id="t-char">t</div>

          <div
            class="invisible absolute bottom-0 left-0 flex backface-hidden"
            id="t-binaries-wrap"
          >
            <div data-binary>1</div>
            <div data-binary>0</div>
            <div data-binary>0</div>
          </div>
        </div>
      </div>

      <div class="overflow-hidden">
        <div id="e-char">e</div>
      </div>
    </div>

    <div class="inline-flex">
      <div class="relative overflow-hidden">
        <div id="a3-char-top">a</div>
        <div class="absolute bottom-0 left-0" id="a3-char-bottom">a</div>
      </div>

      <div class="relative overflow-hidden">
        <div id="n2-char-top">n</div>
        <div class="absolute bottom-0 left-0" id="n2-char-bottom">n</div>
      </div>

      <div class="perspective-[46.875rem]">
        <div id="y-char">y</div>
      </div>

      <div class="relative">
        <div
          class="invisible absolute top-[clamp(.0625rem,.323625cqw-.0133495rem,.375rem)] left-0 h-[clamp(4.375rem,12.2977cqw+1.49272rem,16.25rem)] w-[clamp(2.1875rem,6.14887cqw+.746359rem,8.125rem)]"
          id="t2-bolt-wrap"
        >
          <svg
            aria-hidden="true"
            class="size-full"
            fill="none"
            viewBox="0 0 134 229"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              class="stroke-green-400 dark:stroke-green-500"
              clip-rule="evenodd"
              d="M101.08 11C102.439 11 103.402 12.3264 102.982 13.6187L78.6746 88.3335C78.2542 89.6259 79.2175 90.9522 80.5765 90.9522H108.983C110.634 90.9522 111.574 92.8401 110.579 94.1577L10.2304 227L39.4408 125.708C39.8095 124.429 38.8499 123.154 37.5191 123.154H7.82733C6.44727 123.154 5.48193 121.789 5.94147 120.488L44.1353 12.334C44.4176 11.5346 45.1733 11 46.0211 11H101.08Z"
              fill-rule="evenodd"
              id="t2-bolt-path"
              stroke-width="4"></path>

            <mask
              id="t2-bolt-mask"
              mask-type="alpha"
              maskUnits="userSpaceOnUse"
              x="0"
              y="0"
              width="134"
              height="227"
            >
              <rect
                class="origin-bottom"
                fill="white"
                height="227"
                id="t2-bolt-rect"
                width="134"></rect>
            </mask>

            <g mask="url(#t2-bolt-mask)">
              <path
                clip-rule="evenodd"
                d="M102.08 10C103.439 10 104.402 11.3264 103.982 12.6187L79.6746 87.3335C79.2542 88.6259 80.2175 89.9522 81.5765 89.9522H109.983C111.634 89.9522 112.574 91.8401 111.579 93.1577L11.2304 226L40.4408 124.708C40.8095 123.429 39.8499 122.154 38.5191 122.154H8.82733C7.44727 122.154 6.48193 120.789 6.94147 119.488L45.1353 11.334C45.4176 10.5346 46.1733 10 47.0211 10H102.08Z"
                class="fill-green-400 dark:fill-green-500"
                fill-rule="evenodd"></path>
            </g>
          </svg>
        </div>

        <div id="t2-char">t</div>
      </div>

      <div class="overflow-hidden">
        <div id="h-char">h</div>
      </div>

      <div class="perspective-[46.875rem]">
        <div id="i2-char">i</div>
      </div>

      <div class="overflow-hidden">
        <div id="n3-char">n</div>
      </div>

      <div id="g-char">g</div>
    </div>
  </div>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let section = document.getElementById("have-fun")!;

  let root = section.querySelector<HTMLElement>("#root")!;
  let cursor = section.querySelector<HTMLImageElement>("#cursor")!;
  let target = section.querySelector<HTMLElement>("#target")!;
  let handles = gsap.utils.toArray<HTMLElement>("[data-handle]", section)!;

  let popover = {
    popup: section.querySelector<HTMLElement>("#popover-popup")!,
    action: section.querySelector<HTMLElement>("#action")!,
    trigger: section.querySelector<HTMLElement>("#popover-trigger")!,
  };

  let chars = {
    a1: {
      wrap: section.querySelector<HTMLElement>("#a1-wrap")!,
      char: section.querySelector<HTMLElement>("#a1-char")!,
    },
    n1: {
      windmill: section.querySelector<HTMLElement>("#n1-windmill")!,
      circles: {
        wrap: section.querySelector<HTMLElement>("#n1-circles-wrap")!,
        svg: section.querySelector<SVGElement>("#n1-circles-svg")!,
      },
      char: {
        n: section.querySelector<HTMLElement>("#n1-char-n")!,
        a: section.querySelector<HTMLElement>("#n1-char-a")!,
      },
      wrap: section.querySelector<HTMLElement>("#n1-wrap")!,
    },
    i1: section.querySelector<HTMLElement>("#i1-char")!,
    m: section.querySelector<HTMLElement>("#m-char")!,
    a2: {
      char: section.querySelector<HTMLElement>("#a2-char")!,
      star: {
        wrap: section.querySelector<HTMLElement>("#a2-star-wrap")!,
        svg: section.querySelector<SVGElement>("#a2-star-svg")!,
      },
      wrap: section.querySelector<HTMLElement>("#a2-wrap")!,
    },
    t: {
      binaries: {
        wrap: section.querySelector<HTMLElement>("#t-binaries-wrap")!,
        bits: gsap.utils.toArray<HTMLElement>("[data-binary]", section)!,
      },
      char: section.querySelector<HTMLElement>("#t-char")!,
    },
    e: section.querySelector<HTMLElement>("#e-char")!,
    a3: {
      bottom: section.querySelector<HTMLElement>("#a3-char-bottom")!,
      top: section.querySelector<HTMLElement>("#a3-char-top")!,
    },
    n2: {
      bottom: section.querySelector<HTMLElement>("#n2-char-bottom")!,
      top: section.querySelector<HTMLElement>("#n2-char-top")!,
    },
    y: section.querySelector<HTMLElement>("#y-char")!,
    t2: {
      bolt: {
        wrap: section.querySelector<HTMLElement>("#t2-bolt-wrap")!,
        path: section.querySelector<SVGPathElement>("#t2-bolt-path")!,
        rect: section.querySelector<SVGRectElement>("#t2-bolt-rect")!,
        mask: section.querySelector<SVGMaskElement>("#t2-bolt-mask")!,
      },
      char: section.querySelector<HTMLElement>("#t2-char")!,
    },
    h: section.querySelector<HTMLElement>("#h-char")!,
    i2: section.querySelector<HTMLElement>("#i2-char")!,
    n3: section.querySelector<HTMLElement>("#n3-char")!,
    g: section.querySelector<HTMLElement>("#g-char")!,
  };

  let aabb = (
    a: {
      x: number;
      y: number;
      w: number;
      h: number;
    },
    b: {
      x: number;
      y: number;
      w: number;
      h: number;
    },
  ) =>
    a.x + a.w >= b.x &&
    a.x <= b.x + b.w &&
    a.y + a.h >= b.y &&
    a.y <= b.y + b.h;

  let box = (el: HTMLElement) => {
    let b = root.getBoundingClientRect();
    let r = el.getBoundingClientRect();
    return {
      x: r.left - b.left,
      y: r.top - b.top,
      w: r.width,
      h: r.height,
    };
  };

  let to = (el: HTMLElement, offsetX = 0, offsetY = 0) => {
    let r = box(el);
    let x = r.x + r.w / 2 - cursor.offsetWidth / 2 + offsetX;
    let y = r.y + r.h / 2 - cursor.offsetHeight / 2 + offsetY;
    return { x, y };
  };

  let ow = gsap.quickTo(target, "outlineWidth", {
    ease: "power4",
    duration: 0.15,
  });

  let open = false;

  let defaults: GSAPTweenVars = {
    duration: 0.6,
    ease: "power2.out",
  };

  let tl = gsap.timeline({
    defaults,
    repeat: -1,
    repeatDelay: 1,
    scrollTrigger: {
      start: "top bottom",
      trigger: section,
    },
  });

  function char1() {
    const tl = gsap.timeline({
      defaults,
    });

    tl.from(chars.a1.char, {
      ease: "power2.inOut",
      yPercent: 100,
    });

    tl.from(
      chars.a1.wrap,
      {
        duration: 1,
        ease: "back.out(1.7)",
        rotationX: -180,
      },
      "-=0.4",
    );

    return tl;
  }

  function char2() {
    const tl = gsap.timeline({
      defaults,
    });

    tl.set(handles, {
      autoAlpha: 0,
      scale: 0,
    });

    tl.set(popover.popup, {
      opacity: 0,
      scale: 0.9,
    });

    tl.set(cursor, {
      x: () => 0,
      y: () => 0,
      opacity: 0,
    });

    tl.set(chars.n1.char.a, {
      autoAlpha: 1,
    });

    tl.set(chars.n1.circles.wrap, {
      autoAlpha: 1,
      yPercent: 100,
    });

    tl.set(chars.n1.windmill, {
      autoAlpha: 1,
    });

    tl.from(chars.n1.circles.svg, {
      ease: "back.out(1.7)",
      scale: 0,
    });

    tl.to(chars.n1.circles.wrap, {
      autoAlpha: 0,
      duration: 1.5,
      ease: "power4.out",
      yPercent: -200,
    });

    tl.from(
      chars.n1.wrap,
      {
        duration: 0.4,
        yPercent: 100,
      },
      "<",
    );

    tl.from(
      chars.n1.windmill,
      {
        duration: 1,
        rotationZ: -360,
        x: () => window.innerWidth / -2,
      },
      "<",
    );

    tl.from(
      chars.n1.char.n,
      {
        rotationY: -180,
      },
      "+=0.4",
    );

    tl.to(
      chars.n1.char.a,
      {
        rotationY: 180,
      },
      "<",
    );

    tl.to(
      cursor,
      {
        x: () => to(target, 9, 9).x,
        y: () => to(target, 9, 9).y,
        ease: "power2",
        opacity: 1,
        duration: 1,
        onUpdate: () => {
          let a = box(cursor);
          let b = box(target);

          if (aabb(a, b)) {
            ow(2);
          }
        },
      },
      "-=2",
    );

    tl.to(
      cursor,
      {
        yoyo: true,
        scale: 0.8,
        repeat: 1,
        duration: 0.2,
      },
      "-=1",
    );

    tl.to(
      handles,
      {
        autoAlpha: 1,
        duration: 0.3,
        ease: "power4",
        scale: 1,
      },
      "-=1",
    );

    tl.to(
      cursor,
      {
        x: () => to(popover.trigger, 9, 9).x,
        y: () => to(popover.trigger, 9, 9).y,
        ease: "power3",
        duration: 1,
        onUpdate: () => {
          let a = box(cursor);
          let b = box(popover.trigger);

          if (!open && aabb(a, b)) {
            popover.trigger.classList.add("bg-gray-100", "dark:bg-gray-700");
          }
        },
      },
      "-=.6",
    );

    tl.to(
      cursor,
      {
        yoyo: true,
        scale: 0.8,
        repeat: 1,
        duration: 0.2,
      },
      "-=0.1",
    );

    tl.to(
      popover.popup,
      {
        ease: "power3",
        scale: 1,
        onStart: () => {
          open = true;
          popover.trigger.classList.remove("bg-gray-100", "dark:bg-gray-700");
          popover.trigger.classList.add(
            "text-white",
            "bg-blue-400",
            "dark:bg-blue-500",
          );
        },
        duration: 0.2,
        autoAlpha: 1,
      },
      "-=0.1",
    );

    tl.to(cursor, {
      x: () => to(popover.action, 9, 9).x,
      y: () => to(popover.action, 9, 9).y,
      ease: "power3",
      duration: 1,
      onUpdate: () => {
        let a = box(cursor);
        let b = box(popover.action);

        if (aabb(a, b)) {
          popover.action.classList.add("bg-gray-100", "dark:bg-gray-700");
        }
      },
    });

    tl.to(
      cursor,
      {
        yoyo: true,
        scale: 0.8,
        repeat: 1,
        duration: 0.2,
      },
      "-=0.1",
    );

    tl.to(popover.popup, {
      onStart: () => {
        open = false;
        popover.trigger.classList.remove(
          "text-white",
          "bg-blue-400",
          "dark:bg-blue-500",
        );
      },
      duration: 0.2,
      opacity: 0,
      scale: 0.9,
    });

    tl.to(
      chars.n1.windmill,
      {
        repeat: 4,
        repeatDelay: 1,
        rotationZ: 90,
      },
      "<",
    );

    return tl;
  }

  function char3() {
    const tl = gsap.timeline({
      defaults,
    });

    tl.from(chars.i1, {
      ease: "back.out(1.4)",
      duration: 1,
      yPercent: -100,
    });

    return tl;
  }

  function char4() {
    const tl = gsap.timeline({
      defaults,
    });

    tl.from(chars.m, {
      xPercent: -100,
    });

    return tl;
  }

  function char5() {
    const tl = gsap.timeline({
      defaults,
    });

    tl.set(chars.a2.star.wrap, {
      autoAlpha: 1,
      xPercent: -150,
    });

    tl.from(chars.a2.star.svg, {
      duration: 0.4,
      scale: 0,
    });

    tl.add(char4(), "+=0.6");

    tl.to(
      chars.a2.star.wrap,
      {
        xPercent: 0,
      },
      "<",
    );

    tl.to(
      chars.a2.star.wrap,
      {
        ease: "power2.in",
        yPercent: 130,
      },
      "+=0.5",
    );

    tl.from(
      chars.a2.char,
      {
        yPercent: 100,
      },
      "-=0.3",
    );

    tl.to(
      chars.a2.star.svg,
      {
        duration: 2,
        ease: "none",
        repeat: 2,
        rotationZ: 360,
      },
      0,
    );

    return tl;
  }

  const char7 = () =>
    gsap.from(chars.e, {
      duration: 0.9,
      yPercent: 100,
    });

  function char6() {
    const tl = gsap.timeline({
      defaults,
    });

    tl.set(chars.t.binaries.wrap, {
      autoAlpha: 1,
    });

    tl.from(
      chars.t.binaries.bits[0],
      {
        duration: 0.4,
        yPercent: 100,
      },
      "<",
    );

    tl.fromTo(
      [chars.t.binaries.bits[1], chars.t.binaries.bits[2]].filter(Boolean),
      {
        yPercent: 100,
      },
      {
        duration: 0.9,
        ease: "power2.inOut",
        stagger: 0.1,
        yPercent: -100,
      },
      "+=0.2",
    );

    tl.to(
      chars.t.binaries.bits[0],
      {
        yPercent: -100,
      },
      "-=0.6",
    );

    tl.from(
      chars.t.char,
      {
        yPercent: 100,
      },
      "<",
    );

    tl.add(char7(), "<");

    return tl;
  }

  function char8to9() {
    const tl = gsap.timeline({
      defaults,
    });

    tl.fromTo(
      [chars.a3.bottom, chars.n2.bottom],
      {
        yPercent: 100,
      },
      {
        duration: 3,
        keyframes: {
          ease: "power1.out",
          yPercent: [100, 0, 100, 0],
        },
        stagger: 0.4,
      },
    );

    tl.fromTo(
      [chars.a3.top, chars.n2.top],
      {
        yPercent: -100,
      },
      {
        duration: 3,
        keyframes: {
          ease: "power1.out",
          yPercent: [-100, -100, 20, -100],
        },
        stagger: 0.4,
      },
      "<",
    );

    return tl;
  }

  const char10 = () =>
    gsap.from(chars.y, {
      rotationY: -180,
      scale: 0,
    });

  function char11() {
    const tl = gsap.timeline({
      defaults,
    });

    tl.set(chars.t2.bolt.wrap, {
      autoAlpha: 1,
    });

    const length = chars.t2.bolt.path.getTotalLength();

    tl.set(chars.t2.bolt.path, {
      strokeDasharray: `${length} ${length}`,
      strokeDashoffset: length,
    });

    tl.to(chars.t2.bolt.path, {
      duration: 1,
      ease: "power3.inOut",
      strokeDashoffset: 0,
    });

    tl.from(
      chars.t2.bolt.rect,
      {
        duration: 3.5,
        ease: "power4.out",
        yPercent: 100,
      },
      "<0.5",
    );

    tl.from(
      chars.t2.bolt.wrap,
      {
        keyframes: {
          duration: 2,
          scale: [1, 1.1, 0.6, 0.7, 0.2, 0.3, 0],
        },
      },
      "-=2",
    );

    tl.from(
      chars.t2.char,
      {
        ease: "back.out(1.4)",
        scale: 0,
      },
      "<0.5",
    );

    return tl;
  }

  const char12 = () =>
    gsap.from(chars.h, {
      yPercent: -100,
      ...defaults,
    });

  const char14 = () =>
    gsap.from(chars.n3, {
      xPercent: -100,
      ...defaults,
    });

  function char13() {
    const tl = gsap.timeline({
      defaults,
    });

    tl.from(
      chars.i2,
      {
        autoAlpha: 0,
        duration: 0.1,
      },
      "<",
    );

    tl.from(
      chars.i2,
      {
        duration: 1.3,
        rotationX: -450,
      },
      "<0.14",
    );

    tl.add(char14(), "<+=0.5");

    tl.to(
      chars.i2,
      {
        duration: 1.5,
        repeat: 1,
        repeatDelay: 3,
        rotationX: 540,
        yoyo: true,
        yoyoEase: "power2.out",
      },
      "+=2",
    );

    return tl;
  }

  function char15() {
    const tl = gsap.timeline({
      defaults,
    });

    tl.from(
      chars.g,
      {
        autoAlpha: 0,
        duration: 2,
        ease: "elastic.out(1, 0.4)",
        rotationZ: -120,
      },
      "<0.6",
    );

    return tl;
  }

  tl.add(char1(), 0);
  tl.add(char2(), 0.4);
  tl.add(char3(), 1);
  tl.add(char5(), 0.8);
  tl.add(char6(), 1.1);
  tl.add(char8to9(), 1.4);
  tl.add(char10(), 1.7);
  tl.add(char11(), 2);
  tl.add(char12(), 1.9);
  tl.add(char13(), 2.4);
  tl.add(char15(), 2.2);
</script>
