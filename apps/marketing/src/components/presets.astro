---
const spikes = [
	34, 7, 6, 8, 14, 8, 7, 9, 22, 8, 7, 9, 14, 8, 7, 9,
	30, 8, 7, 9, 14, 8, 7, 9, 22, 8, 7, 9, 32, 8, 7, 10
];
---

<div
	class="absolute top-4 right-4 p-2 rounded-lg bg-white dark:bg-gray-800 shadow-control"
>
	<div
		class="bg-violet-400 dark:bg-violet-500 text-white pr-3 pl-2.5 text-sm h-8 shrink-0 rounded-sm gap-1.5 inline-flex items-center justify-center"
	>
		<svg
			aria-hidden="true"
			class="size-4"
			fill="currentColor"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<use href="/sprite.svg#download" />
		</svg>
		Export
	</div>
</div>

<div
	class="w-3xs absolute top-20 bottom-4 right-4 bg-white dark:bg-gray-800 rounded-xl shadow-control flex flex-col"
>
	<div class="w-full gap-3 flex p-5 border-b border-gray-200 dark:border-gray-600 flex-col">
		<div class="text-sm font-medium">Background</div>
		
		<div class="grid grid-cols-3 gap-4">
			<div class="ring-2 ring-violet-400 dark:ring-violet-600 relative w-full aspect-square bg-gray-50 dark:bg-gray-700 overflow-hidden">
				<div class="z-10 absolute -bottom-0.5 size-4.5 flex items-center justify-center -right-0.5 text-white bg-violet-400 dark:bg-violet-600">
					<svg aria-hidden="true" class="size-3" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
						<use href="/sprite.svg#check" />
					</svg>
				</div>

				<div class="z-0 absolute inset-0 grid grid-cols-5 auto-rows-min">
					<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
					<div class="w-full aspect-square bg-white dark:bg-gray-800" />
					<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
					<div class="w-full aspect-square bg-white dark:bg-gray-800" />
					<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
			
					<div class="w-full aspect-square bg-white dark:bg-gray-800" />
					<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
					<div class="w-full aspect-square bg-white dark:bg-gray-800" />
					<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
					<div class="w-full aspect-square bg-white dark:bg-gray-800" />
			
					<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
					<div class="w-full aspect-square bg-white dark:bg-gray-800" />
					<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
					<div class="w-full aspect-square bg-white dark:bg-gray-800" />
					<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
			
					<div class="w-full aspect-square bg-white dark:bg-gray-800" />
					<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
					<div class="w-full aspect-square bg-white dark:bg-gray-800" />
					<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
					<div class="w-full aspect-square bg-white dark:bg-gray-800" />

					<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
					<div class="w-full aspect-square bg-white dark:bg-gray-800" />
					<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
					<div class="w-full aspect-square bg-white dark:bg-gray-800" />
					<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
				</div>
			</div>

			<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
			<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
			<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
			<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
			<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
		</div>
	</div>

	<div class="w-full gap-3 flex p-5 border-b border-gray-200 dark:border-gray-600 flex-col">
		<div class="text-sm font-medium">Camera</div>

		<div class="grid grid-cols-3 gap-4">
			<div class=""></div>
		</div>
	</div>

	<div class="w-full gap-3 flex p-5 border-b border-gray-200 dark:border-gray-600 flex-col">
		<div class="text-sm font-medium">Music</div>

		<div class="grid grid-cols-3 gap-2">
			<div class="h-6 w-full border border-gray-150 dark:border-gray-700 rounded-sm" />
			<div class="h-6 w-full border border-gray-150 dark:border-gray-700 rounded-sm" />
			<div class="h-6 w-full border border-gray-150 dark:border-gray-700 rounded-sm" />
		</div>

		<div 
			aria-hidden="true"
		 	class="relative bg-gray-50 border border-gray-150 h-13 dark:bg-gray-700 dark:border-gray-700 rounded-sm px-2 py-2 overflow-hidden"
		>
			<div class="flex h-full w-max items-center animate-waveform">
				<div class="-ml-0.5 flex shrink-0 items-center gap-0.5">
					{
						spikes.map((height) => (
							<div
								class="h-(--bar-height) w-0.5 rounded-full bg-gray-400 dark:bg-gray-500"
								style={`--bar-height:${height}px`}
							/>
						))
					}
				</div>
				
				<div 
					aria-hidden="true" 
					class="-ml-0.5 flex shrink-0 items-center gap-0.5"
				>
					{
						spikes.map((height) => (
							<div
								class="h-(--bar-height) w-0.5 rounded-full bg-gray-400 dark:bg-gray-500"
								style={`--bar-height:${height}px`}
							/>
						))
					}
				</div>
				
				<div
					aria-hidden="true"
					class="-ml-0.5 flex shrink-0 items-center gap-0.5"
				>
					{
						spikes.map((height) => (
							<div
								class="h-(--bar-height) w-0.5 rounded-full bg-gray-400 dark:bg-gray-500"
								style={`--bar-height:${height}px`}
							/>
						))
					}
				</div>
			</div>
		</div>
	</div>
</div>

<div
	class="overflow-hidden rounded-[.875rem] bg-white absolute right-[calc(var(--container-3xs)+4rem)] shadow-control top-1/2 -translate-y-1/2 aspect-4/3 h-[calc(100%-10rem)] dark:bg-gray-800"
>
	<div class="absolute inset-0 grid grid-cols-5 auto-rows-fr">
		<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
		<div class="w-full aspect-square bg-white dark:bg-gray-800" />
		<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
		<div class="w-full aspect-square bg-white dark:bg-gray-800" />
		<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />

		<div class="w-full aspect-square bg-white dark:bg-gray-800" />
		<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
		<div class="w-full aspect-square bg-white dark:bg-gray-800" />
		<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
		<div class="w-full aspect-square bg-white dark:bg-gray-800" />

		<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
		<div class="w-full aspect-square bg-white dark:bg-gray-800" />
		<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
		<div class="w-full aspect-square bg-white dark:bg-gray-800" />
		<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />

		<div class="w-full aspect-square bg-white dark:bg-gray-800" />
		<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
		<div class="w-full aspect-square bg-white dark:bg-gray-800" />
		<div class="w-full aspect-square bg-gray-50 dark:bg-gray-700" />
		<div class="w-full aspect-square bg-white dark:bg-gray-800" />
	</div>
</div>

