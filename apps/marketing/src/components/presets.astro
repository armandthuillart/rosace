  <div class="w-full gap-3 flex pt-4 p-5 flex-col">
    <div class="text-sm font-medium">Music</div>

    <div
      aria-hidden="true"
      class="relative rounded-sm bg-gray-100 h-12 dark:bg-gray-700 px-2 py-2 overflow-hidden before:absolute before:right-auto before:w-6 before:inset-0 before:bg-linear-to-r before:from-gray-50 before:dark:from-gray-700 before:to-transparent before:z-10 after:absolute after:left-auto after:w-6 after:inset-0 after:bg-linear-to-l after:from-gray-50 after:dark:from-gray-700 after:to-transparent after:z-10"
    >
      <div class="flex h-full w-max items-center animate-waveform">
        <div class="-ml-0.5 flex shrink-0 items-center gap-0.5">
          {
            spikes.map((height) => (
              <div
                class="h-(--bar-height) w-0.5 rounded-full bg-gray-400"
                style={`--bar-height:${height}px`}
              />
            ))
