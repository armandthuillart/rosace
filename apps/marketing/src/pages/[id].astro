---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Accordion from "@components/Accordion.astro";
import Anchor from "@components/Anchor.astro";

export async function getStaticPaths() {
  return await getCollection("docs").then((pages) =>
    pages.map((page) => ({
      params: { id: page.id },
      props: { page },
    })),
  );
}

const { page } = Astro.props;
const { Content } = await render(page);

const formatter = new Intl.DateTimeFormat("en-US", {
  day: "numeric",
  year: "numeric",
  month: "long",
});
---

<BaseLayout title={page.data.title}>
  <article class="mx-auto mb-6 w-full max-w-3xl">
    <h1 class="mb-3 text-6xl font-bold sm:text-8xl">
      {page.data.title}
    </h1>

    <div
      class="group mb-12 inline-flex items-center gap-2 text-gray-400 dark:text-gray-500"
    >
      <svg
        class="size-6"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M6.5423 22.3929H17.2097C19.289 22.3929 20.3235 21.3382 20.3235 19.2489V10.1284H13.0513C11.7656 10.1284 11.1528 9.51569 11.1528 8.22994V0.857178H6.5423C4.47311 0.857178 3.42847 1.92191 3.42847 4.0112V19.2489C3.42847 21.3482 4.46306 22.3929 6.5423 22.3929ZM13.0814 8.75224H20.203C20.1428 8.34044 19.8515 7.93865 19.3694 7.44646L13.8347 1.81142C13.3626 1.32927 12.9508 1.03798 12.5289 0.967672V8.20985C12.5289 8.57146 12.7097 8.75224 13.0814 8.75224Z"
        ></path>

        <path
          class="dark:stroke-gray-1000 stroke-white group-hover:translate-y-[-4.45px] group-hover:opacity-0 group-hover:transition group-hover:duration-300"
          d="M15.8572 13.3429C16.1333 13.343 16.3572 13.5668 16.3572 13.8429C16.3572 14.119 16.1333 14.3428 15.8572 14.3429H7.92847C7.65232 14.3429 7.42847 14.119 7.42847 13.8429C7.42847 13.5668 7.65232 13.3429 7.92847 13.3429H15.8572Z"
          stroke-linecap="round"
          stroke-width="1"></path>

        <path
          class="dark:stroke-gray-1000 stroke-white group-hover:translate-y-[-4.45px] group-hover:transition group-hover:duration-300"
          d="M15.8572 17.1571C16.1333 17.1572 16.3572 17.381 16.3572 17.6571C16.3572 17.9332 16.1333 18.157 15.8572 18.1571H7.92847C7.65232 18.1571 7.42847 17.9332 7.42847 17.6571C7.42847 17.381 7.65232 17.1571 7.92847 17.1571H15.8572Z"
          stroke-linecap="round"
          stroke-width="1"></path>

        <path
          class="dark:stroke-gray-1000 stroke-white opacity-0 group-hover:opacity-100 group-hover:transition-all group-hover:delay-75 group-hover:duration-500 group-hover:[stroke-dashoffset:0]"
          d="M15.8572 17.1571C16.1333 17.1572 16.3572 17.381 16.3572 17.6571C16.3572 17.9332 16.1333 18.157 15.8572 18.1571H7.92847C7.65232 18.1571 7.42847 17.9332 7.42847 17.6571C7.42847 17.381 7.65232 17.1571 7.92847 17.1571H15.8572Z"
          stroke-dasharray="10"
          stroke-dashoffset="10"
          stroke-linecap="round"
          stroke-width="1"></path>
      </svg>

      <p class="text-xl">Last updated on {formatter.format(page.data.date)}.</p>
    </div>

    <div
      class="[&_a]:relative [&_a]:font-medium [&_a]:whitespace-nowrap [&_a]:outline-hidden [&_a]:transition [&_a]:duration-200 [&_a]:after:pointer-events-none [&_a]:after:absolute [&_a]:after:right-0 [&_a]:after:bottom-0 [&_a]:after:left-0 [&_a]:after:h-0.5 [&_a]:after:rounded-xs [&_a]:after:bg-blue-400 [&_a]:after:transition [&_a]:after:duration-200 [&_a]:after:content-[''] dark:[&_a]:after:bg-blue-500 [&_a:hover]:text-blue-400 [&_a:hover]:after:translate-y-px dark:[&_a:hover]:text-blue-500 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:font-bold [&_h2:not(:first-of-type)]:mt-8 [&_li]:pl-[.5em] [&_li]:text-xl [&_li]:marker:text-gray-500 dark:[&_li]:marker:text-gray-400 [&_p]:my-3 [&_p]:text-xl [&_table]:mt-4 [&_table]:table-auto [&_table]:border-2 [&_table]:border-gray-200 dark:[&_table]:border-gray-800 [&_td]:px-3 [&_td]:py-2 [&_td]:align-top [&_td]:text-base [&_td]:leading-6 [&_td]:text-gray-700 dark:[&_td]:text-gray-300 [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:align-middle [&_th]:text-base [&_th]:font-semibold [&_th]:whitespace-nowrap [&_th]:text-gray-900 dark:[&_th]:text-gray-100 [&_thead]:border-b [&_thead]:border-gray-300 [&_thead]:bg-gray-100 dark:[&_thead]:border-gray-700 dark:[&_thead]:bg-gray-900 [&_tr]:border-b [&_tr]:border-gray-200 dark:[&_tr]:border-gray-800 [&_tr:last-child]:border-b-0 [&_ul]:my-3 [&_ul]:space-y-1.5 [&_ul]:pl-[2.5ch] [&_ul>li]:list-disc"
    >
      <Content components={{ Accordion, a: Anchor }} />
    </div>
  </article>
</BaseLayout>
