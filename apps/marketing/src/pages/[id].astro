---
import { getCollection, render } from "astro:content";
import BaseLayout from "@components/base-layout.astro";

export async function getStaticPaths() {
  return await getCollection("policies").then((entries) =>
    entries.map((entry) => ({
      params: {
        id: entry.id,
      },
      props: {
        post: entry,
      },
    })),
  );
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Intl.DateTimeFormat("en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(post.data.date);
---

<BaseLayout>
  <article class="py-16">
    <div
      class="mx-auto flex w-full max-w-2xl flex-col gap-10 px-6 sm:gap-16 md:max-w-3xl lg:max-w-7xl lg:px-10"
    >
      <div class="flex flex-col items-center gap-6">
        <h1
          class="max-w-5xl text-5xl -tracking-[.04em] text-balance md:text-[4rem]/none"
        >
          {post.data.title}
        </h1>

        <p class="text-lg/8 text-black/50 dark:text-white/70">
          Last updated on {formattedDate}.
        </p>
      </div>

      <div
        class="[&_]th]:align-bottom mx-auto max-w-2xl text-sm/7 *:not-last:mb-4 [&_a]:font-medium [&_a]:underline [&_a]:underline-offset-4 [&_td]:py-2 [&_td]:pr-3 [&_td]:leading-5 [&_th]:pr-3 [&_th]:pb-2 [&_th]:text-start [&_th]:leading-5 [&_th]:font-medium [&_th]:whitespace-nowrap [&_thead]:border-b [&_thead]:border-[#D9D9D9] dark:[&_thead]:border-[#383838] [&_tr]:border-[#E6E6E6] [&_tr]:not-last:border-b dark:[&_tr]:border-[#2C2C2C] [&>h2]:text-base/8 [&>h2]:font-medium [&>h2]:first:mt-8 [&>ul]:list-[square] [&>ul]:pl-6 [&>ul]:[&>li]:pl-2 [&>ul]:[&>li]:marker:text-black/50 dark:[&>ul]:[&>li]:marker:text-white/70"
      >
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
