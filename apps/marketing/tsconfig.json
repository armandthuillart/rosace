{
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@components/*": ["./src/components/*"],
			"@images/*": ["./src/images/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@public/*": ["./public/*"],
			"@styles/*": ["./src/styles/*"]
		}
	},
	"exclude": ["dist", "node_modules", "public"],
	"extends": "astro/tsconfigs/strict",
	"include": ["**/*", ".astro/types.d.ts"]
}
