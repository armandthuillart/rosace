	"scripts": {
		"build": "moon run :build",
		"build:dashboard": "moon run dashboard:build",
		"build:marketing": "moon run marketing:build",
		"deploy": "bash -lc 'set -a; source .env.production; set +a; moon run :deploy'",
		"deploy:dashboard": "bash -lc 'set -a; source .env.production; set +a; moon run dashboard:deploy'",
		"deploy:marketing": "bash -lc 'set -a; source .env.production; set +a; moon run marketing:deploy'",
		"dev": "moon run -i :dev",
		"dev:dashboard": "moon run -i dashboard:dev",
		"dev:marketing": "moon run -i marketing:dev",
		"env": "bun env.ts",
		"lint": "moon run :lint",
		"lint:dashboard": "moon run dashboard:lint",
		"lint:marketing": "moon run marketing:lint"
	},
	"trustedDependencies": ["@moonrepo/cli"],
	"workspaces": ["apps/*", "packages/*"]
